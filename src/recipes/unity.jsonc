// Tabbit recipe — 유니티 클라이언트
//
// 엑셀 워크북을 읽어 StreamingAssets에 데이터를, Assets/Scripts에 C# 코드를 냅니다.
// 경로만 프로젝트에 맞게 바꾸면 그대로 돕니다.

{
  // 배열 셀의 구분자. 정확히 한 글자.
  // 쉼표가 기본이 아닌 이유는 문장과 숫자 표기에 너무 흔하기 때문입니다.
  "ArrayDelimiter": ";",

  "Sources": {
    "Xlsx": [
      {
        // 워크북이 있는 폴더. CLI를 실행한 위치 기준입니다.
        "Path": "./Sheets"
      }
    ]
  },

  "Targets": [
    {
      "Type": "binary",
      // StreamingAssets는 모든 플랫폼에 배포됩니다.
      // 안드로이드에서는 APK 안에 남고 WebGL에서는 HTTP URL이 되지만,
      // 생성된 C#이 그 둘을 알아서 처리합니다.
      "Path": "./Assets/StreamingAssets/Data",

      // .bytes 인 이유: 유니티는 이 확장자만 TextAsset으로 포함합니다.
      // Resources/ 나 Addressables로 배포한다면 반드시 이 값이어야 합니다.
      // StreamingAssets만 쓴다면 .tcb 그대로도 됩니다.
      "FileExtension": ".bytes",

      // "c" = 클라이언트 빌드. 서버 전용으로 표시된 엔티티와 필드가 빠집니다.
      "TargetSide": "c"
    },
    {
      "Type": "csharp",
      "Path": "./Assets/Scripts/Generated",

      // 비워두면 전역 네임스페이스라 다른 코드와 이름이 부딪힐 수 있습니다.
      "Namespace": "MyGame.Data",

      // 접근자 클래스의 이름. 코드에서 GameData.Item.Find(1) 처럼 씁니다.
      // 정적 클래스라 인스턴스를 만들지 않습니다.
      "AccessorName": "GameData",

      // 위 익스포터의 FileExtension과 반드시 같아야 합니다.
      // 다르면 리더가 파일을 못 찾습니다.
      "BinaryTableFileExtension": ".bytes",

      "TargetSide": "c"
    },

    // 데이터를 눈으로 확인할 문서. 원본 시트의 셀로 가는 링크가 들어 있어
    // 이상한 값을 찾으면 바로 고칠 곳으로 갈 수 있습니다. 빼도 됩니다.
    { "Type": "html", "Path": "./Docs/Data", "TargetSide": "c" }
  ]
}
