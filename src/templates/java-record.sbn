{{~## One table's record. Its own file, because Java demands a public type be alone in one. ##~}}
{{ include 'java-file-head.sbn' ~}}
// Generated from {{ table.location }}
{{~ for line in table.comment ~}}
/** {{ line }} */
{{~ end ~}}
public final class {{ table.record_name }} {
{{~ for field in table.fields ~}}
{{~ for line in field.comment ~}}
    /** {{ line }} */
{{~ end ~}}
{{~ for declaration in field.declarations ~}}
    public {{ declaration }}
{{~ end ~}}
{{~ if field.is_nullable ~}}
    /**
     * Whether this row has a value for {{ field.name }}. The value field keeps its type and
     * holds the type's empty value when the row had none; this says which it was.
     */
    public boolean {{ field.presence_member }};
{{~ end ~}}
{{~ if field.has_optional_elements ~}}
    /**
     * Which of {{ field.name }}'s elements have a value. Empty where the file did not carry
     * the column, and then every index is out of range anyway.
     */
    public boolean[] {{ field.element_presence_member }} = new boolean[0];
{{~ end ~}}
{{~ end ~}}
{{~## A column whose value is a row of one of several tables. One field for the resolved row
   whatever table it came from, and the discriminator saying which - the targets take separate
   id bands, so at most one of them ever answers. spec/multi-target-accessors.md. ##~}}
{{~## The element type of each record group. Nested rather than a file of its own, which is
   what Java would demand of a public top-level type - and nesting scopes the name, so two
   tables each holding a `Slot` group do not collide. ##~}}
{{~ for field in table.fields ~}}
{{~## An array of arrays declares no element type: its outer level has no name, so there is
   nothing for a class to be. spec/nested-multi-level.md. ##~}}
{{~ if field.is_record && !field.members_are_anonymous }}
{{~## One class per level, innermost first - the view flattened the nesting so this loop does
   not have to know how deep it went. spec/nested-multi-level.md. ##~}}
{{~ for rt in field.record_types ~}}
{{~ if rt.is_outermost ~}}
    /** One element of {{ rt.owner }}. */
{{~ else ~}}
    /** A record inside {{ rt.owner }}. */
{{~ end ~}}
    public static final class {{ rt.type_name }} {
{{~ for member in rt.members ~}}
{{~ for line in member.comment ~}}
        /** {{ line }} */
{{~ end ~}}
{{~ for line in member.declarations ~}}
        public {{ line }}
{{~ end ~}}
{{~ end ~}}
{{~ for member in rt.members ~}}
{{~ if member.fill != '' ~}}
{{~## An instance initializer block: Java fills an array of objects with nulls, and a
   member array gets the same empty-not-null guarantee a scalar member gets. ##~}}
        { {{ member.fill }} }
{{~ end ~}}
{{~ end ~}}
{{~## The per-target methods of every member of this class that reaches several tables. One
   taking the element number where the member is the array, which is the third place an element
   number sits. spec/multi-target-accessors.md. ##~}}
    }
{{~ end ~}}
{{~ if field.is_fixed_record_array }}
    /**
     * A {{ field.record_type_name }} array with its elements constructed.
     *
     * Java fills an array of objects with nulls, and the length here is the sheet's column
     * count - known at generation - so the row can arrive with the elements already there
     * and each member column simply assigns into them.
     */
    private static {{ field.record_type_name }}[] new{{ field.record_type_name }}Array(int length) {
        {{ field.record_type_name }}[] array = new {{ field.record_type_name }}[length];

        for (int i = 0; i < length; i++) {
            array[i] = new {{ field.record_type_name }}();
        }

        return array;
    }
{{~ end ~}}
{{~ end ~}}
{{~ end ~}}

{{~ for field in table.fields ~}}
{{~ if field.variants.size > 0 }}

{{~## **The variant, built once on first use.** The entry above is what the read filled - one
   assignment per column - and which variant it is only became knowable when the discriminator
   column arrived. Building it here rather than while reading keeps the read path and the wire
   exactly as they were, and a row nobody looks at costs nothing.
   spec/polymorphism.md section 7.2. ##~}}
{{~ if field.variants_are_array ~}}
{{~## **The array shape.** Each element carries its own discriminator - section 5.3 - so the
   shapes inside one row may differ, and what a consumer reads is a list of the abstract type.
   The body that fills one variant is below and is the same either way. ##~}}
    private java.util.List<{{ field.abstract_type_name }}> {{ field.name }}Value;

    /**
     * What this row's {{ field.abstract_type_name }}s are, one per element. Narrow each with
     * {@code instanceof}.
     */
    public java.util.List<{{ field.abstract_type_name }}> {{ field.name }}() {
        if ({{ field.name }}Value != null) {
            return {{ field.name }}Value;
        }

        java.util.List<{{ field.abstract_type_name }}> all =
            new java.util.ArrayList<>({{ field.name }}.length);

        for ({{ field.record_type_name }} element : {{ field.name }}) {
            all.add({{ field.name }}Element(element));
        }

        {{ field.name }}Value = all;
        return all;
    }
{{~ else ~}}
    private {{ field.abstract_type_name }} {{ field.name }}Value;

    /**
     * What this row's {{ field.abstract_type_name }} is. Narrow it with {@code instanceof}.
     */
    public {{ field.abstract_type_name }} {{ field.name }}() {
        if ({{ field.name }}Value == null) {
            {{ field.name }}Value = {{ field.name }}Element({{ field.name }});
        }

        return {{ field.name }}Value;
    }
{{~ end ~}}

    /** Builds one value from the entry the read filled. */
    private static {{ field.abstract_type_name }} {{ field.name }}Element(
            {{ field.record_type_name }} entry) {
        switch (entry.type) {
{{~ for variant in field.variants ~}}
            case {{ variant.discriminator }}: {
                {{ field.abstract_type_name }}.{{ variant.type_name }} built =
                    new {{ field.abstract_type_name }}.{{ variant.type_name }}();
{{~ for member in field.base_members ~}}
{{~ if member.row_name != '' ~}}
{{~## A reference member is two of these: the key the cell held under its own name, and the row
   it resolved to under the derived one. spec/reference-surface-naming.md 4 and 5. ##~}}
                built.{{ member.name }} = {{ field.entry_access }}.{{ member.name }};
                built.{{ member.row_name }} = {{ field.entry_access }}.{{ member.row_name }};
{{~ else ~}}
                built.{{ member.name }} = {{ field.entry_access }}.{{ member.name }};
{{~ end ~}}
{{~ end ~}}
{{~ for member in variant.members ~}}
{{~ if member.row_name != '' ~}}
{{~## A reference member is two of these: the key the cell held under its own name, and the row
   it resolved to under the derived one. spec/reference-surface-naming.md 4 and 5. ##~}}
                built.{{ member.name }} = {{ field.entry_access }}.{{ member.name }};
                built.{{ member.row_name }} = {{ field.entry_access }}.{{ member.row_name }};
{{~ else ~}}
                built.{{ member.name }} = {{ field.entry_access }}.{{ member.name }};
{{~ end ~}}
{{~ end ~}}
                return built;
            }
{{~ end ~}}
        }

{{~## An unknown number is a variant this build does not have. Unlike a column added later,
   which the reader skips, that makes the whole row uninterpretable. ##~}}
        throw new IllegalStateException(
            "{{ field.abstract_type_name }}: no variant is numbered " + entry.type);
    }
{{~ end ~}}
{{~ end ~}}
}
