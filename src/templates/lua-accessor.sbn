{{~## The accessor, holding no table's own code. The module carries the project-wide
   configuration - the keys, set once at start-up - and `new` makes an instance holding
   one table object per sheet. ##~}}
{{ include 'lua-file-head.sbn' }}
-- Every table, loaded together so cross-table references can be resolved.
---@class {{ accessor.name }}
local {{ accessor.name }} = {}

-- The key the table files were sealed with, or nil when they were not sealed. On the
-- module rather than an argument to every read, because it is one decision the consuming
-- project makes once, at start-up, before the first table is read. Thirty-two bytes, the
-- key the converter was given. Where the key comes from is the one thing worth being
-- careful with: it is a secret only until it reaches a repository, so it is read at
-- start-up from wherever this project keeps secrets, not written into a source file.
{{ accessor.name }}.encryptionKey = nil

-- The key the table files were signed with, or nil when they were not signed. A
-- different key from encryptionKey and independent of it. Setting it makes the reader
-- stricter in a second way: a file that carries no MAC is refused, because otherwise the
-- check could be removed by zeroing sixteen bytes - so the order to turn this on in is
-- data first, key second. spec/wire/tcb-mac-and-signature.md.
{{ accessor.name }}.macKey = nil

-- Whether to check the MAC at all. For tools and for measuring what the check costs; it
-- is not a security boundary.
{{ accessor.name }}.verifyMac = true

local instanceMeta = tcb.strictInstance("a `{{ accessor.name }}` accessor", {{ accessor.name }}, { {{ accessor.field_names }} })

function {{ accessor.name }}.new()
  return setmetatable({
{{~ for slot in accessor.tables ~}}
    {{ slot.key }} = {{ slot.table_name }}.new(),
{{~ end ~}}
  }, instanceMeta)
end

-- The bytes of one table's file. `source` is a directory, or a function taking the file
-- name and returning its bytes - which is the shape for an engine whose data lives in
-- its own archive, or a sandbox without io.
local function bytesOf(source, name, extension)
  if type(source) == "function" then
    return source(name .. extension)
  end

  return tcb.readAllBytes(source .. "/" .. name .. extension)
end

-- Reads every table from `source`, then links the references between them.
--
-- `fileExtension` defaults to what the recipe told the exporter to write. Safe to call
-- on a loaded accessor: every file is read into a table of its own and the references
-- are linked among those, so a failure part way through leaves every table holding the
-- load it already had, and no row points at a row from it.
function {{ accessor.name }}:readAll(source, fileExtension)
  fileExtension = fileExtension or "{{ accessor.file_extension }}"
{{~ if (accessor.tables | array.size) == 0 ~}}
  return
{{~ end ~}}
{{~ for slot in accessor.tables }}
  local {{ slot.loaded }} = {{ slot.table_name }}.new()
  {{ slot.loaded }}:readBytes(bytesOf(source, "{{ slot.data_file_name }}", fileExtension))
{{~ end ~}}
{{~ for reference in accessor.cross_references }}
  -- Turns {{ reference.loaded }}'s stored keys into rows, now that every table is in
  -- memory.
  for _, record in ipairs({{ reference.loaded }}.records) do
{{~ for field in reference.fields ~}}
{{~ if field.is_array ~}}
    for position = 1, #{{ field.key_access }} do
      local target = {{ field.ref_table }}:{{ field.ref_lookup }}({{ field.key_access }}[position])

      if target ~= nil then
        {{ field.access }}[position] = {{ field.value }}
      end
    end
{{~ else ~}}
    do
      local target = {{ field.ref_table }}:{{ field.ref_lookup }}({{ field.key_access }})

      if target ~= nil then
        {{ field.access }} = {{ field.value }}
      end
    end
{{~ end ~}}
{{~ end ~}}
{{~## A reference that is a member of a record resolves inside the element, so the list
   is walked and each element's own key is looked up. Which list that is - the group's or
   the member's - the view decided, and a record of one has neither.
   spec/references/references-in-records.md. ##~}}
{{~ for member in reference.record_fields ~}}
{{~ if member.range != '' ~}}
    for i = 1, #{{ member.range }} do
      local target = {{ member.ref_table }}:{{ member.ref_lookup }}({{ member.key }})

      if target ~= nil then
        {{ member.access }} = target
      end
    end
{{~ else ~}}
    do
      local target = {{ member.ref_table }}:{{ member.ref_lookup }}({{ member.key }})

      if target ~= nil then
        {{ member.access }} = target
      end
    end
{{~ end ~}}
{{~ end ~}}
{{~## A column reaching several tables that is a member of a record resolves inside the element,
   so the elements are walked and each one's own key is looked up. Which list that is - the
   group's or the member's - the view decided, and a record of one has neither.
   spec/references/multi-target-accessors.md ~ spec/references/references-in-records.md. ##~}}
{{~## A column reaching several tables is looked up in each of them in the order they were
   named, stopping at the first that has the key. The tables take separate id bands - an id in
   two of them is refused at conversion - so the order only decides which lookup runs.
   spec/references/multi-target-accessors.md. ##~}}
  end
{{~ end }}
{{~ for grid in accessor.grids ~}}
  {{ grid.values }}:linkColumnAxis({{ grid.columns }})
{{~ end ~}}
  -- Published, now that every table read and linked.
{{~ for slot in accessor.tables ~}}
  self{{ slot.access }} = {{ slot.loaded }}
{{~ end ~}}
end

return setmetatable({{ accessor.name }}, tcb.strictType(
  "the `{{ accessor.name }}` accessor module", { "encryptionKey", "macKey", "verifyMac" }))
