{{~##
   One table: its record class and its table class. `table` is the single table this file
   is for, so nothing here loops over the model.
##~}}
{{ include 'kotlin-file-head.sbn' ~}}

// Generated from {{ table.location }}
{{~ for line in table.comment ~}}
/** {{ line }} */
{{~ end ~}}
class {{ table.record_name }} {
{{~ for field in table.fields ~}}
{{~ for line in field.comment ~}}
    /** {{ line }} */
{{~ end ~}}
{{~ for declaration in field.declarations ~}}
    {{ declaration }}
{{~ end ~}}
{{~ if field.is_nullable ~}}
    /**
     * Whether this row has a value for {{ field.name }}. The value property keeps its type
     * and holds the type's empty value when the row had none; this says which it was.
     */
    var {{ field.presence_member }}: Boolean = false
{{~ end ~}}
{{~ if field.has_optional_elements ~}}
    /**
     * Which of {{ field.name }}'s elements have a value. Empty where the file did not carry
     * the column, and then every index is out of range anyway.
     */
    var {{ field.element_presence_member }}: MutableList<Boolean> = mutableListOf()
{{~ end ~}}
{{~ end ~}}
{{~## A column whose value is a row of one of several tables. One property for the resolved row
   whatever table it came from, and the discriminator saying which - the targets take separate
   id bands, so at most one of them ever answers. spec/multi-target-accessors.md. ##~}}
{{~ for ref in table.multi_references ~}}
    /**
     * The row {{ ref.key_member }} names, as whichever of its target tables holds it. Read it
     * through the properties below rather than directly: they check the discriminator first.
     */
    var {{ ref.slot_member }}: Any? = null

    /** Which table {{ ref.key_member }} is a row of. */
    var {{ ref.target_member }}: {{ ref.target_type_name }} = {{ ref.target_type_name }}.{{ ref.none_label }}
{{~ end ~}}
{{~ for ref in table.multi_references ~}}
{{~ for target in ref.targets }}
    /**
     * The {{ target.record_name }} row {{ ref.key_member }} names, or null when it names a row of
     * one of the others.
     */
    val {{ target.method }}: {{ target.record_name }}?
        get() = if ({{ ref.target_member }} == {{ ref.target_type_name }}.{{ target.label }})
            {{ ref.slot_member }} as {{ target.record_name }}
        else
            null
{{~ end ~}}
{{~ end ~}}
{{~## The element type of each record group. Nested rather than a second top-level class,
   which Kotlin would allow in this file - nesting scopes the name, so two tables each
   holding a `Slot` group do not collide in the package they share. ##~}}
{{~ for field in table.fields ~}}
{{~## An array of arrays declares no element type: its outer level has no name, so there is
   nothing for a class to be. spec/nested-multi-level.md. ##~}}
{{~ if field.is_record && !field.members_are_anonymous }}
{{~## One class per level, innermost first - the view flattened the nesting so this loop does
   not have to know how deep it went. spec/nested-multi-level.md. ##~}}
{{~ for rt in field.record_types ~}}
{{~ if rt.is_outermost ~}}
    /** One element of {{ rt.owner }}. */
{{~ else ~}}
    /** A record inside {{ rt.owner }}. */
{{~ end ~}}
    class {{ rt.type_name }} {
{{~ for member in rt.members ~}}
{{~ for line in member.comment ~}}
        /** {{ line }} */
{{~ end ~}}
{{~ for line in member.declarations ~}}
        {{ line }}
{{~ end ~}}
{{~ end ~}}
{{~## The per-target accessors of every member of this class that reaches several tables. A
   property where the member is one value; a function taking the element number where the member
   is the array, which is the third place an element number sits.
   spec/multi-target-accessors.md. ##~}}
{{~ for multi in rt.multi_members ~}}
{{~ for target in multi.targets }}
{{~ if multi.is_array ~}}
        /**
         * The {{ target.record_name }} row element [at] of {{ multi.key_member }} names, or null
         * when that element names a row of one of the others.
         */
        fun {{ target.method }}(at: Int): {{ target.record_name }}? =
            if ({{ multi.target_member }}[at] == {{ multi.target_type_name }}.{{ target.label }})
                {{ multi.slot_member }}[at] as {{ target.record_name }}
            else
                null
{{~ else ~}}
        /**
         * The {{ target.record_name }} row {{ multi.key_member }} names, or null when it names a
         * row of one of the others.
         */
        val {{ target.method }}: {{ target.record_name }}?
            get() = if ({{ multi.target_member }} == {{ multi.target_type_name }}.{{ target.label }})
                {{ multi.slot_member }} as {{ target.record_name }}
            else
                null
{{~ end ~}}
{{~ end ~}}
{{~ end ~}}
    }
{{~ end ~}}
{{~ end ~}}
{{~ end ~}}

}

/** Every row of {{ table.raw_name }}. */
class {{ table.table_name }} {

    /**
     * Every row, in the order the sheet declared them.
     *
     * The list a read published, not one a read fills. A refresh replaces the reference
     * rather than the contents, so whoever holds this holds one whole load.
     */
    var records: MutableList<{{ table.record_name }}> = ArrayList()
        private set

{{~ for index in table.indexes ~}}
    private var {{ index.map_name }}: HashMap<{{ index.key_type }}, {{ table.record_name }}> = HashMap()
{{~ end ~}}
{{~ for index in table.indexes }}
{{~## A key of several columns is held as the text they make. Each part carries its own
   length, so no two combinations can make the same text - joined by a separator alone,
   ("a b", "c") and ("a", "b c") would be one key and one of the two rows would be lost.
   spec/primary-layout.md section 3.5. ##~}}
{{~ if index.is_composite ~}}
    /** Joins the columns of the {{ index.field_name }} key into the text the map is keyed by. */
    private fun keyOf{{ index.suffix }}({{ index.params }}): String {
        val parts = arrayOf(
{{~ for c in index.components ~}}
{{~ if c.kind == "string" ~}}
            {{ c.param }},
{{~ else if c.kind == "enum" ~}}
            {{ c.param }}.value.toString(),
{{~ else ~}}
            {{ c.param }}.toString(),
{{~ end ~}}
{{~ end ~}}
        )

        val text = StringBuilder()

        for (part in parts) {
            text.append(part.length).append(':').append(part)
        }

        return text.toString()
    }

{{~ end ~}}
    /**
     * The row with this {{ index.field_name }}, or null when the table has none.
     *
     * The lookup to reach for when a missing row is an ordinary answer - an optional
     * reference, a key that came from user input.
     */
    fun findBy{{ index.suffix }}({{ index.params }}): {{ table.record_name }}? = {{ index.map_name }}[{{ index.argument }}]

    /**
     * The row with this {{ index.field_name }}, or a thrown exception naming what was missing.
     *
     * For a key that has to be there - one from another table, or a constant. The name says
     * it throws, because a caller reading getBy{{ index.suffix }}(key).name at a glance
     * cannot otherwise tell whether the next line is a null check or a catch.
     */
    fun getBy{{ index.suffix }}OrThrow({{ index.params }}): {{ table.record_name }} =
        {{ index.map_name }}[{{ index.argument }}] ?: throw RecordNotFoundException(
            "there is no record in table `{{ table.raw_name }}` that corresponds to " +
                "field `{{ index.field_name }}` value {{ index.value_format }}")

    /** Whether the table holds a row with this {{ index.field_name }}. */
    fun contains{{ index.suffix }}({{ index.params }}): Boolean = {{ index.map_name }}.containsKey({{ index.argument }})
{{~ end ~}}

    /** Loads the table from a .tcb file written by Tabbit. */
    /**
     * Column by column, matched by tag rather than position: a column this build does not
     * know is skipped by its block length, and one whose type changed incompatibly fails
     * naming the field.
     */
    fun read(filename: String) {
        // Opened unconditionally, and with whatever {{ accessor_name }}.encryptionKey and
        // {{ accessor_name }}.macKey hold - which is null unless the project set them. A
        // file that is neither encrypted nor signed comes back from this untouched, so the
        // load path is the same either way and there is no condition here that could be the
        // wrong way round. spec/tcb-mac-and-signature.md.
        val reader = TcbReader(open(
            readAllBytes(filename), {{ accessor_name }}.encryptionKey,
            {{ accessor_name }}.macKey, {{ accessor_name }}.verifyMac))
        val header = readTableHeader(reader)
        val count = header.rowCount

        // Read into storage of its own and published at the end: reading a table that is already loaded is a refresh, and one that turns out to be unreadable has to leave the rows already there alone.
        val loaded = ArrayList<{{ table.record_name }}>(count)
{{~ for index in table.indexes ~}}
        val loadedBy{{ index.suffix }} = HashMap<{{ index.key_type }}, {{ table.record_name }}>(count * 2)
{{~ end ~}}

        repeat(count) { loaded.add({{ table.record_name }}()) }

        for (column in header.columns) {
            val blockEnd = reader.position + column.byteLength

            when (column.tag) {
{{~ for column_view in table.columns ~}}
                {{ column_view.tag }} -> {
                    {{ column_view.column_check }}
{{~ if column_view.is_nullable ~}}
                    // The bitmap is at the front of the block, so it is read before the
                    // values. The values are written for every row either way, which is what
                    // lets the read shapes below stay as they are.
                    val presence = readPresence(reader, column, count)
{{~ end ~}}
{{~ if column_view.has_optional_elements ~}}
                    // Behind the row bitmap and in front of the values, walked with a counter
                    // that steps once per element of every row.
                    // spec/nullable-array-elements.md.
                    val elementPresence = readElementPresence(reader, column)
                    var elementAt = 0
{{~ end ~}}
{{~## Constructed after the check and before the rows: a dictionary encoding decodes
      its dictionary here, at the head of the block. Opened ahead of every read shape,
      because an array's elements read through it as well - its block states an encoding
      for them and one for the row lengths, and the cursor is what decodes both. After the
      presence bitmap, which sits in front of the block the cursor is about to start
      reading. Each `when` branch is a scope of its own, so the `val` cannot collide with
      another column's. ##~}}
{{~ if column_view.cursor_open != '' ~}}
                    {{ column_view.cursor_open }}
{{~ end ~}}
{{~ if column_view.run_call != '' ~}}
{{~## A run of equal values costs one call and then plain assignments, rather than one
      call per row that each re-dispatch on the encoding. An encoding with no run to
      give answers 1, so this loop is correct over all of them. ##~}}
                    var at = 0
                    while (at < count) {
                        var n = cursor.{{ column_view.run_call }}(count - at)
                        while (n > 0) {
                            val i = at
                            {{ column_view.run_spend }}
                            at++
                            n--
                        }
                    }
{{~ else ~}}
                    for (record in loaded) {
{{~ if column_view.kind == 'var_array' ~}}
                        val elementCount = {{ column_view.length_read }}
                        record.{{ column_view.name }} = ArrayList(elementCount.coerceAtLeast(0))
{{~ if column_view.has_optional_elements ~}}
                        record.{{ column_view.element_presence_member }} =
                            ArrayList(elementCount.coerceAtLeast(0))
                        repeat(elementCount) {
                            record.{{ column_view.name }}.add({{ column_view.read_element }})
                            record.{{ column_view.element_presence_member }}
                                .add(isPresent(elementPresence, elementAt))
                            elementAt++
                        }
{{~ else ~}}
                        repeat(elementCount) { record.{{ column_view.name }}.add({{ column_view.read_element }}) }
{{~ end ~}}
{{~ else if column_view.kind == 'record_var' ~}}
                        val elementCount = {{ column_view.length_read }}
{{~ if column_view.is_first_member ~}}
                        // The first member allocates; the rest check. Allocating again would
                        // discard what the members before it wrote, and taking the shorter of
                        // two counts would shift every value after it.
                        record.{{ column_view.name }} =
                            MutableList(elementCount.coerceAtLeast(0)) { {{ column_view.record_type_name }}() }
{{~ else ~}}
                        if (record.{{ column_view.name }}.size != elementCount) {
                            throw TcbException(
                                "{{ table.raw_name }}.{{ column_view.name }}: the file gives one member of " +
                                    "this record a different element count than another")
                        }
{{~ end ~}}
                        for (element in 0 until elementCount) {
                            record.{{ column_view.name }}[element]{{ column_view.member_access }}{{ column_view.member_ref_suffix }} = {{ column_view.read_element }}
                        }
{{~ else if column_view.kind == 'array_of_arrays_member' ~}}
{{~## One inner list. Which outer element it is, is which column this is - so that index is
   fixed and the loop runs the inner length. spec/nested-multi-level.md. ##~}}
                        val elementCount = {{ column_view.length_read }}
                        record.{{ column_view.name }}[{{ column_view.member_at }}] =
                            ArrayList(elementCount.coerceAtLeast(0))
                        for (element in 0 until elementCount) {
                            record.{{ column_view.name }}[{{ column_view.member_at }}][element] = {{ column_view.read_element }}
                        }
{{~ else if column_view.kind == 'record_member_var' ~}}
{{~## The member is the array: the index goes after its name rather than before. Same
   columns and same loop as the case below - see spec/nested-multi-level.md. ##~}}
                        val elementCount = {{ column_view.length_read }}
                        record.{{ column_view.name }}{{ column_view.member_access }}{{ column_view.member_ref_suffix }} =
                            ArrayList(elementCount.coerceAtLeast(0))
                        for (element in 0 until elementCount) {
                            record.{{ column_view.name }}{{ column_view.member_access }}{{ column_view.member_ref_suffix }}[element] = {{ column_view.read_element }}
                        }
{{~ else if column_view.kind == 'var_array_ref' ~}}
{{~## A trimmed array of references. The keys go in the list beside the values, at this row's
   length - which is what `serial_ref` below does from the column count.
   spec/variable-length-record-arrays.md. ##~}}
                        val elementCount = {{ column_view.length_read }}
                        record.{{ column_view.name }}Index = ArrayList(elementCount.coerceAtLeast(0))
{{~ if column_view.has_optional_elements ~}}
                        record.{{ column_view.element_presence_member }} =
                            ArrayList(elementCount.coerceAtLeast(0))
                        repeat(elementCount) {
                            record.{{ column_view.name }}Index.add({{ column_view.read_element }})
                            record.{{ column_view.element_presence_member }}
                                .add(isPresent(elementPresence, elementAt))
                            elementAt++
                        }
{{~ else ~}}
                        repeat(elementCount) { record.{{ column_view.name }}Index.add({{ column_view.read_element }}) }
{{~ end ~}}
{{~ else if column_view.kind == 'scalar_ref' ~}}
                        record.{{ column_view.name }}Index = {{ column_view.read_scalar }}
{{~ else ~}}
                        record.{{ column_view.name }}{{ column_view.member_access }}{{ column_view.member_ref_suffix }} = {{ column_view.read_scalar }}
{{~ end ~}}
                    }
{{~ end ~}}
{{~ if column_view.is_nullable }}
                    // A pass of its own rather than a line inside each read shape, so the row
                    // index is worked out once. The block carries a value for every row, so
                    // an absent one has just been given whatever was there; putting the empty
                    // value back is what makes this path agree with the JSON one.
                    for (row in 0 until count) {
                        val record = loaded[row]
                        record.{{ column_view.presence_member }} = isPresent(presence, row)

                        if (!record.{{ column_view.presence_member }}) {
                            record.{{ column_view.name }} = {{ column_view.empty_value }}
                        }
                    }
{{~ end ~}}
                }
{{~ end ~}}
                else ->
                    // A column added after this code was generated.
                    reader.skip(column.byteLength)
            }

            checkBlockEnd(reader, column, blockEnd)
        }

        for (record in loaded) {
{{~ for index in table.indexes ~}}
{{~ if index.is_composite ~}}
            loadedBy{{ index.suffix }}[keyOf{{ index.suffix }}({{ for c in index.components }}record.{{ c.member }}{{ if !for.last }}, {{ end }}{{ end }})] = record
{{~ else ~}}
            loadedBy{{ index.suffix }}[record.{{ index.member }}] = record
{{~ end ~}}
{{~ end ~}}
        }

        // Published, now that every column read.
        records = loaded
{{~ for index in table.indexes ~}}
        {{ index.map_name }} = loadedBy{{ index.suffix }}
{{~ end ~}}
    }
}
