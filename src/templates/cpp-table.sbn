// Generated from {{ table.location }}
{{~## The element type of each record group, ahead of the record that holds one. A plain
   struct, so a vector of them needs no per-element allocation and `v[j].member = x` is a
   legal assignment - which is exactly what a member column's read does.
   See spec/nested-fields.md. ##~}}
{{~ for field in table.fields ~}}
{{~## An array of arrays declares no element type: its outer level has no name, so there is
   nothing for a struct to be. spec/nested-multi-level.md. ##~}}
{{~ if field.is_record && !field.members_are_anonymous ~}}
{{~## One struct per level, innermost first - which C++ requires rather than prefers: a struct
   has to be complete before another declares a member of it. The view flattened the nesting so
   this loop does not have to know how deep it went. spec/nested-multi-level.md. ##~}}
{{~ for rt in field.record_types ~}}
{{~ if rt.is_outermost ~}}
/// One element of {{ rt.owner }}.
{{~ else ~}}
/// A record inside {{ rt.owner }}.
{{~ end ~}}
struct {{ rt.type_name }} {
{{~ for member in rt.members ~}}
{{~ for line in member.comment ~}}
  /// {{ line }}
{{~ end ~}}
{{~ for line in member.declarations ~}}
  {{ line }}
{{~ end ~}}
{{~ end ~}}
{{~## The per-target accessors of every member of this struct that reaches several tables. One
   taking the element number where the member is the array, which is the third place an element
   number sits. spec/multi-target-accessors.md. ##~}}
};

{{~ end ~}}
{{~ end ~}}
{{~ end ~}}
{{~ for line in table.comment ~}}
/// {{ line }}
{{~ end ~}}
struct {{ table.record_name }} {
{{~ for field in table.fields ~}}
{{~ for line in field.comment ~}}
  /// {{ line }}
{{~ end ~}}
{{~ for declaration in field.declarations ~}}
  {{ declaration }}
{{~ end ~}}
{{~ if field.is_nullable ~}}
{{~## The value member keeps its type and holds the type's empty value when the row had
   none; this says which it was. Not std::optional, so that every language have one
   shape and C++ does not split from Unreal - see spec/optional-fields.md. ##~}}
  /// Whether this row has a value for `{{ field.name }}`.
  bool {{ field.presence_member }} = false;
{{~ end ~}}
{{~ if field.has_optional_elements ~}}
{{~## The same answer one level in. Empty where the file did not carry the column, and then
   every index is out of range anyway. ##~}}
  std::vector<bool> {{ field.element_presence_member }};

  /// Whether element `index` of `{{ field.name }}` has a value.
  bool has_{{ field.name }}_at(std::size_t index) const {
    return index >= {{ field.element_presence_member }}.size()
        || {{ field.element_presence_member }}[index];
  }
{{~ end ~}}
{{~ end ~}}
{{~## A column whose value is a row of one of several tables. One member for the resolved row
   whatever table it came from, and the discriminator saying which - the targets take separate
   id bands, so at most one of them ever answers.

   `const void*` because the targets share no base. The cast is safe by construction: the
   discriminator was set by the same assignment that filled the slot, and casting from `void*`
   asks nothing of the target type - the forward header this file already includes is enough.
   spec/multi-target-accessors.md. ##~}}
{{~ for field in table.fields ~}}
{{~ if field.variants.size > 0 }}

{{~## **The value, built on call from the flat entry.** Which variant a row is only became
   knowable when the discriminator column arrived, so the entry is read as it always was and the
   value is built from it here - which is why the read path and the wire are untouched.

   A `unique_ptr` because the base is what a caller holds and the variant is what was made; the
   virtual destructor on the base is what makes that safe. spec/polymorphism.md section 7.2. ##~}}
  /// What this row's {{ field.abstract_type_name }} is. Narrow it with `dynamic_cast`.
{{~ if field.variants_are_array ~}}
{{~## **The array shape.** Each element carries its own discriminator - section 5.3 - so the
   shapes inside one row may differ, and what a consumer reads is a sequence of the abstract
   type. The function that builds one is the same either way. ##~}}
  std::vector<std::unique_ptr<{{ field.abstract_type_name }}>> {{ field.name }}_of() const {
    std::vector<std::unique_ptr<{{ field.abstract_type_name }}>> all;
    all.reserve({{ field.name }}.size());

    for (const auto& element : {{ field.name }}) {
      all.push_back({{ field.name }}_element(element));
    }

    return all;
  }
{{~ else ~}}
  std::unique_ptr<{{ field.abstract_type_name }}> {{ field.name }}_of() const {
    return {{ field.name }}_element({{ field.name }});
  }
{{~ end ~}}

  /// Builds one value from the entry the read filled.
  static std::unique_ptr<{{ field.abstract_type_name }}> {{ field.name }}_element(
      const {{ field.record_type_name }}& entry) {
    switch (entry.{{ field.discriminator_name }}) {
{{~ for variant in field.variants ~}}
      case {{ variant.discriminator }}: {
        auto built = std::make_unique<{{ variant.type_name }}>();
{{~ for member in field.base_members ~}}
{{~ if member.row_name != '' ~}}
{{~## A reference member is two of these: the key the cell held under its own name, and the row
   it resolved to under the derived one. spec/reference-surface-naming.md 4 and 5. ##~}}
        built->{{ member.name }} = entry.{{ member.name }};
        built->{{ member.row_name }} = entry.{{ member.row_name }};
{{~ else ~}}
        built->{{ member.name }} = entry.{{ member.name }};
{{~ end ~}}
{{~ end ~}}
{{~ for member in variant.members ~}}
{{~ if member.row_name != '' ~}}
{{~## A reference member is two of these: the key the cell held under its own name, and the row
   it resolved to under the derived one. spec/reference-surface-naming.md 4 and 5. ##~}}
        built->{{ member.name }} = entry.{{ member.name }};
        built->{{ member.row_name }} = entry.{{ member.row_name }};
{{~ else ~}}
        built->{{ member.name }} = entry.{{ member.name }};
{{~ end ~}}
{{~ end ~}}
        return built;
      }
{{~ end ~}}
    }

{{~## An unknown number is a variant this build does not have. Unlike a column added later,
   which the reader skips, that makes the whole row uninterpretable. ##~}}
    throw std::runtime_error(
        "{{ field.abstract_type_name }}: no variant is numbered "
        + std::to_string(entry.{{ field.discriminator_name }}));
  }
{{~ end ~}}
{{~ end ~}}
};

{{~ for line in table.comment ~}}
