{{~ end ~}}
{{~ if field.is_nullable ~}}
{{~## The value member keeps its type and holds the type's empty value when the row had
   none; this says which it was. Not std::optional, so that all thirteen languages have one
   shape and C++ does not split from Unreal - see spec/optional-fields.md. ##~}}
  /// Whether this row has a value for `{{ field.name }}`.
  bool {{ field.presence_member }} = false;
{{~ end ~}}
{{~ end ~}}
};

{{~ for line in table.comment ~}}
