{{~##
   The accessor: one property per table, the load, and the reference linking. Holds no
   table's own code, so a deleted table is a deleted file rather than a hunk to notice.
##~}}
{{ include 'kotlin-file-head.sbn' ~}}
/** Every table, loaded together so cross-table references can be resolved. */
object {{ accessor_name }} {
{{~ for slot in accessor.tables ~}}
    var {{ slot.name }}: {{ slot.table_name }} = {{ slot.table_name }}()
        private set
{{~ end ~}}

    /**
     * The key the table files were sealed with, or null when they were not sealed.
     *
     * Beside [readAll] because it is the same kind of thing: one decision the consuming
     * project makes once, at start-up, before the first table is read. A key threaded
     * through every read signature would be the same value written out at every call site,
     * and every call site is somewhere it could be wrong.
     *
     * Thirty-two bytes, the key the converter was given. Null - the default - is a project
     * that does not encrypt, and it costs that project nothing: the load path opens the
     * envelope either way, and a file that is not encrypted comes back from that unchanged.
     * A project that does encrypt and leaves this null gets the reader's own message saying
     * the file is encrypted and no key was given, rather than a failure somewhere inside the
     * format.
     *
     * Where the key comes from is the one thing about this layer worth being careful with.
     * It is a secret only until it reaches a repository, a build log or an issue, and it
     * cannot be taken back afterwards - so it is read at start-up from wherever this project
     * keeps secrets, not written into a source file and not left in a resource the package
     * carries. What the layer is for, and therefore what is and is not worth defending, is
     * spec/tcb-v104-composed-encodings.md section 4.
     */
    var encryptionKey: ByteArray? = null

    /**
     * The key the table files were signed with, or null when they were not signed.
     *
     * A different key from [encryptionKey] and independent of it: a file can be signed
     * without being encrypted, and encrypted without being signed.
     *
     * What it buys is the thing encryption does not. The cipher is a keystream XOR, so a bit
     * flipped in the file is a bit flipped in the value it decrypts to - no key needed - and
     * every structural check the format makes still passes, because a four-byte float
     * accepts any four bytes. With this set, a file altered after export stops loading.
     *
     * Setting it makes the reader stricter in a second way: a file that carries no MAC is
     * refused, because otherwise the check could be removed by zeroing sixteen bytes. So the
     * order to turn this on in is data first, key second. spec/tcb-mac-and-signature.md.
     */
    var macKey: ByteArray? = null

    /**
     * Whether to check the MAC at all. True by default.
     *
     * For tools that read exported files without the key, and for measuring what the check
     * costs at load. It is not a security boundary - anyone who can flip a flag in a shipped
     * package can read [macKey] out of the same package.
     */
    var verifyMac = true

    /**
     * Reads every table from basePath, then links the references between them.
     *
     * Safe to call on a loaded accessor. Every file is read into a set of its own and the references are linked among those, so nothing here is visible until all of it is: a failure part way through leaves the tables holding the load they already had, and no row ever points at a row from it.
     */
    fun readAll(basePath: String, fileExtension: String = "{{ accessor.file_extension }}") {
{{~ if accessor.tables | array.size == 0 ~}}
        // No tables to read.
{{~ else ~}}
{{~ for slot in accessor.tables ~}}
        val loaded{{ slot.table_name }} = {{ slot.table_name }}()
        loaded{{ slot.table_name }}.read(File(basePath, "{{ slot.data_file_name }}$fileExtension").path)
{{~ end ~}}

        solveCrossReferences({{ for slot in accessor.tables }}{{ if !for.first }}, {{ end }}loaded{{ slot.table_name }}{{ end }})

{{~ for slot in accessor.tables ~}}
        {{ slot.name }} = loaded{{ slot.table_name }}
{{~ end ~}}
{{~ end ~}}
    }

    /**
     * Turns the stored indices into usable values, once every table is in memory.
     *
     * The tables arrive as arguments and shadow the properties of the same name, which is
     * how this resolves the load being read rather than the one already published.
     */
    private fun solveCrossReferences({{ for slot in accessor.tables }}{{ if !for.first }}, {{ end }}{{ slot.name }}: {{ slot.table_name }}{{ end }}) {
{{~ if accessor.cross_references | array.size == 0 ~}}
        // No table references another.
{{~ else ~}}
{{~ for reference in accessor.cross_references ~}}
        for (record in {{ reference.table }}.records) {
{{~ for field in reference.fields ~}}
{{~ if field.is_array ~}}
            record.{{ field.name }} = ArrayList(record.{{ field.name }}Index.size)
            for (index in record.{{ field.name }}Index) {
                val target = {{ field.ref_table }}.{{ field.ref_lookup }}(index) ?: continue
                record.{{ field.name }}.add({{ field.value }})
            }
{{~ else ~}}
            {{ field.ref_table }}.{{ field.ref_lookup }}(record.{{ field.name }}Index)?.let { target ->
                record.{{ field.name }} = {{ field.value }}
            }
{{~ end ~}}
{{~ end ~}}
{{~## A reference that is a member of a record resolves inside the element, so the list is
   walked and each element's own key is looked up. Which list that is - the group's or the
   member's - the view decided, and a record of one has neither.
   spec/references-in-records.md. ##~}}
{{~ for member in reference.record_fields ~}}
{{~ if member.count != '' ~}}
            for (i in 0 until {{ member.count }}) {
                {{ member.ref_table }}.{{ member.ref_lookup }}({{ member.key }})?.let { target ->
                    {{ member.access }} = target
                }
            }
{{~ else ~}}
            {{ member.ref_table }}.{{ member.ref_lookup }}({{ member.key }})?.let { target ->
                {{ member.access }} = target
            }
{{~ end ~}}
{{~ end ~}}
{{~## A column reaching several tables that is a member of a record resolves inside the element,
   so the elements are walked and each one's own key is looked up. Which list that is - the
   group's or the member's - the view decided, and a record of one has neither.
   spec/multi-target-accessors.md ~ spec/references-in-records.md. ##~}}
{{~ for ref in reference.multi_record_fields ~}}
{{~ if ref.count != '' ~}}
            for (i in 0 until {{ ref.count }}) {
                if ({{ ref.key }} {{ ref.key_is_set }}) {
{{~ for target in ref.targets ~}}
                    if ({{ ref.target }} == {{ ref.target_type_name }}.{{ ref.none_label }}) {
                        {{ target.table }}.{{ target.lookup }}({{ ref.key }})?.let { found ->
                            {{ ref.slot }} = found
                            {{ ref.target }} = {{ ref.target_type_name }}.{{ target.label }}
                        }
                    }
{{~ end ~}}
                }
            }
{{~ else ~}}
            if ({{ ref.key }} {{ ref.key_is_set }}) {
{{~ for target in ref.targets ~}}
                if ({{ ref.target }} == {{ ref.target_type_name }}.{{ ref.none_label }}) {
                    {{ target.table }}.{{ target.lookup }}({{ ref.key }})?.let { found ->
                        {{ ref.slot }} = found
                        {{ ref.target }} = {{ ref.target_type_name }}.{{ target.label }}
                    }
                }
{{~ end ~}}
            }
{{~ end ~}}
{{~ end ~}}
{{~## A column reaching several tables is looked up in each of them in the order they were
   named, stopping at the first that has the key. The tables take separate id bands - an id in
   two of them is refused at conversion - so the order only decides which lookup runs.
   spec/multi-target-accessors.md. ##~}}
{{~ for ref in reference.multi_fields ~}}
            if (record.{{ ref.key_member }} {{ ref.key_is_set }}) {
{{~ for target in ref.targets ~}}
                if (record.{{ ref.target_member }} == {{ ref.target_type_name }}.{{ ref.none_label }}) {
                    {{ target.table }}.{{ target.lookup }}(record.{{ ref.key_member }})?.let { found ->
                        record.{{ ref.slot_member }} = found
                        record.{{ ref.target_member }} = {{ ref.target_type_name }}.{{ target.label }}
                    }
                }
{{~ end ~}}
            }
{{~ end ~}}
        }
{{~ end ~}}
{{~ end ~}}
    }
}
