{{~##
   The accessor: one static property per table, the load, and the reference linking.

   Its own file, holding no table's own code. That is what makes a deleted table a deleted
   file rather than a hunk somebody has to notice - and it is why this had to be split at
   the same time as the sweep landed, because a per-table file that nothing removes is worse
   than one big file.

   Anything needing the model arrives already rendered from CsView.

   Note for anyone editing: a literal closing brace pair inside a comment ends the comment,
   and a literal opening pair anywhere is read as code.
##~}}
{{ include 'csharp-file-head.sbn' ~}}
    public partial class {{ accessor_name }}
    {
{{ include 'csharp-read-bytes.sbn' ~}}
{{~ if tables | array.size > 0 }}
        /// <summary>
        /// The tables of one read.
        /// </summary>
        /// <remarks>
        /// A read builds one of these and publishes it whole. Two things follow, and both are
        /// about reading the data a second time - a refresh, a hot reload, a downloaded patch:
        ///
        /// Cross references are resolved among the tables in here, so no row ever points at a
        /// row from the previous load. Resolving against the published tables would do exactly
        /// that for as long as the read took.
        ///
        /// And a failure anywhere - a truncated file, a column this build cannot read, a
        /// duplicate index - publishes nothing. Every table stays as it was, which is the
        /// answer a service wants: the data it already had, and a reason.
        ///
        /// **Public, so a project can hold more than one.** `LoadAsync` hands one back without
        /// publishing it, which is what a test wanting its own data, a server opening two
        /// versions at once, or a hot reload building the next one while the current one is
        /// still being read all need. A project that wants none of that uses the static
        /// members below and never names this type.
        /// </remarks>
        public sealed class Snapshot
        {
{{~ for table in tables ~}}
            public {{ table.name }}Table {{ table.name }} = new {{ table.name }}Table();
{{~ end ~}}
        }

        /// <summary>
        /// The snapshot the static members read from - the last one published.
        /// </summary>
        /// <remarks>
        /// Null until the first read succeeds, so reaching for a table before loading fails at
        /// the point of the mistake rather than handing back something empty.
        /// </remarks>
        public static Snapshot Current { get; private set; }
{{~ end ~}}
{{~ for table in tables }}
        /// <summary>
        /// Property for {{ table.name }} table.
        /// </summary>
        public static {{ table.name }}Table {{ table.name }} => Current.{{ table.name }};
{{~ end ~}}

{{~ if tables | array.size > 0 }}
        /// <summary>
        /// Reads every table and links them, and hands the result back without publishing it.
        /// </summary>
        /// <remarks>
        /// The whole read, minus the last step. A caller wanting its own data - a test, a
        /// server holding two versions, the next generation of a hot reload - takes this one
        /// and never touches what everything else is reading.
        /// </remarks>
        public static async Task<Snapshot> LoadAsync(
            string basePath, string fileExtension = "{{ file_extension }}")
        {
            var snapshot = new Snapshot();
            var tasks = new List<Task>();
{{~ for table in tables ~}}
            tasks.Add(snapshot.{{ table.name }}.ReadAsync(System.IO.Path.Combine(basePath, $"{{ table.data_file_name }}{fileExtension}")));
{{~ end ~}}

            await Task.WhenAll(tasks);

            SolveCrossReferences(snapshot);

            return snapshot;
        }

        /// <summary>
        /// Makes a snapshot the one the static members read from.
        /// </summary>
        /// <remarks>
        /// The publish on its own, so a caller that loaded one itself can put it in place -
        /// which is what a hot reload does once the next generation has finished reading.
        /// </remarks>
        public static void Publish(Snapshot snapshot)
        {
            // The barrier keeps the writes that built these tables from being seen after the
            // reference to them, so a consumer on another thread reads this load or the one
            // before it - never a mixture.
            System.Threading.Thread.MemoryBarrier();

            Current = snapshot;
        }
{{~ end }}

        /// <summary>
        /// Read all tables.
        /// </summary>
        /// <remarks>
        /// Safe to call again on a loaded accessor. Nothing published changes until every file
        /// has been read and linked.
        /// </remarks>
        public static async Task ReadAllAsync(
            string basePath, string fileExtension = "{{ file_extension }}")
        {
{{~ if tables | array.size == 0 ~}}
            return await Task.CompletedTask;
{{~ else ~}}
            Publish(await LoadAsync(basePath, fileExtension));
{{~ end ~}}
        }
{{~ if tables | array.size > 0 }}

        /// <summary>
        /// Solve cross references, among the tables of one read.
        /// </summary>
        private static void SolveCrossReferences(Snapshot snapshot)
        {
{{~ for table in tables_with_references ~}}
{{~ if !for.first }}
{{ end ~}}
            foreach (var record in snapshot.{{ table.name }}.Records)
            {
{{~ for field in table.reference_fields ~}}
{{~ if field.kind == 'array_ref' ~}}
{{~## The keys' own length rather than the sheet's column count: the read sized this array
      from the file, so a number written in here would leave the last element unresolved on a
      file with one more - and index past the end on a file with one fewer.
      spec/nullable-array-elements.md. ##~}}
                for (int i = 0; i < record.{{ field.field_name }}_{{ field.ref_table }}_index.Length; i++)
                {
{{~ if field.references_field ~}}
                    if (record.{{ field.field_name }}_{{ field.ref_table }}_index[i] {{ field.ref_is_set }})
                    {
                        record.SetReference_{{ field.pascal_name }}_INTERNAL(i, snapshot.{{ field.ref_table }}.{{ field.ref_lookup }}(record.{{ field.field_name }}_{{ field.ref_table }}_index[i]).{{ field.ref_field }});
                        record.{{ field.field_name }}_F[i] = true;
                    }
{{~ else ~}}
                    if (record.{{ field.field_name }}_{{ field.ref_table }}_index[i] {{ field.ref_is_set }})
                    {
                        record.SetReference_{{ field.pascal_name }}_INTERNAL(i, snapshot.{{ field.ref_table }}.{{ field.ref_lookup }}(record.{{ field.field_name }}_{{ field.ref_table }}_index[i]));
                        record.{{ field.field_name }}_F[i] = true;
                    }
{{~ end ~}}
                }
{{~ else ~}}
                if (record.{{ field.field_name }}_{{ field.ref_table }}_index {{ field.ref_is_set }})
                {
{{~ if field.references_field ~}}
                    record.SetReference_{{ field.pascal_name }}_INTERNAL(snapshot.{{ field.ref_table }}.{{ field.ref_lookup }}(record.{{ field.field_name }}_{{ field.ref_table }}_index).{{ field.ref_field }});
{{~ else ~}}
                    record.SetReference_{{ field.pascal_name }}_INTERNAL(snapshot.{{ field.ref_table }}.{{ field.ref_lookup }}(record.{{ field.field_name }}_{{ field.ref_table }}_index));
{{~ end ~}}
                    record.{{ field.field_name }}_F = true;
                }
{{~ end ~}}
{{~ end ~}}
{{~## A reference that is a member of a record is resolved per element, so the array is
   walked and each element's own key is looked up. Which array that is - the group's or the
   member's - the view decided, and a record of one has neither.
   spec/references-in-records.md. ##~}}
{{~ for ref in table.record_reference_fields ~}}
{{~ if ref.count != '' ~}}
                for (int j = 0; j < {{ ref.count }}; j++)
                {
                    if ({{ ref.key }} {{ ref.ref_is_set }})
                    {
                        {{ ref.access }} = snapshot.{{ ref.ref_table }}.{{ ref.ref_lookup }}({{ ref.key }});
                        {{ ref.flag }} = true;
                    }
                }
{{~ else ~}}
                if ({{ ref.key }} {{ ref.ref_is_set }})
                {
                    {{ ref.access }} = snapshot.{{ ref.ref_table }}.{{ ref.ref_lookup }}({{ ref.key }});
                    {{ ref.flag }} = true;
                }
{{~ end ~}}
{{~ end ~}}
{{~## A column reaching several tables is looked up in each of them in the order they were
   named, and stops at the first that has the key. The tables take separate id bands - an id
   in two of them is refused at conversion - so "the first that has it" is "the one that has
   it", and the order only decides which lookup runs.

   A miss is not a fault: it means the row belongs to one of the others. So this resolves
   through the non-throwing lookup, and a key none of them holds leaves the discriminator at
   `None` rather than stopping the load. spec/multi-target-accessors.md. ##~}}
{{~## A member reaching several tables resolves inside the element, so the array is walked and
   each element's own key is looked up. Which array that is - the group's or the member's -
   the view decided, and a record of one has neither.
   spec/multi-target-accessors.md · spec/references-in-records.md. ##~}}
            }
{{~ end ~}}
        }
{{~ end ~}}
    }
{{ include 'csharp-file-foot.sbn' ~}}
