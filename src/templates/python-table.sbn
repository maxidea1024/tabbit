{{~## One table: its record class and its table class. ##~}}
{{ include 'python-file-head.sbn' ~}}
{{~## The element type of each record group, ahead of the row that holds one. A module-level
   class, because the package re-exports every generated name - which is also why the name
   carries the table's. ##~}}
{{~ for field in table.fields ~}}
{{~## An array of arrays declares no element type: its outer level has no name, so there is
   nothing for a class to be. spec/nested-multi-level.md. ##~}}
{{~ if field.is_record && !field.members_are_anonymous ~}}
{{~## One class per level, innermost first - which Python requires rather than prefers: the
   constructor names the level below, so that name has to exist by the time it runs. The view
   flattened the nesting so this loop does not have to know how deep it went.
   spec/nested-multi-level.md. ##~}}
{{~ for rt in field.record_types ~}}
class {{ rt.type_name }}:
{{~ if rt.is_outermost ~}}
    """One element of {{ rt.owner }}."""
{{~ else ~}}
    """A record inside {{ rt.owner }}."""
{{~ end ~}}

    __slots__ = ({{ rt.slot_names }})

    def __init__(self):
{{~ for member in rt.members ~}}
{{~ for line in member.initializers ~}}
        {{ line }}
{{~ end ~}}
{{~ end ~}}
{{~## The per-target accessors of every member of this class that reaches several tables. A
   property where the member is one value; a method taking the element number where the member
   is the array, which is the third place an element number sits.
   spec/multi-target-accessors.md. ##~}}

    def __repr__(self):
        return "{{ rt.type_name }}({{ rt.repr_format }})" % ({{ rt.repr_values }})


{{~ end ~}}
{{~ end ~}}
{{~ end ~}}
class {{ table.record_name }}:
    """Generated from {{ table.location }}.
{{~ for line in table.comment }}
    {{ line }}
{{~ end ~}}
    """

    __slots__ = ({{ table.slot_names }})

    def __init__(self):
{{~ if table.fields | array.size == 0 ~}}
        pass
{{~ end ~}}
{{~ for field in table.fields ~}}
{{~ for line in field.initializers ~}}
        {{ line }}
{{~ end ~}}
{{~ end ~}}
{{~## A column whose value is a row of one of several tables. One attribute for the resolved
   row whatever table it came from, and the discriminator saying which - the targets take
   separate id bands, so at most one of them ever answers.
   spec/multi-target-accessors.md. ##~}}
{{~ for field in table.fields ~}}
{{~ if field.variants.size > 0 }}

{{~## **The value, built once on first use.** The entry above is what the read filled - one
   assignment per column - and which variant it is only became knowable when the discriminator
   column arrived. Building it here keeps the read path and the wire exactly as they were.
   spec/polymorphism.md section 7.2. ##~}}

    def {{ field.name }}_of(self):
        """What this row's {{ field.abstract_type_name }} is. Narrow it with ``isinstance``."""
        built = getattr(self, "_{{ field.name }}_value", None)
        if built is not None:
            return built

{{~ for variant in field.variants ~}}
        {{ if for.first }}if{{ else }}elif{{ end }} self.{{ field.name }}.{{ field.discriminator_name }} == {{ variant.discriminator }}:
            built = {{ variant.type_name }}()
{{~ for member in field.base_members ~}}
{{~ if member.row_name != '' ~}}
{{~## A reference member is two of these: the key the cell held under its own name, and the row
   it resolved to under the derived one. spec/reference-surface-naming.md 4 and 5. ##~}}
            built.{{ member.name }} = self.{{ field.name }}.{{ member.name }}
            built.{{ member.row_name }} = self.{{ field.name }}.{{ member.row_name }}
{{~ else ~}}
            built.{{ member.name }} = self.{{ field.name }}.{{ member.name }}
{{~ end ~}}
{{~ end ~}}
{{~ for member in variant.members ~}}
{{~ if member.row_name != '' ~}}
{{~## A reference member is two of these: the key the cell held under its own name, and the row
   it resolved to under the derived one. spec/reference-surface-naming.md 4 and 5. ##~}}
            built.{{ member.name }} = self.{{ field.name }}.{{ member.name }}
            built.{{ member.row_name }} = self.{{ field.name }}.{{ member.row_name }}
{{~ else ~}}
            built.{{ member.name }} = self.{{ field.name }}.{{ member.name }}
{{~ end ~}}
{{~ end ~}}
{{~ end ~}}
        else:
{{~## An unknown number is a variant this build does not have. Unlike a column added later,
   which the reader skips, that makes the whole row uninterpretable. ##~}}
            raise ValueError(
                "{{ field.abstract_type_name }}: no variant is numbered %r"
                % (self.{{ field.name }}.{{ field.discriminator_name }},))

        self._{{ field.name }}_value = built
        return built
{{~ end ~}}
{{~ end ~}}

    def __repr__(self):
        return "{{ table.record_name }}({{ table.repr_format }})" % ({{ table.repr_values }})


class {{ table.table_name }}:
    """Every row of {{ table.raw_name }}."""

    __slots__ = ({{ table.table_slot_names }})

    def __init__(self):
        self.records = []
{{~ for index in table.indexes ~}}
        self.{{ index.map_name }} = {}
{{~ end ~}}
{{~ for index in table.indexes }}
{{~## A key of several columns is held as the text they make. Each part carries its own
   length, so no two combinations can make the same text - joined by a separator alone,
   ("a b", "c") and ("a", "b c") would be one key and one of the two rows would be lost.
   spec/primary-layout.md section 3.5. ##~}}
{{~ if index.is_composite ~}}
    @staticmethod
    def _key_of_{{ index.suffix }}({{ index.params }}):
        """Joins the columns of the {{ index.field_name }} key into the text the map is keyed by."""
        parts = [
{{~ for c in index.components ~}}
{{~ if c.kind == "string" ~}}
            {{ c.param }},
{{~ else ~}}
            str(int({{ c.param }})),
{{~ end ~}}
{{~ end ~}}
        ]

        return "".join("%d:%s" % (len(part), part) for part in parts)

{{~ end ~}}
    def find_by_{{ index.suffix }}(self, {{ index.params }}):
        """The row with this {{ index.field_name }}, or None when the table has none.

        The lookup to reach for when a missing row is an ordinary answer - an optional
        reference, a key that came from user input.
        """
        return self.{{ index.map_name }}.get({{ index.argument }})

    def get_by_{{ index.suffix }}_or_throw(self, {{ index.params }}):
        """The row with this {{ index.field_name }}, or a raised error naming what was missing.

        For a key that has to be there - one from another table, or a constant. The name
        says it raises, because a caller reading `get_by_{{ index.suffix }}(key).name` at a
        glance cannot otherwise tell whether the next line is a check or a try.
        """
        record = self.{{ index.map_name }}.get({{ index.argument }})

        if record is None:
            raise tabbit.RecordNotFoundError(
                "there is no record in table `{{ table.raw_name }}` that corresponds to "
                "field `{{ index.field_name }}` value {{ index.value_format }}" % ({{ index.value_args }},))

        return record

    def contains_{{ index.suffix }}(self, {{ index.params }}):
        """Whether the table holds a row with this {{ index.field_name }}."""
        return {{ index.argument }} in self.{{ index.map_name }}
{{~ end ~}}

    def read(self, filename):
        """Loads the table from a .tcb file written by Tabbit.

        Column by column, matched by tag rather than position: a column this build does
        not know is skipped by its block length, and one whose type changed incompatibly
        fails naming the field.
        """
        # Imported here rather than at the top: `{{ accessor_module }}` imports this module,
        # so at import time it is half built and at call time it is not.
        from .{{ accessor_module }} import {{ accessor_name }}

        # Opened unconditionally, and with whatever `{{ accessor_name }}.encryption_key` and
        # `{{ accessor_name }}.mac_key` hold - which is None unless the project set them. A file that is
        # neither encrypted nor signed comes back from this untouched, so the load path is
        # the same either way and there is no condition here that could be the wrong way
        # round. spec/tcb-mac-and-signature.md.
        reader = tabbit.Reader(tabbit.open(
            tabbit.read_all_bytes(filename), {{ accessor_name }}.encryption_key,
            {{ accessor_name }}.mac_key, {{ accessor_name }}.verify_mac))
        count, columns = tabbit.read_table_header(reader)

        # Read into storage of its own and published at the end: reading a table that is already loaded is a refresh, and one that turns out to be unreadable has to leave the rows already there alone.
        records = [{{ table.record_name }}() for _ in range(count)]

        for column in columns:
            block_end = reader.position + column.byte_length
{{~ for column_view in table.columns ~}}
            {{ if for.first }}if{{ else }}elif{{ end }} column.tag == {{ column_view.wire_tag }}:
                {{ column_view.column_check }}
{{~ if column_view.is_nullable ~}}
                # The bitmap is at the front of the block, so it is read before the values.
                # The values are written for every row either way, which is what lets the
                # read shapes below stay as they are.
                presence = tabbit.read_presence(reader, column, count)
{{~ end ~}}
{{~ if column_view.has_optional_elements ~}}
                # Behind the row bitmap and in front of the values, walked with a counter
                # that steps once per element of every row.
                # spec/nullable-array-elements.md.
                element_presence = tabbit.read_element_presence(reader, column)
                element_at = 0
{{~ end ~}}
{{~## Opened here, ahead of every read shape, because an array's elements read through it
      as well: its block states an encoding for them and one for the row lengths, and the
      cursor is what decodes both. After the presence bitmap, which sits in front of the
      block the cursor is about to start reading. ##~}}
{{~ if column_view.cursor_open != '' ~}}
                {{ column_view.cursor_open }}
{{~ end ~}}
{{~ if column_view.run_call != '' ~}}
{{~## A run of equal values costs one call and then plain assignments, rather than one
      call per row that each re-dispatch on the encoding. An encoding with no run to
      give answers 1, so this loop is correct over all of them. ##~}}
                at = 0
                while at < count:
                    n, value = cursor.{{ column_view.run_call }}(count - at)
                    for i in range(at, at + n):
                        {{ column_view.run_spend }}
                    at += n
{{~ else ~}}
                for record in records:
{{~ if column_view.kind == 'var_array' ~}}
                    {{ column_view.length_read }}
                    record.{{ column_view.name }} = [{{ column_view.read_element }} for _ in range(element_count)]
{{~ if column_view.has_optional_elements ~}}
                    record.{{ column_view.element_presence_member }} = [
                        tabbit.is_present(element_presence, element_at + at)
                        for at in range(element_count)]
                    element_at += element_count
{{~ end ~}}
{{~ else if column_view.kind == 'record_var' ~}}
                    {{ column_view.length_read }}
{{~ if column_view.is_first_member ~}}
                    # The first member builds the list; the rest check. Building it again
                    # would discard what the members before it wrote, and taking the shorter
                    # of two counts would shift every value after it.
                    record.{{ column_view.name }} = [
                        {{ column_view.record_type_name }}() for _ in range(element_count)]
{{~ else ~}}
                    if len(record.{{ column_view.name }}) != element_count:
                        raise tabbit.TcbError(
                            "{{ table.raw_name }}.{{ column_view.name }}: the file gives one member of "
                            "this record a different element count than another")
{{~ end ~}}
                    for element in range(element_count):
                        record.{{ column_view.name }}[element]{{ column_view.member_access }}{{ column_view.member_ref_suffix }} = {{ column_view.read_element }}
{{~ else if column_view.kind == 'array_of_arrays_member' ~}}
{{~## One inner list. Which outer element it is, is which column this is - so that index is
   fixed and the loop runs the inner length. spec/nested-multi-level.md. ##~}}
                    {{ column_view.length_read }}
                    record.{{ column_view.name }}[{{ column_view.member_at }}] = [None] * element_count
                    for element in range(element_count):
                        record.{{ column_view.name }}[{{ column_view.member_at }}][element] = {{ column_view.read_element }}
{{~ else if column_view.kind == 'record_member_var' ~}}
{{~## The member is the list: the index goes after its name rather than before. Same
   columns and same loop as the case below - see spec/nested-multi-level.md. ##~}}
                    {{ column_view.length_read }}
                    record.{{ column_view.name }}{{ column_view.member_access }}{{ column_view.member_ref_suffix }} = [None] * element_count
                    for element in range(element_count):
                        record.{{ column_view.name }}{{ column_view.member_access }}{{ column_view.member_ref_suffix }}[element] = {{ column_view.read_element }}
{{~ else if column_view.kind == 'var_array_ref' ~}}
{{~## A trimmed array of references. The keys go in the list beside the values, at this row's
   length - which is what `serial_ref` below does from the column count.
   spec/variable-length-record-arrays.md. ##~}}
                    {{ column_view.length_read }}
                    record.{{ column_view.key_name }} = [{{ column_view.read_element }} for _ in range(element_count)]
                    record.{{ column_view.row_name }} = [None] * element_count
{{~ if column_view.has_optional_elements ~}}
                    record.{{ column_view.element_presence_member }} = [
                        tabbit.is_present(element_presence, element_at + at)
                        for at in range(element_count)]
                    element_at += element_count
{{~ end ~}}
{{~ else if column_view.kind == 'scalar_ref' ~}}
                    record.{{ column_view.key_name }} = {{ column_view.read_scalar }}
{{~ else ~}}
                    record.{{ column_view.name }}{{ column_view.member_access }}{{ column_view.member_ref_suffix }} = {{ column_view.read_scalar }}
{{~ end ~}}
{{~ end ~}}
{{~ if column_view.is_nullable }}
                # A pass of its own rather than a line inside each read shape, so the row
                # index is worked out once. The block carries a value for every row, so an
                # absent one has just been given whatever was there; putting the empty value
                # back is what makes this path agree with the JSON one.
                for row, record in enumerate(records):
                    record.{{ column_view.presence_member }} = tabbit.is_present(presence, row)

                    if not record.{{ column_view.presence_member }}:
                        record.{{ column_view.name }} = {{ column_view.empty_value }}
{{~ end ~}}
{{~ end ~}}
            else:
                # A column added after this code was generated.
                reader.skip(column.byte_length)

            tabbit.check_block_end(reader, column, block_end)

{{~ for index in table.indexes ~}}
{{~ if index.is_composite ~}}
        {{ index.map_name }} = {
            self._key_of_{{ index.suffix }}({{ for c in index.components }}record.{{ c.member }}{{ if !for.last }}, {{ end }}{{ end }}): record
            for record in records
        }
{{~ else ~}}
        {{ index.map_name }} = {record.{{ index.member }}: record for record in records}
{{~ end ~}}
{{~ end ~}}

        # Published, now that every column read.
        self.records = records
{{~ for index in table.indexes ~}}
        self.{{ index.map_name }} = {{ index.map_name }}
{{~ end ~}}
