{{~## One table: its record constructor and its table class.

   Rows are plain tables built whole and then sealed behind a strict metatable, so a
   misspelled field is an error at the access instead of a silent nil - and because every
   declared field is filled before the metatable goes on, correct reads and writes never
   pay for the check. spec/targets/lua-language-support.md. ##~}}
{{ include 'lua-file-head.sbn' }}
{{~## The element type of each record group, ahead of the row that holds one. Innermost
   first, which is required rather than tidy: a constructor names the level below, and
   that local has to exist by the time the line runs. ##~}}
{{~ for field in table.fields ~}}
{{~ if field.is_record && !field.members_are_anonymous ~}}
{{~ for rt in field.record_types ~}}
---@class {{ rt.type_name }}
{{~ for line in rt.annotations ~}}
{{ line }}
{{~ end ~}}
{{~## The second layer of a container's surface. The arrays above are the file's order; these
   are the lookup, and a table has no order of its own.
   spec/types/set-and-map.md section 7. ##~}}
{{~ for line in rt.lookup_annotations ~}}
{{ line }}
{{~ end ~}}
{{~## An element with a member reaching several tables has methods rather than being only data,
   which is what the per-target accessor needs: it asks the discriminator and then hands back
   the slot. Only such an element - one with none keeps `strictType`, so nothing already
   generated moves. This is the row-level shape one level in.
   spec/references/multi-target-accessors.md. ##~}}
local {{ rt.type_name }}Meta = tcb.strictType("{{ if rt.is_outermost }}an element of{{ else }}a record inside{{ end }} {{ rt.owner }}", { {{ rt.field_names }} })

---@return {{ rt.type_name }}
local function new{{ rt.type_name }}()
  return setmetatable({
{{~ for member in rt.members ~}}
{{~ for line in member.initializers ~}}
    {{ line }}
{{~ end ~}}
{{~ end ~}}
{{~ for line in rt.lookups ~}}
    {{ line }}
{{~ end ~}}
  }, {{ rt.type_name }}Meta)
end

{{~ end ~}}
{{~ end ~}}
{{~ end ~}}
-- Generated from {{ table.location }}.
{{~ for line in table.comment ~}}
-- {{ line }}
{{~ end ~}}
---@class {{ table.record_name }}
{{~ for line in table.annotations ~}}
{{ line }}
{{~ end ~}}
{{~## A row that has methods rather than one that is only data, which is what a column
   reaching several tables needs: the per-target accessor asks the discriminator and then hands
   back the slot. Only such a row - a table with no multi-target column keeps `strictType`, so
   nothing already generated moves. spec/references/multi-target-accessors.md. ##~}}
local {{ table.record_name }}Meta = tcb.strictType("a `{{ table.raw_name }}` row", { {{ table.record_field_names }} })

---@return {{ table.record_name }}
local function new{{ table.record_name }}()
  return setmetatable({
{{~ for field in table.fields ~}}
{{~ for line in field.initializers ~}}
    {{ line }}
{{~ end ~}}
{{~ end ~}}
{{~## Set here rather than left absent: the discriminator is a value a consumer reads, and a
   row whose key points at nothing has to answer the same thing here as it does in every other
   language. Absent would answer nil. spec/references/multi-target-accessors.md. ##~}}
  }, {{ table.record_name }}Meta)
end

---@class {{ table.table_name }}
---@field records {{ table.record_name }}[]
local {{ table.table_name }} = {}

local {{ table.table_name }}Meta = tcb.strictInstance("the `{{ table.raw_name }}` table", {{ table.table_name }}, { {{ table.table_field_names }} })

function {{ table.table_name }}.new()
  return setmetatable({
    records = {},
{{~ for index in table.indexes ~}}
    {{ index.map_name }} = {},
{{~ end ~}}
{{~ if table.matrix ~}}
{{~## Named here as well as in the strict field list: `strictInstance` refuses a field it was
      not told about, and the axis arrives after the read. ##~}}
    columnAxis = nil,
{{~ end ~}}
  }, {{ table.table_name }}Meta)
end

-- How many rows the table holds.
--
-- A method rather than `#table`: LuaJIT 2.1 does not call `__len` on a table, so the
-- operator would answer on 5.3+ and not on the other runtime this output has to run on.
function {{ table.table_name }}:count()
  return #self.records
end

-- The rows, in the order the file wrote them - `for row in table:iter() do`.
--
-- The list is read once, here. A refresh replaces it rather than its contents, so a loop
-- already running keeps the rows it started with.
function {{ table.table_name }}:iter()
  local records = self.records
  local i = 0

  return function()
    i = i + 1
    return records[i]
  end
end
{{~ if table.matrix }}
{{~ m = table.matrix ~}}
{{~## The two lookups composed. Both halves already exist - this table indexes its rows by the
   row axis and the column table indexes its own by the column axis - and what this adds is the
   one call that goes through both.

   The position the file carries counts from 0 and a Lua array counts from 1, so every
   subscript below adds one. spec/layout/matrix-declaration.md section 8. ##~}}
-- Hands this table the column axis its cells are positioned by.
--
-- Called by the accessor once both files are read, and the length check is here rather than in
-- the read. A grid is two files, either can be deployed without the other, and a row whose
-- array is a different length from the axis is a row whose cells have moved.
function {{ table.table_name }}:linkColumnAxis(columns)
  for _, record in ipairs(self.records) do
    if #record.{{ m.grid_member }} ~= #columns.records then
      tcb.fail("table `{{ table.raw_name }}` holds %d cells for `%s` and its column axis " ..
        "`{{ m.column_table }}` holds %d keys; the two files are from different builds",
        #record.{{ m.grid_member }}, tostring(record.{{ m.row_key_member }}), #columns.records)
    end
  end

  self.columnAxis = columns
end

-- The row axis keys, in the order the file wrote them.
function {{ table.table_name }}:rowKeys()
  local keys = {}

  for i, record in ipairs(self.records) do
    keys[i] = record.{{ m.row_key_member }}
  end

  return keys
end

-- The column axis keys, in the order a row holds its cells.
function {{ table.table_name }}:colKeys()
  local keys = {}

  if self.columnAxis == nil then
    return keys
  end

  for i, record in ipairs(self.columnAxis.records) do
    keys[i] = record.{{ m.column_key_member }}
  end

  return keys
end

-- One row of cells, or nil when the grid has no such row.
--
-- In the order `colKeys` is in, which is what makes a position mean something.
function {{ table.table_name }}:row({{ m.row_key_param }})
  local record = self:{{ m.row_lookup }}({{ m.row_key_param }})
  return record ~= nil and record.{{ m.grid_member }} or nil
end

-- The cell where the two keys meet, or a raised error naming the one that missed.
--
-- It raises rather than answering with the type's empty value, because a grid's empty value is
-- one the sheet can write - 0 in a modifier table is a modifier of zero.
function {{ table.table_name }}:at({{ m.row_key_param }}, {{ m.column_key_param }})
  local record, position = self:cellAt({{ m.row_key_param }}, {{ m.column_key_param }})
  return record.{{ m.grid_member }}[position]
end
{{~ if m.cells_are_optional }}

-- Whether the sheet gave the cell where the two keys meet a value.
--
-- A grid whose cells are optional reads a blank as the type's empty value, and that value is
-- one the sheet could also have written - so this is the only way to tell them apart.
function {{ table.table_name }}:hasAt({{ m.row_key_param }}, {{ m.column_key_param }})
  local record, position = self:cellAt({{ m.row_key_param }}, {{ m.column_key_param }})
  return record.{{ m.grid_has_member }}[position]
end
{{~ end }}

-- Both lookups, done once for the readers above. The position it answers with is already
-- shifted to where a Lua array holds it.
function {{ table.table_name }}:cellAt({{ m.row_key_param }}, {{ m.column_key_param }})
  if self.columnAxis == nil then
    tcb.fail("table `{{ table.raw_name }}` has no column axis yet; " ..
      "read `{{ m.column_table }}` before reading a cell")
  end

  local record = self:{{ m.row_lookup }}({{ m.row_key_param }})

  if record == nil then
    tcb.fail("table `{{ table.raw_name }}` has no row `%s`", tostring({{ m.row_key_param }}))
  end

  local column = self.columnAxis:{{ m.column_lookup }}({{ m.column_key_param }})

  if column == nil then
    tcb.fail("table `{{ table.raw_name }}` has no column `%s`", tostring({{ m.column_key_param }}))
  end

  return record, column.{{ m.at_member }} + 1
end

{{~ end ~}}
{{~ for index in table.indexes }}
{{~## A key of several columns is held as the text they make. Each part carries its own
   length, so no two combinations can make the same text - joined by a separator alone,
   ("a b", "c") and ("a", "b c") would be one key and one of the two rows would be lost.
   spec/layout/primary-layout.md section 3.5. ##~}}
{{~ if index.is_composite ~}}
-- Joins the columns of the {{ index.field_name }} key into the text the map is keyed by.
local function keyOf{{ index.suffix }}({{ index.params }})
  local parts = {
{{~ for c in index.components ~}}
{{~ if c.kind == "string" ~}}
    {{ c.param }},
{{~ else if c.kind == "int64" ~}}
{{~## Under LuaJIT a 64-bit value is FFI cdata, whose tostring is not the decimal a caller
   passing a plain number would give - the same normalization a 64-bit single key uses. ##~}}
    tcb.int64String({{ c.param }}),
{{~ else ~}}
    tostring({{ c.param }}),
{{~ end ~}}
{{~ end ~}}
  }

  local text = {}

  for i = 1, #parts do
    text[i] = #parts[i] .. ":" .. parts[i]
  end

  return table.concat(text)
end

{{~ end ~}}
-- The row with this {{ index.field_name }}, or nil when the table has none: the lookup to
-- reach for when a missing row is an ordinary answer.
function {{ table.table_name }}:findBy{{ index.suffix }}({{ index.params }})
{{~ if index.normalizes_int64 ~}}
  return self.{{ index.map_name }}[tcb.int64String(key)]
{{~ else ~}}
  return self.{{ index.map_name }}[{{ index.argument }}]
{{~ end ~}}
end

-- The row with this {{ index.field_name }}, or a raised error naming what was missing -
-- for a key that has to be there.
function {{ table.table_name }}:getBy{{ index.suffix }}OrThrow({{ index.params }})
  local record = self:findBy{{ index.suffix }}({{ index.params }})

  if record == nil then
    tcb.fail("there is no record in table `{{ table.raw_name }}` that corresponds to " ..
      "field `{{ index.field_name }}` value {{ index.value_format }}", {{ index.value_args }})
  end

  return record
end

-- Whether the table holds a row with this {{ index.field_name }}.
function {{ table.table_name }}:contains{{ index.suffix }}({{ index.params }})
  return self:findBy{{ index.suffix }}({{ index.params }}) ~= nil
end
{{~ if index.is_primary && !index.is_composite }}

-- Each row with the {{ index.field_name }} it is keyed by -
-- `for key, row in table:entries() do`.
--
-- What this saves a caller is not the key value - the row carries it - but having to know
-- which column the key is: {{ index.field_name }} here, something else in the next table.
--
-- The rows come in the order the file wrote them rather than the order the map holds them,
-- which makes this and `iter` agree. Only the primary key has this: a table keyed by
-- several columns together has no single key value to pair a row with.
function {{ table.table_name }}:entries()
  local records = self.records
  local i = 0

  return function()
    i = i + 1
    local record = records[i]

    if record == nil then
      return nil
    end

    return record{{ index.access }}, record
  end
end
{{~ end }}
{{~ end }}
-- Loads the table from the bytes of a .tcb file written by Tabbit. Column by column,
-- matched by tag rather than position: a column this build does not know is skipped by
-- its block length, and one whose type changed incompatibly fails naming the field.
function {{ table.table_name }}:readBytes(data)
  -- Required here rather than at the top: the accessor requires this module, so at load
  -- time it is half built and at call time it is not.
  local accessor = require(_root .. "{{ accessor_module }}")

  -- Opened unconditionally, with whatever keys the accessor holds - nil unless the
  -- project set them. A file that is neither encrypted nor signed comes back untouched,
  -- so the load path is the same either way. spec/wire/tcb-mac-and-signature.md.
  local reader = tcb.newReader(tcb.open(
    data, accessor.encryptionKey, accessor.macKey, accessor.verifyMac))
  local count, columns = tcb.readTableHeader(reader)

  -- Read into storage of its own and published at the end: reading a table that is
  -- already loaded is a refresh, and one that turns out to be unreadable has to leave
  -- the rows already there alone.
  local records = {}

  for i = 1, count do
    records[i] = new{{ table.record_name }}()
  end

  for c = 1, #columns do
    local column = columns[c]
    local blockEnd = reader.position + column.byteLength

{{~ for column_view in table.columns ~}}
    {{ if for.first }}if{{ else }}elseif{{ end }} column.tag == {{ column_view.wire_tag }} then
      {{ column_view.column_check }}
{{~ if column_view.is_nullable ~}}
      -- The bitmap is at the front of the block, so it is read before the values. The
      -- values are written for every row either way, which is what lets the read shapes
      -- below stay as they are.
      local presence = tcb.readPresence(reader, column, count)
{{~ end ~}}
{{~ if column_view.has_optional_elements ~}}
      -- Behind the row bitmap and in front of the values, walked with a counter that
      -- steps once per element of every row. spec/types/nullable-array-elements.md.
      local elementPresence = tcb.readElementPresence(reader, column)
      local elementAt = 0
{{~ end ~}}
{{~ if column_view.cursor_open != '' ~}}
      {{ column_view.cursor_open }}
{{~ end ~}}
{{~ if column_view.run_call != '' ~}}
{{~## A run of equal values costs one call and then plain assignments, rather than one
      call per row that each re-dispatch on the encoding. An encoding with no run to
      give answers 1, so this loop is correct over all of them. ##~}}
      local at = 0

      while at < count do
        local n, value = cursor:{{ column_view.run_call }}(count - at)

        for i = at + 1, at + n do
          {{ column_view.run_spend }}
        end

        at = at + n
      end
{{~ else ~}}
      for i = 1, count do
        local record = records[i]
{{~ if column_view.kind == 'var_array' || column_view.kind == 'var_array_ref' ~}}
        {{ column_view.length_read }}
        local values = {}

        for element = 1, elementCount do
          values[element] = {{ column_view.read_element }}
        end

        {{ column_view.values_target }} = values
{{~ if column_view.kind == 'var_array_ref' ~}}
{{~## A reference array read its keys above - `values_target` is the key list for it - so the
   list the consumer reads starts empty and the linking pass fills it.
   spec/types/variable-length-record-arrays.md. ##~}}
        {{ column_view.secondary_clear }}
{{~ end ~}}
{{~ if column_view.has_optional_elements ~}}
        local answers = {}

        for element = 1, elementCount do
          answers[element] = tcb.isPresent(elementPresence, elementAt + element - 1)
        end

        elementAt = elementAt + elementCount
        {{ column_view.element_presence_target }} = answers
{{~ end ~}}
{{~ else if column_view.kind == 'record_var' ~}}
        {{ column_view.length_read }}
{{~ if column_view.is_first_member ~}}
        -- The first member builds the list; the rest check. Building it again would
        -- discard what the members before it wrote, and taking the shorter of two
        -- counts would shift every value after it.
        {{ column_view.group_target }} = tcb.filledArray(elementCount, {{ column_view.record_constructor }})
{{~ else ~}}
        if #{{ column_view.group_target }} ~= elementCount then
          tcb.fail("{{ table.raw_name }}: the file gives one member of this record a " ..
            "different element count than another")
        end
{{~ end ~}}

        for element = 1, elementCount do
          {{ column_view.element_target }} = {{ column_view.read_element }}
        end
{{~ else if column_view.kind == 'array_of_arrays_member' ~}}
{{~## One inner list. Which outer element it is, is which column this is - so that index
   is written in and the loop runs the inner length. spec/types/nested-multi-level.md. ##~}}
        {{ column_view.length_read }}
        {{ column_view.element_container }} = {}
        for element = 1, elementCount do
          {{ column_view.element_target }} = {{ column_view.read_element }}
        end
{{~ else if column_view.kind == 'record_member_var' ~}}
{{~## The member is the list: the subscript goes after its name rather than before, and
   its length is this row's. ##~}}
        {{ column_view.length_read }}
        {{ column_view.element_container }} = {}
        for element = 1, elementCount do
          {{ column_view.element_target }} = {{ column_view.read_element }}
        end
{{~ else ~}}
        {{ column_view.scalar_target }} = {{ column_view.read_scalar }}
{{~ end ~}}
      end
{{~ end ~}}
{{~ if column_view.is_nullable }}
      -- A pass of its own rather than a line inside each read shape, so the row index
      -- is worked out once. The block carries a value for every row, so an absent one
      -- has just been given whatever was there; putting the empty value back is what
      -- makes this path agree with the JSON one.
      for i = 1, count do
        local record = records[i]

        {{ column_view.presence_target }} = tcb.isPresent(presence, i - 1)

        if not {{ column_view.presence_target }} then
          {{ column_view.empty_target }} = {{ column_view.empty_value }}
        end
      end
{{~ end ~}}
{{~ end ~}}
    else
      -- A column added after this code was generated.
      reader:skip(column.byteLength)
    end

    tcb.checkBlockEnd(reader, column, blockEnd)
  end
{{~ if table.container_fill | array.size > 0 }}
{{~## The lookups a `set` and a `map` publish beside their arrays. Here rather than on the way
   through: a map needs its key column and how long it is, and the columns arrive one at a
   time. spec/types/set-and-map.md section 7.3. ##~}}
  for i = 1, #records do
    local record = records[i]
{{~ for line in table.container_fill ~}}
    {{ line }}
{{~ end ~}}
  end
{{~ end ~}}
{{~ for index in table.indexes }}
  local {{ index.map_name }} = {}

  for i = 1, #records do
{{~ if index.normalizes_int64 ~}}
    {{ index.map_name }}[tcb.int64String(records[i]{{ index.access }})] = records[i]
{{~ else if index.is_composite ~}}
    {{ index.map_name }}[keyOf{{ index.suffix }}({{ for c in index.components }}records[i]{{ c.member }}{{ if !for.last }}, {{ end }}{{ end }})] = records[i]
{{~ else ~}}
    {{ index.map_name }}[records[i]{{ index.access }}] = records[i]
{{~ end ~}}
  end
{{~ end }}
  -- Published, now that every column read.
  self.records = records
{{~ for index in table.indexes ~}}
  self.{{ index.map_name }} = {{ index.map_name }}
{{~ end ~}}
end

-- The same load from a file on disk.
function {{ table.table_name }}:read(filename)
  self:readBytes(tcb.readAllBytes(filename))
end

{{~ for field in table.fields ~}}
{{~ if field.variants.size > 0 }}
{{~## **The value, built once on first use.** The entry is what the read filled - one assignment
   per column - and which variant it is only became knowable when the discriminator column
   arrived. Building it here keeps the read path and the wire exactly as they were.

   A function on the table rather than a field on the row, because the row's strict metatable
   declares its fields and a lazily added one would be an error to write.
   spec/types/polymorphism.md section 7.2. ##~}}
{{~ if field.variants_are_array ~}}
{{~## **The array shape.** Each element carries its own discriminator - section 5.3 - so the
   shapes inside one row may differ, and what a consumer reads is a list of the abstract type.
   The function that builds one is below and is the same either way. ##~}}
--- What one row's {{ field.abstract_type_name }}s are, one per element. Narrow each on `.kind`.
---@param row {{ table.record_name }}
function {{ table.table_name }}.{{ field.name }}Of(row)
  local all = {}

  for element = 1, #row.{{ field.name }} do
    all[element] = {{ table.table_name }}.{{ field.name }}Element(row.{{ field.name }}[element])
  end

  return all
end
{{~ else ~}}
--- What one row's {{ field.abstract_type_name }} is. Narrow it on `.kind`.
---@param row {{ table.record_name }}
function {{ table.table_name }}.{{ field.name }}Of(row)
  return {{ table.table_name }}.{{ field.name }}Element(row.{{ field.name }})
end
{{~ end ~}}

--- Builds one value from the entry the read filled.
function {{ table.table_name }}.{{ field.name }}Element(entry)
  local built

{{~ for variant in field.variants ~}}
  {{ if for.first }}if{{ else }}elseif{{ end }} entry.{{ field.discriminator_name }} == {{ variant.discriminator }} then
    built = {{ field.abstract_type_name }}.new{{ variant.type_name }}()
{{~ for member in field.base_members ~}}
{{~ if member.row_name != '' ~}}
{{~## A reference member is two of these: the key the cell held under its own name, and the row
   it resolved to under the derived one. spec/references/reference-surface-naming.md 4 and 5. ##~}}
    built.{{ member.name }} = entry.{{ member.name }}
    built.{{ member.row_name }} = entry.{{ member.row_name }}
{{~ else ~}}
    built.{{ member.name }} = entry.{{ member.name }}
{{~ end ~}}
{{~ end ~}}
{{~ for member in variant.members ~}}
{{~ if member.row_name != '' ~}}
{{~## A reference member is two of these: the key the cell held under its own name, and the row
   it resolved to under the derived one. spec/references/reference-surface-naming.md 4 and 5. ##~}}
    built.{{ member.name }} = entry.{{ member.name }}
    built.{{ member.row_name }} = entry.{{ member.row_name }}
{{~ else ~}}
    built.{{ member.name }} = entry.{{ member.name }}
{{~ end ~}}
{{~ end ~}}
{{~ end ~}}
  else
{{~## An unknown number is a variant this build does not have. Unlike a column added later,
   which the reader skips, that makes the whole row uninterpretable. ##~}}
    error("{{ field.abstract_type_name }}: no variant is numbered "
          .. tostring(entry.{{ field.discriminator_name }}))
  end

  return built
end

{{~ end ~}}
{{~ end ~}}
return {{ table.table_name }}
