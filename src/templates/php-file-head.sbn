// regenerated.
// ------------------------------------------------------------------------------

declare(strict_types=1);

namespace {{ namespace }};
{{~ if requires | array.size > 0 ~}}

{{~ for line in requires ~}}
{{ line }}
{{~ end ~}}
{{~ end ~}}

