{{~## The accessor struct and the two calls that drive it. ##~}}
{{ include 'c-header-head.sbn' ~}}
/* Every table, loaded together so cross-table references can be resolved. */
typedef struct {{ accessor.type_name }} {
{{~ if accessor.tables | array.size == 0 ~}}
  char unused; /* No tables. */
{{~ end ~}}
{{~ for slot in accessor.tables ~}}
  {{ slot.table_name }} {{ slot.name }};
{{~ end ~}}
} {{ accessor.type_name }};

/* Reads every table from base_path, then links the references between them.
 *
 * Declare the struct zeroed - `{{ accessor.type_name }} data = {0};` - and this is safe to
 * call again on it afterwards. That is what a reload is: every file is read beside what the
 * struct already holds and swapped in at the end, so the pointers a caller is holding stay
 * valid until this returns true, and stay valid for the previous load if it returns false.
 *
 * Returns false if any table could not be read, having released whatever had been loaded up
 * to that point and left `data` alone - a half-loaded model is not one to hand back. */
bool {{ accessor.name }}_LoadAll({{ accessor.type_name }}* data, const char* base_path,
                 char* error, size_t error_size);

/* The same, for data files carrying some other extension than the one the recipe told
 * the exporter to write. `file_extension` includes the dot. */
bool {{ accessor.name }}_LoadAllWithExtension({{ accessor.type_name }}* data, const char* base_path,
                 const char* file_extension, char* error, size_t error_size);

void {{ accessor.name }}_Free({{ accessor.type_name }}* data);
{{ include 'c-header-foot.sbn' ~}}
