{{~##
   One table: its Record, the read, the indexes and the object-value map.

   One file per table, so deleting a table from the sheets deletes a file rather than
   leaving a hunk of dead code inside a larger one. `table` is the single table this file is
   for; nothing here loops over the model.

   Anything needing the model arrives already rendered from CsView.

   Note for anyone editing: a literal closing brace pair inside a comment ends the comment,
   and a literal opening pair anywhere is read as code.
##~}}
{{ include 'csharp-file-head.sbn' ~}}
{{~ for line in table.comment ~}}
{{~ if for.first ~}}
    /// <summary>
{{~ end ~}}
    /// {{ line }}
{{~ if for.last ~}}
    /// </summary>
{{~ end ~}}
{{~ end ~}}
    [System.Serializable]
    public partial class {{ table.name }}Table
    {
        #region Record
        [System.Serializable]
        public partial class Record
        {
            #region Values
{{~## The readable surface first, and the storage below it. A property and its
      backing field on adjacent lines reads as noise where the field is never the
      thing a consumer wants; grouped, the top of the record is what it holds and
      the bottom is how. ##~}}
{{~ for field in table.fields ~}}
{{~ if !for.first }}
{{ end ~}}
{{~ for line in field.comment ~}}
{{~ if for.first ~}}
            /// <summary>
{{~ end ~}}
            /// {{ line }}
{{~ if for.last ~}}
            /// </summary>
{{~ end ~}}
{{~ end ~}}
{{~## **No length in the public API.** A number published here could only be the one the
      sheet had when this code was generated, and a consumer holding to it would be holding
      to something the data no longer has to agree with - `Length` on the array is the answer
      and it cannot go stale.

      Where several columns fill one array - a record group, an array of arrays - the length
      is still a number this code has to know, because no single column owns the array and
      the columns have to agree on how long it is. Those keep it as a private constant, used
      by the allocation and by nothing else. Where one column owns the array, the length is
      read from that column's descriptor and there is no constant at all.
      spec/nullable-array-elements.md. ##~}}
{{~ if field.kind == 'array_of_arrays' ~}}
{{~## No element type: the outer level has no name to be a property of, so it is an array
      too. `_N` is the outer count and `_M` the inner one. spec/nested-multi-level.md. ##~}}
            public {{ field.field_type }}[] {{ field.prop_name }} => {{ field.field_name }};
            internal const int {{ field.pascal_name }}_N = {{ field.outer_count }};
            internal const int {{ field.pascal_name }}_M = {{ field.element_count }};
{{~ else if field.kind == 'record_array' ~}}
            public {{ field.field_type }}[] {{ field.prop_name }} => {{ field.field_name }};
            internal const int {{ field.pascal_name }}_N = {{ field.element_count }};
{{~ else if field.kind == 'record_var_array' ~}}
            public {{ field.field_type }}[] {{ field.prop_name }} => {{ field.field_name }};
{{~ else if field.kind == 'record' ~}}
            public {{ field.field_type }} {{ field.prop_name }} => {{ field.field_name }};
{{~ if field.members_are_arrays ~}}
{{~## One record, and the arrays are its members - so the length belongs to the group all
      the same, because the folding requires every member to agree on it. ##~}}
            internal const int {{ field.pascal_name }}_N = {{ field.element_count }};
{{~ end ~}}
{{~ else if field.kind == 'array_ref' || field.kind == 'array' ~}}
            public {{ field.field_type }}[] {{ field.prop_name }} => {{ field.field_name }};
{{~ else if field.kind == 'var_array' ~}}
            public {{ field.field_type }}[] {{ field.prop_name }} => {{ field.field_name }};
{{~ else ~}}
            public {{ field.field_type }} {{ field.prop_name }} => {{ field.field_name }};
{{~ end ~}}
{{~ if field.is_nullable ~}}
{{~## The value accessor keeps its type and reads the type's empty value when the row had
      none; this says which it was. One shape for every type, which `T?` is not - a
      nullable reference needs a nullable context the generated C# 8 does not have. ##~}}
            /// <summary>Whether this row has a value for <see cref="{{ field.prop_name }}"/>.</summary>
            public bool Has{{ field.pascal_name }} => {{ field.presence_field }};
{{~ end ~}}
{{~ if field.has_optional_elements ~}}
{{~## The same answer one level in. `true` where the row never got a bitmap - a column the
      file does not carry leaves the array empty, and an index into it is out of range
      whatever this said. ##~}}
            /// <summary>Whether element <paramref name="index"/> of <see cref="{{ field.prop_name }}"/> has a value.</summary>
            public bool Has{{ field.pascal_name }}At(int index)
                => {{ field.element_presence_field }} == null
                    || index < 0 || index >= {{ field.element_presence_field }}.Length
                    || {{ field.element_presence_field }}[index];
{{~ end ~}}
{{~ end ~}}
{{~## A column whose value is a row of one of several tables. The key above is the value;
      these say which table it is in and hand back that table's row.

      One slot behind them all rather than one per target: the tables take separate id
      bands, so at most one target ever answers and the rest would be permanently null.
      The cast is safe by construction - the discriminator was set by the same assignment
      that filled the slot. spec/multi-target-accessors.md. ##~}}
{{~ for ref in table.multi_reference_fields }}
            /// <summary>Which table <see cref="{{ ref.key_property }}"/> is a row of.</summary>
            public {{ ref.target_type_name }} {{ ref.target_property }} => {{ ref.target_field }};
{{~ for target in ref.targets ~}}
            /// <summary>
            /// The <c>{{ target.table }}</c> row <see cref="{{ ref.key_property }}"/> names, or null
            /// when it names a row of one of the others.
            /// </summary>
            public {{ target.record_type_name }} {{ target.property }}
                => {{ ref.target_field }} == {{ ref.target_type_name }}.{{ target.label }}
                    ? ({{ target.record_type_name }}){{ ref.slot_field }}
                    : null;
{{~ end ~}}
{{~ end ~}}
            #endregion
{{~## The element type of each record group. A struct, so an array of them needs no
      per-element allocation and `array[j].Member = x` is a legal assignment - which is
      exactly what a member column's read does. See spec/nested-fields.md. ##~}}
{{~ for field in table.fields ~}}
{{~ if field.kind == 'array_of_arrays' }}
{{~## Both levels allocated with the row: each column fills one element of the outer array,
      so nothing else can create it - and the number the columns agree on is part of the
      generated shape rather than something one of them states. spec/nested-multi-level.md. ##~}}
            private static {{ field.field_type }}[] New{{ field.pascal_name }}()
            {
                var result = new {{ field.element_type_name }}[{{ field.pascal_name }}_N][];
                for (int i = 0; i < result.Length; i++)
                {
                    result[i] = new {{ field.element_type_name }}[{{ field.pascal_name }}_M];
{{~ if field.element_initializer != '' ~}}
                    for (int k = 0; k < result[i].Length; k++)
                        result[i][k]{{ field.element_initializer }};
{{~ end ~}}
                }
                return result;
            }
{{~ else if field.is_record }}
{{~## One struct per level, innermost first - the view flattened the nesting so this loop
      does not have to know how deep it went. The last entry is the group's own element type.
      spec/nested-multi-level.md. ##~}}
{{~ for rt in field.record_types ~}}
{{~ if rt.is_outermost ~}}
            /// <summary>One element of <see cref="{{ field.prop_name }}"/>.</summary>
{{~ else ~}}
            /// <summary>A record inside <see cref="{{ field.prop_name }}"/>.</summary>
{{~ end ~}}
            [System.Serializable]
            public struct {{ rt.type_name }}
            {
{{~## No field initializers: those are C# 10 in a struct and need an explicit
      parameterless constructor, and this has to compile as the C# 8 Unity 2020.3
      accepts. The factory below fills the strings instead. ##~}}
{{~ for member in rt.members ~}}
{{~ for line in member.comment ~}}
                /// {{ line }}
{{~ end ~}}
                public {{ member.field_type }} {{ member.prop_name }};
{{~ if member.ref_table != '' ~}}
{{~## A reference member carries three things: the row it resolved to, the key that came
   off the wire, and whether the resolution happened. All three inside the element, because
   a group may hold more than one reference - and all three at the member's own arity. ##~}}
                public {{ member.ref_key_type_name }} {{ member.prop_name }}_index;
                public {{ member.ref_flag_type_name }} {{ member.prop_name }}_F;
{{~ end ~}}
{{~ end ~}}

                public override string ToString()
                {
                    var sb = new StringBuilder("{");
{{~ for member in rt.members ~}}
{{~ if member.is_first ~}}
                    sb.Append("\"{{ member.prop_name }}\":"); ToStringHelper.ToString({{ member.prop_name }}, sb);
{{~ else ~}}
                    sb.Append(",\"{{ member.prop_name }}\":"); ToStringHelper.ToString({{ member.prop_name }}, sb);
{{~ end ~}}
{{~ end ~}}
                    sb.Append("}");
                    return sb.ToString();
                }
            }
{{~## A level below always gets the one-value factory. The outermost one is further down,
      because whether it takes a length depends on the group's kind. ##~}}
{{~ if !rt.is_outermost && rt.needs_init }}
            private static {{ rt.type_name }} New{{ rt.type_name }}()
            {
                var result = default({{ rt.type_name }});
{{~ for member in rt.members ~}}
{{~ if member.initializer != '' ~}}
                result.{{ member.prop_name }}{{ member.initializer }};
{{~ end ~}}
{{~ if member.element_initializer != '' ~}}
                for (int k = 0; k < result.{{ member.prop_name }}.Length; k++)
                    result.{{ member.prop_name }}[k]{{ member.element_initializer }};
{{~ end ~}}
{{~ if member.ref_key_initializer != '' ~}}
{{~## A reference member that is an array holds one key and one flag per element, and they
      are allocated with the member for the same reason it is. ##~}}
                result.{{ member.prop_name }}_index{{ member.ref_key_initializer }};
                result.{{ member.prop_name }}_F{{ member.ref_flag_initializer }};
{{~ end ~}}
{{~ end ~}}
                return result;
            }
{{~ end ~}}
{{~ end ~}}
{{~ if field.needs_element_init }}
{{~## A string member of a record starts empty rather than null, the same guarantee every
      other string member of a generated record has. It matters when a file predates the
      member: no column, so nothing writes the field, and null is a crash one field later.
      A struct cannot say so itself, so this does. ##~}}
{{~ if field.kind == 'record_array' || field.kind == 'record_var_array' ~}}
{{~## Takes the length, because a trimmed group's is this row's rather than the sheet's
      column count - and the fixed kind passes its constant. ##~}}
{{~## Internal, not private: a trimmed group's read calls this from the table class, which is
      outside `Record`. Private compiled for as long as no fixture had a trimmed record with a
      member that needed initializing - the only case that reaches this from out there. ##~}}
            internal static {{ field.record_type_name }}[] New{{ field.record_type_name }}Array(int length)
            {
                var result = new {{ field.record_type_name }}[length];
                for (int i = 0; i < result.Length; i++)
                {
{{~ for member in field.members ~}}
{{~ if member.initializer != '' ~}}
                    result[i].{{ member.prop_name }}{{ member.initializer }};
{{~ end ~}}
{{~ end ~}}
                }
                return result;
            }
{{~ else ~}}
            private static {{ field.record_type_name }} New{{ field.record_type_name }}()
            {
                var result = default({{ field.record_type_name }});
{{~ for member in field.members ~}}
{{~ if member.initializer != '' ~}}
                result.{{ member.prop_name }}{{ member.initializer }};
{{~ end ~}}
{{~ if member.element_initializer != '' ~}}
{{~## An array of strings: allocating it leaves nulls, and the guarantee is the same one
      a scalar string member gets - empty rather than null when nothing wrote it. ##~}}
                for (int k = 0; k < result.{{ member.prop_name }}.Length; k++)
                    result.{{ member.prop_name }}[k]{{ member.element_initializer }};
{{~ end ~}}
{{~ if member.ref_key_initializer != '' ~}}
{{~## A reference member that is an array holds one key and one flag per element, and they
      are allocated with the member for the same reason it is. ##~}}
                result.{{ member.prop_name }}_index{{ member.ref_key_initializer }};
                result.{{ member.prop_name }}_F{{ member.ref_flag_initializer }};
{{~ end ~}}
{{~ end ~}}
                return result;
            }
{{~ end ~}}
{{~ end ~}}
{{~ end ~}}
{{~ end ~}}
{{~ if table.reference_fields | array.size > 0 }}
            #region Reference wiring
{{~## Called by the accessor once every table is read, and by nothing else. Kept
      away from the values above because a consumer never calls one. ##~}}
{{~ for field in table.reference_fields ~}}
{{~ if field.kind == 'array_ref' ~}}
            public void SetReference_{{ field.pascal_name }}_INTERNAL(int index, {{ field.reference_setter_type }} value) => {{ field.field_name }}[index] = value;
{{~ else ~}}
            public void SetReference_{{ field.pascal_name }}_INTERNAL({{ field.reference_setter_type }} value) => {{ field.field_name }} = value;
{{~ end ~}}
{{~ end ~}}
            #endregion
{{~ end ~}}
{{~ if table.multi_reference_fields | array.size > 0 }}
            #region Multi-target reference wiring
{{~## The row and which table it came from arrive together, because either without the
      other is a state the properties above would read wrongly. ##~}}
{{~ for ref in table.multi_reference_fields ~}}
            public void SetReference_{{ ref.pascal_name }}_INTERNAL({{ ref.target_type_name }} target, object row)
            {
                {{ ref.target_field }} = target;
                {{ ref.slot_field }} = row;
            }
{{~ end ~}}
            #endregion
{{~ end ~}}

            #region Storage
{{~## Written by the enclosing table as it reads, and by the accessor as it
      resolves references - hence `internal` and `public` rather than `private`. ##~}}
{{~ for field in table.fields ~}}
{{~ if field.kind == 'array_of_arrays' ~}}
            internal {{ field.field_type }}[] {{ field.field_name }} = New{{ field.pascal_name }}();
{{~ else if field.kind == 'record_array' ~}}
{{~## Allocated with the record, not by the read. Each member column fills one field of each
      element, so allocating per column would discard what the previous one wrote - which is
      also why this length is the group's rather than a column's. ##~}}
{{~ if field.needs_element_init ~}}
            internal {{ field.field_type }}[] {{ field.field_name }} = New{{ field.record_type_name }}Array({{ field.pascal_name }}_N);
{{~ else ~}}
            internal {{ field.field_type }}[] {{ field.field_name }} = new {{ field.field_type }}[{{ field.pascal_name }}_N];
{{~ end ~}}
{{~ else if field.kind == 'record_var_array' ~}}
{{~## Empty, not sized: the read allocates once it knows this row's length. Empty rather
      than null so a file that does not carry the column leaves something indexable. ##~}}
            internal {{ field.field_type }}[] {{ field.field_name }} = System.Array.Empty<{{ field.field_type }}>();
{{~ else if field.kind == 'record' ~}}
{{~ if field.needs_element_init ~}}
            internal {{ field.field_type }} {{ field.field_name }} = New{{ field.record_type_name }}();
{{~ else ~}}
            internal {{ field.field_type }} {{ field.field_name }};
{{~ end ~}}
{{~ else if field.kind == 'array_ref' ~}}
            internal {{ field.field_type }}[] {{ field.field_name }} = System.Array.Empty<{{ field.field_type }}>();
            public {{ field.ref_key_type_name }}[] {{ field.field_name }}_{{ field.ref_table }}_index = System.Array.Empty<{{ field.ref_key_type_name }}>();
            public bool[] {{ field.field_name }}_F = System.Array.Empty<bool>();
{{~ else if field.kind == 'var_array' || field.kind == 'array' ~}}
            internal {{ field.field_type }}[] {{ field.field_name }} = System.Array.Empty<{{ field.field_type }}>();
{{~ else if field.kind == 'scalar_ref' ~}}
            internal {{ field.field_type }} {{ field.field_name }};
            public {{ field.ref_key_type_name }} {{ field.field_name }}_{{ field.ref_table }}_index;
            public bool {{ field.field_name }}_F = false;
{{~ else ~}}
            internal {{ field.field_type }} {{ field.field_name }}{{ field.initializer }};
{{~ end ~}}
{{~ if field.is_nullable ~}}
{{~## False until the read says otherwise, so a file that does not carry the column leaves
      the member absent rather than claiming a value it never got. ##~}}
            internal bool {{ field.presence_field }};
{{~ end ~}}
{{~ if field.has_optional_elements ~}}
            internal bool[] {{ field.element_presence_field }};
{{~ end ~}}
{{~ end ~}}
{{~## One slot for the resolved row whatever table it came from, and the discriminator that
      says which. `object` because the tables have no common type and inventing one would be
      a sum type in every language; the cast back out lives in the property above, where the
      discriminator has already answered. spec/multi-target-accessors.md. ##~}}
{{~ for ref in table.multi_reference_fields ~}}
            internal object {{ ref.slot_field }};
            internal {{ ref.target_type_name }} {{ ref.target_field }};
{{~ end ~}}
            #endregion

            #region ToString
            public override string ToString()
            {
                var sb = new StringBuilder("{");
{{~ for field in table.fields ~}}
{{~ if for.first ~}}
                sb.Append("\"{{ field.prop_name }}\":"); ToStringHelper.ToString({{ field.prop_name }}, sb);
{{~ else ~}}
                sb.Append(",\"{{ field.prop_name }}\":"); ToStringHelper.ToString({{ field.prop_name }}, sb);
{{~ end ~}}
{{~ end ~}}
                sb.Append("}");
                return sb.ToString();
            }
            #endregion
        }
        #endregion

        /// <summary>
        /// Field names.
        /// </summary>
        public static readonly string[] FieldNames = { {{ table.field_name_literals }} };

        /// <summary>
        /// Build object value map.
        /// </summary>
        public List<object[]> BuildObjectValueMap()
        {
            var result = new List<object[]>();
            foreach (var r in _records)
                result.Add(new object[] { {{ table.field_value_expressions }} });

            return result;
        }

        /// <summary>
        /// All records.
        /// </summary>
        /// <remarks>
        /// The list a read publishes, not one a read fills. Whoever holds this reference holds
        /// the rows as they were when they took it, and a refresh underneath them replaces the
        /// reference rather than the contents - so an iteration in progress neither tears nor
        /// throws, and a read that fails leaves the previous rows exactly where they were.
        /// </remarks>
        public List<Record> Records => _records;
        private List<Record> _records = new List<Record>();
{{~ for field in table.indexed_fields }}
        #region Indexing by '{{ field.prop_name }}'
        public Dictionary<{{ field.field_type }}, Record> RecordsBy{{ field.pascal_name }} => _recordsBy{{ field.pascal_name }};
        private Dictionary<{{ field.field_type }}, Record> _recordsBy{{ field.pascal_name }} = new Dictionary<{{ field.field_type }}, Record>();

        /// <summary>
        /// The row with this `{{ field.prop_name }}`, or null when the table has none.
        /// </summary>
        /// <remarks>
        /// The lookup to reach for when a missing row is an ordinary answer - an optional
        /// reference, a key that came from user input. Every language Tabbit generates has
        /// this one under the same name.
        /// </remarks>
        public Record FindBy{{ field.pascal_name }}({{ field.field_type }} key)
            => _recordsBy{{ field.pascal_name }}.TryGetValue(key, out Record record) ? record : null;

        /// <summary>
        /// The row with this `{{ field.prop_name }}`, or a thrown exception naming what was
        /// missing.
        /// </summary>
        /// <remarks>
        /// For a key that has to be there - one from another table, or a constant. The name
        /// says it throws, because a caller reading `GetBy{{ field.pascal_name }}(id).Name` at
        /// a glance cannot otherwise tell whether the next line is a null check or a catch.
        /// </remarks>
        public Record GetBy{{ field.pascal_name }}OrThrow({{ field.field_type }} key)
        {
            if (!_recordsBy{{ field.pascal_name }}.TryGetValue(key, out Record record))
                throw new TabbitException($"There is no record in table `{{ table.raw_name }}` that corresponds to field `{{ field.prop_name }}` value {key}");

            return record;
        }

        /// <summary>Whether the table holds a row with this `{{ field.prop_name }}`.</summary>
        public bool Contains{{ field.pascal_name }}({{ field.field_type }} key) => _recordsBy{{ field.pascal_name }}.ContainsKey(key);
        #endregion // Indexing by `{{ field.prop_name }}`
{{~ end ~}}

        /// <summary>
        /// Read a table from specified file.
        /// </summary>
        public async Task ReadAsync(string filename)
        {
            var bytes = await {{ accessor_name }}.ReadAllBytesAsync(filename);

            // Unconditionally, and with whatever `{{ accessor_name }}.EncryptionKey` and `{{ accessor_name }}.MacKey`
            // hold - which is null unless the project set them. A file that is neither
            // encrypted nor signed comes back from this untouched, so the load path is the
            // same either way and there is no condition here that could be the wrong way
            // round. spec/tcb-mac-and-signature.md.
            var reader = new TcbReader(TcbTable.Open(
                bytes, {{ accessor_name }}.EncryptionKey, {{ accessor_name }}.MacKey, {{ accessor_name }}.VerifyMac));

            await ReadAsync(reader);
        }

        /// <summary>
        /// Read a table from specified reader.
        /// </summary>
        /// <remarks>
        /// Column by column, matched by tag rather than position. A column this build does
        /// not know is skipped by its block length; one it knows but cannot read - the type
        /// changed incompatibly - fails naming the field. Order, names and columns added or
        /// removed on either side are therefore all survivable.
        /// </remarks>
        public Task ReadAsync(TcbReader reader)
        {
            var columns = TcbTable.ReadHeader(reader, out int count);
{{~ if table.needs_enum_temp ~}}
            int tempEnumInt = 0;
{{~ end ~}}
{{~ if table.needs_cursor ~}}
            TcbColumnCursor cursor;
{{~ end ~}}
{{~ if table.needs_presence ~}}
{{~## Declared once for the whole switch, like the cursor: a `case` is not its own scope
      in C#, so a `var` inside two of them collides. ##~}}
            byte[] presence;
{{~ end ~}}
{{~ if table.needs_element_presence ~}}
            byte[] elementPresence;
            int elementAt;
{{~ end ~}}

            // Read into storage of its own and published at the end, which is what makes a
            // refresh atomic: nothing here touches what the table is currently holding, so a
            // file that turns out to be truncated - or a column this build cannot read -
            // leaves the previous rows in place and reports why.
            //
            // Sized once. The row count was checked against what the columns declare before
            // this point, so it is a number the file could actually hold rows for - and a
            // list that grows into twenty thousand rows reallocates fifteen times to get
            // there, copying everything each time.
            var records = new List<Record>(count);

            for (int i = 0; i < count; i++)
                records.Add(new Record());

            foreach (var column in columns)
            {
                int blockEnd = reader.Position + column.ByteLength;

                switch (column.Tag)
                {
{{~## One case per column of the file, not per declared member. They are the same
      thing for every table without a record group, and a record group is one column
      per member - so the switch loops over `table.columns`. ##~}}
{{~ for column in table.columns ~}}
                    case {{ column.tag }}:
                        {{ column.column_check }}
{{~ if column.is_nullable ~}}
{{~## The bitmap sits at the front of the block, so it is read before the values. The
      values themselves are written for every row either way - a row with none carries the
      type's empty value - which is what lets the read shapes below stay as they are. ##~}}
                        presence = TcbTable.ReadPresence(reader, column, count);
{{~ end ~}}
{{~ if column.has_optional_elements ~}}
{{~## Behind the row bitmap and in front of the values, so it is read here and walked with a
      counter that steps once per element of every row - the order the block wrote them in.
      spec/nullable-array-elements.md. ##~}}
                        elementPresence = TcbTable.ReadElementPresence(reader, column);
                        elementAt = 0;
{{~ end ~}}
{{~## Opened here, ahead of every read shape, because an array's elements read through it
      as well: its block states an encoding for them and one for the row lengths, and the
      cursor is what decodes both. After the presence bitmap, which sits in front of the
      block the cursor is about to start reading. ##~}}
{{~ if column.cursor_open != '' ~}}
                        {{ column.cursor_open }}
{{~ end ~}}
{{~ if column.read_kind == 'var_array' ~}}
                        for (int i = 0; i < count; i++)
                        {
                            var record = records[i];
                            int elementCount;
                            {{ column.length_read }}
                            record.{{ column.field_name }} = new {{ column.field_type }}[elementCount];
{{~## The key and the resolved-flag arrays beside the values, at the length this row gave -
      the same three arrays the fixed-length branch allocates from the column count. Left out
      here, so a trimmed array of references wrote its first key past the end of an empty
      array. spec/variable-length-record-arrays.md. ##~}}
{{~ for line in column.parallel_arrays ~}}
                            {{ line }}
{{~ end ~}}
{{~ if column.has_optional_elements ~}}
                            record.{{ column.element_presence_field }} = new bool[elementCount];
{{~ end ~}}
                            for (int j = 0; j < elementCount; ++j)
                            {
{{~ if column.has_optional_elements ~}}
                                record.{{ column.element_presence_field }}[j] =
                                    TcbTable.IsPresent(elementPresence, elementAt++);
{{~ end ~}}
{{~ for line in column.element_read ~}}
                                {{ line }}
{{~ end ~}}
                            }
                        }
{{~ else if column.read_kind == 'serial' ~}}
{{~## `column.Count` rather than a constant: the file states how many elements the block
      holds for each row, so a sheet that grew a column is read rather than refused.
      spec/nullable-array-elements.md. ##~}}
                        for (int i = 0; i < count; i++)
                        {
                            var record = records[i];
                            record.{{ column.field_name }} = new {{ column.field_type }}[column.Count];
{{~ for line in column.parallel_arrays ~}}
                            {{ line }}
{{~ end ~}}
{{~ if column.has_optional_elements ~}}
                            record.{{ column.element_presence_field }} = new bool[column.Count];
{{~ end ~}}
                            for (int j = 0; j < column.Count; ++j)
                            {
{{~ if column.has_optional_elements ~}}
                                record.{{ column.element_presence_field }}[j] =
                                    TcbTable.IsPresent(elementPresence, elementAt++);
{{~ end ~}}
{{~ for line in column.element_read ~}}
                                {{ line }}
{{~ end ~}}
                            }
                        }
{{~ else if column.read_kind == 'record_var' ~}}
{{~## A trimmed record array: the length is written per row, once per member, and every
      member of the group carries the same one. The first member allocates; the rest check,
      because allocating again would discard what the members before them wrote, and taking
      the shorter of two lengths would shift every value after it. ##~}}
                        for (int i = 0; i < count; i++)
                        {
                            var record = records[i];
                            int elementCount;
                            {{ column.length_read }}
{{~ if column.is_first_member ~}}
{{~ if column.record_needs_init ~}}
                            record.{{ column.field_name }} = Record.New{{ column.record_type_name }}Array(elementCount);
{{~ else ~}}
                            record.{{ column.field_name }} = new Record.{{ column.record_type_name }}[elementCount];
{{~ end ~}}
{{~ else ~}}
                            if (record.{{ column.field_name }}.Length != elementCount)
                            {
{{~## TcbException, not TabbitException: this says the file is malformed, which is what
      every other shape check in the read path throws. ##~}}
                                throw new TcbException(
                                    "{{ table.name }}.{{ column.prop_name }}: the file gives this row "
                                    + elementCount + " elements for one member of the record and "
                                    + record.{{ column.field_name }}.Length + " for another. Every member of a "
                                    + "record carries the same element count, so the file is damaged.");
                            }
{{~ end ~}}
                            for (int j = 0; j < elementCount; ++j)
                            {
{{~ for line in column.element_read ~}}
                                {{ line }}
{{~ end ~}}
                            }
                        }
{{~ else if column.read_kind == 'array_of_arrays_member' ~}}
{{~## One inner array of an array of arrays. The outer index is fixed for this column - it is
      which column this is - and the loop runs over the inner length, which is a different
      number from the outer one. spec/nested-multi-level.md. ##~}}
                        for (int i = 0; i < count; i++)
                        {
                            var record = records[i];
                            for (int j = 0; j < Record.{{ column.pascal_name }}_M; ++j)
                            {
{{~ for line in column.element_read ~}}
                                {{ line }}
{{~ end ~}}
                            }
                        }
{{~ else if column.read_kind == 'record_serial' ~}}
{{~## One member of a record group. No allocation: the array came with the record, and
      re-creating it here would discard the members read before this one - which is also why
      its length is the group's rather than this column's. Several columns fill one array, so
      what they agree on is part of the generated shape. ##~}}
                        for (int i = 0; i < count; i++)
                        {
                            var record = records[i];
                            for (int j = 0; j < Record.{{ column.pascal_name }}_N; ++j)
                            {
{{~ for line in column.element_read ~}}
                                {{ line }}
{{~ end ~}}
                            }
                        }
{{~ else if column.run_call != '' ~}}
                        for (int i = 0; i < count; )
                        {
                            // One call per run of equal values, not one per row - over a
                            // run-length encoded column this is most of the decode.
                            int n = cursor.{{ column.run_call }}(count - i, out var value);
                            do
                            {
                                var record = records[i++];
{{~ for line in column.run_read ~}}
                                {{ line }}
{{~ end ~}}
                            } while (--n > 0);
                        }
{{~ else ~}}
                        for (int i = 0; i < count; i++)
                        {
                            var record = records[i];
{{~ for line in column.element_read ~}}
                            {{ line }}
{{~ end ~}}
                        }
{{~ end ~}}
{{~ if column.is_nullable ~}}
{{~## A pass of its own rather than a line inside each read shape. There are five of those
      and one of them steps `i` itself while walking a run, so folding presence in would
      mean getting the row index right five times instead of once. ##~}}
                        for (int i = 0; i < count; i++)
                        {
                            records[i].{{ column.presence_field }} = TcbTable.IsPresent(presence, i);

                            // The block carries a value for every row, so an absent one has
                            // just been given whatever was there. Putting the empty value
                            // back is what makes this path agree with the JSON one.
                            if (!records[i].{{ column.presence_field }})
                                records[i].{{ column.field_name }} = {{ column.empty_value }};
                        }
{{~ end ~}}
                        break;

{{~ end ~}}
                    default:
                        // A column added after this code was generated. Its block length
                        // says how far to move on.
                        reader.Skip(column.ByteLength);
                        break;
                }

                TcbTable.CheckBlockEnd(reader, column, blockEnd);
            }
{{~ if table.indexed_fields | array.size > 0 }}
            // Index mapping. Sized to the rows, so nothing rehashes on the way in, and a
            // duplicate key throws here - before any of this is visible.
{{~ for field in table.indexed_fields ~}}
            var recordsBy{{ field.pascal_name }} = new Dictionary<{{ field.field_type }}, Record>(count);
            foreach (var record in records)
                recordsBy{{ field.pascal_name }}.Add(record.{{ field.prop_name }}, record);
{{~ end ~}}
{{~ end }}
            // Published. Everything above succeeded, and the barrier is what keeps the writes
            // that built these from being seen after the references to them - a reader on
            // another thread gets the whole table or the previous one, never half of either.
            System.Threading.Thread.MemoryBarrier();

            _records = records;
{{~ for field in table.indexed_fields ~}}
            _recordsBy{{ field.pascal_name }} = recordsBy{{ field.pascal_name }};
{{~ end ~}}

            return Task.CompletedTask;
        }

        public override string ToString()
        {
            var sb = new StringBuilder();
            ToStringHelper.ToString(_records, sb);
            return sb.ToString();
        }
    }
{{ include 'csharp-file-foot.sbn' ~}}
