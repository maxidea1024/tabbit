        private static string KeyOf{{ key.suffix }}({{ key.params }})
        {
            var parts = new string[]
            {
{{~ for c in key.components ~}}
{{~ if c.kind == "string" ~}}
                {{ c.param }},
{{~ else if c.kind == "enum" ~}}
                ((long){{ c.param }}).ToString(System.Globalization.CultureInfo.InvariantCulture),
{{~ else ~}}
                {{ c.param }}.ToString(System.Globalization.CultureInfo.InvariantCulture),
{{~ end ~}}
{{~ end ~}}
            };

            var text = new StringBuilder();

            foreach (var part in parts)
                text.Append(part.Length).Append(':').Append(part);

            return text.ToString();
        }

