{{~## The accessor, holding no table's own code. ##~}}
{{ include 'go-file-head.sbn' ~}}
// {{ accessor_name }} holds every table, loaded together so cross-table references can be resolved.
type {{ accessor_name }} struct {
{{~ for slot in accessor.tables ~}}
	{{ slot.name }} {{ slot.table_name }}
{{~ end ~}}
}

// EncryptionKey is the key the table files were sealed with, or nil when they were not
// sealed.
//
// A package-level variable rather than an argument to every Read, because it is one
// decision the consuming project makes once, at start-up, before the first table is read.
// A key threaded through every read signature would be the same value written out at every
// call site, and every call site is somewhere it could be wrong.
//
// Thirty-two bytes, the key the converter was given. Nil - the default - is a project that
// does not encrypt, and it costs that project nothing: the load path opens the envelope
// either way, and a file that is not encrypted comes back from that unchanged. A project
// that does encrypt and leaves this nil gets the reader's own message saying the file is
// encrypted and no key was given, rather than a failure somewhere inside the format.
//
// Where the key comes from is the one thing about this layer worth being careful with. It
// is a secret only until it reaches a repository, a build log or an issue, and it cannot be
// taken back afterwards - so it is read at start-up from wherever this project keeps
// secrets, not written into a source file. What the layer is for, and therefore what is and
// is not worth defending, is spec/tcb-v104-composed-encodings.md section 4.
var EncryptionKey []byte

// MacKey is the key the table files were signed with, or nil when they were not signed.
//
// A different key from EncryptionKey and independent of it: a file can be signed without
// being encrypted, and encrypted without being signed.
//
// What it buys is the thing encryption does not. The cipher is a keystream XOR, so a bit
// flipped in the file is a bit flipped in the value it decrypts to - no key needed - and
// every structural check the format makes still passes, because a four-byte float accepts
// any four bytes. With this set, a file altered after export stops loading instead.
//
// Setting it makes the reader stricter in a second way: a file that carries no MAC is
// refused, because otherwise the check could be removed by zeroing sixteen bytes. So the
// order to turn this on in is data first, key second. spec/tcb-mac-and-signature.md.
var MacKey []byte

// VerifyMac says whether to check the MAC at all. True by default.
//
// For tools that read exported files without the key, and for measuring what the check
// costs at load. It is not a security boundary - anyone who can flip a flag in a shipped
// binary can read MacKey out of the same binary.
var VerifyMac = true

// ReadAll reads every table from basePath, then links the references between them.
//
// The data files are expected to carry the extension the recipe told the exporter to write.
// Use ReadAllWithExtension to name a different one.
func (t *{{ accessor_name }}) ReadAll(basePath string) error {
	return t.ReadAllWithExtension(basePath, "{{ accessor.file_extension }}")
}

// ReadAllWithExtension is ReadAll for data files that carry some other extension.
//
// Safe to call on a loaded {{ accessor_name }}. Every file is read into a set of its own and the
// references are linked among those, so nothing here is visible until all of it is: a
// failure part way through leaves the tables holding the load they already had.
func (t *{{ accessor_name }}) ReadAllWithExtension(basePath string, fileExtension string) error {
{{~ if accessor.tables | array.size == 0 ~}}
	_ = basePath
	_ = fileExtension
{{~ else ~}}
	var loaded {{ accessor_name }}

{{~ for slot in accessor.tables ~}}
	if err := loaded.{{ slot.name }}.Read(filepath.Join(basePath, "{{ slot.data_file_name }}"+fileExtension)); err != nil {
		return err
	}
{{~ end ~}}

	loaded.solveCrossReferences()

	*t = loaded
{{~ end ~}}

	return nil
}

// solveCrossReferences turns the stored indices into usable values, once every table is
// in memory.
func (t *{{ accessor_name }}) solveCrossReferences() {
{{~ if accessor.cross_references | array.size == 0 ~}}
	// No table references another.
{{~ else ~}}
{{~ for reference in accessor.cross_references ~}}
	for i := range t.{{ reference.table }}.records {
		record := &t.{{ reference.table }}.records[i]
{{~ for field in reference.fields ~}}
{{~ if field.is_array ~}}
		for k := range record.{{ field.name }}Index {
			if target := t.{{ field.ref_table }}.{{ field.ref_lookup }}(record.{{ field.name }}Index[k]); target != nil {
				record.{{ field.name }}[k] = {{ field.value }}
			}
		}
{{~ else ~}}
		if target := t.{{ field.ref_table }}.{{ field.ref_lookup }}(record.{{ field.name }}Index); target != nil {
			record.{{ field.name }} = {{ field.value }}
		}
{{~ end ~}}
{{~ end ~}}
{{~## A reference that is a member of a record resolves inside the element, so the slice is
   walked and each element's own key is looked up. Which slice that is - the group's or the
   member's - the view decided, and a record of one has neither.
   spec/references-in-records.md. ##~}}
{{~ for member in reference.record_fields ~}}
{{~ if member.range != '' ~}}
		for k := range {{ member.range }} {
			if target := t.{{ member.ref_table }}.{{ member.ref_lookup }}({{ member.key }}); target != nil {
				{{ member.access }} = target
			}
		}
{{~ else ~}}
		if target := t.{{ member.ref_table }}.{{ member.ref_lookup }}({{ member.key }}); target != nil {
			{{ member.access }} = target
		}
{{~ end ~}}
{{~ end ~}}
{{~## A column reaching several tables is looked up in each of them in the order they were
   named, stopping at the first that has the key. The tables take separate id bands - an id in
   two of them is refused at conversion - so the order only decides which lookup runs.

   Guarded on the key being set, which the single-target linking above does not do. It has to
   be: the discriminator this produces is a value a consumer reads, so a language that resolved
   a zero where another did not would answer a different table for the same row.
   spec/multi-target-accessors.md. ##~}}
{{~## A column reaching several tables that is a member of a record resolves inside the element,
   so the elements are walked and each one's own key is looked up. Which slice that is - the
   group's or the member's - the view decided, and a record of one has neither.
   spec/multi-target-accessors.md ~ spec/references-in-records.md. ##~}}
	}
{{~ end ~}}
{{~ end ~}}
}
