{{~##
   One abstract type and its variants, as an enum. `structure` is the single declaration this
   module is for.

   **An `enum`, which is this language's sum type - and the shape §7 named for it outright.** A
   `match` over it that misses a variant does not compile, so a variant added to the declaration
   is a compile error at every consumer rather than a silent arm.

   The base fields sit on the enum as one method rather than being repeated in every payload, so
   a consumer holding the enum reads them without matching. The read path is untouched: the file
   is still read into the table's flat entry and the value is built from it.
   spec/polymorphism.md section 7.
##~}}
{{ include 'rust-file-head.sbn' ~}}
/// One value of `{{ structure.name }}`, whichever shape it took.
///
/// Narrow it with `match`, which is exhaustive over an enum.
#[derive(Debug, Clone, PartialEq)]
pub enum {{ structure.name }} {
{{~ for variant in structure.variants ~}}
    /// One shape of `{{ structure.name }}`.
    ///
    /// The file carries `{{ variant.discriminator }}` for it. That number rather than the name
    /// is what lets this variant be renamed without a deployed reader reading a different one.
    {{ variant.type_name }}({{ variant.type_name }}),
{{~ end ~}}
}

impl {{ structure.name }} {
{{~ for member in structure.base_members ~}}
{{~ for line in member.comment ~}}
    /// {{ line }}
{{~ end ~}}
    pub fn {{ member.name }}(&self) -> &{{ member.type_name }} {
        match self {
{{~ for variant in structure.variants ~}}
            {{ structure.name }}::{{ variant.type_name }}(it) => &it.{{ member.name }},
{{~ end ~}}
        }
    }
{{~ end ~}}
}
{{~ for variant in structure.variants ~}}

/// The payload of [`{{ structure.name }}::{{ variant.type_name }}`].
#[derive(Debug, Clone, PartialEq, Default)]
pub struct {{ variant.type_name }} {
{{~ for member in structure.base_members ~}}
{{~ for line in member.comment ~}}
    /// {{ line }}
{{~ end ~}}
{{~ if member.row_name != '' ~}}
{{~## A reference member is two of these: the key the cell held under its own name, and the row
   it resolved to under the derived one. spec/reference-surface-naming.md 4 and 5. ##~}}
    pub {{ member.name }}: {{ member.key_type_name }},
    pub {{ member.row_name }}: {{ member.type_name }},
{{~ else ~}}
    pub {{ member.name }}: {{ member.type_name }},
{{~ end ~}}
{{~ end ~}}
{{~ for member in variant.members ~}}
{{~ for line in member.comment ~}}
    /// {{ line }}
{{~ end ~}}
{{~ if member.row_name != '' ~}}
{{~## A reference member is two of these: the key the cell held under its own name, and the row
   it resolved to under the derived one. spec/reference-surface-naming.md 4 and 5. ##~}}
    pub {{ member.name }}: {{ member.key_type_name }},
    pub {{ member.row_name }}: {{ member.type_name }},
{{~ else ~}}
    pub {{ member.name }}: {{ member.type_name }},
{{~ end ~}}
{{~ end ~}}
}
{{~ end ~}}
