{{~## One enum. ##~}}
{{ include 'c-header-head.sbn' ~}}
/* Generated from {{ enumm.location }}
{{~ for line in enumm.comment ~}}
 *
 * {{ line }}
{{~ end ~}}
 */
typedef enum {{ enumm.name }} {
{{~ for label in enumm.labels ~}}
{{~ for line in label.comment ~}}
  /* {{ line }} */
{{~ end ~}}
  {{ label.name }} = {{ label.value }},
{{~ end ~}}
} {{ enumm.name }};
