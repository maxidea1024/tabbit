{{~## One page per enum, named after it in kebab-case. ##~}}
{{~ include 'html-head.sbn' ~}}
<div class="definition">
<h3 id="enum_{{ name }}"><i>Enumeration: {{ source_link }}</i></h3>
{{~ if comment != '' ~}}
<div class="comment">{{ comment }}</div>
{{~ end ~}}
<table>
<thead><th>No</th><th>Name</th><th>Value</th><th>Description</th></thead>
{{~ for label in labels ~}}
<tr>
<td>{{ label.no }}</td>
<td id="const_{{ name }}.{{ label.name }}">{{ label.source_link }}</td>
<td><code>{{ label.value }}</code></td>
<td>{{ label.comment }}</td>
</tr>
{{~ end ~}}
</table>
</div>
<br>
