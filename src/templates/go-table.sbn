type {{ rt.type_name }} struct {
{{~ for member in rt.members ~}}
{{~ for line in member.comment ~}}
	// {{ line }}
{{~ end ~}}
{{~ for line in member.declarations ~}}
	{{ line }}
{{~ end ~}}
{{~ end ~}}
{{~## The second layer of a container's surface. Maps for both - Go has no set - and neither
   has an order of its own, which is what the slice above it is for.
   spec/types/set-and-map.md section 7. ##~}}
{{~ for lookup in rt.lookups ~}}

	// {{ lookup.comment }}
	{{ lookup.name }} {{ lookup.type_name }}
{{~ end ~}}
}
{{~## The per-target methods of every member of this struct that reaches several tables. One
   taking an element number where the member is the array, which is the third place an element
