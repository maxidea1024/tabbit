	{{ field.element_presence_member }} []bool
{{~ end ~}}
{{~ end ~}}
{{~## A column whose value is a row of one of several tables. One slot for the resolved row
   whatever table it came from, and the discriminator saying which - the targets take separate
   id bands, so at most one of them ever answers and a member per target would be permanently
   nil. spec/references/multi-target-accessors.md. ##~}}
}
{{~ for field in table.fields ~}}
{{~ if field.variants.size > 0 }}

{{~## **The interface, built once per call from the flat entry.** Which variant a row is only
   became knowable when the discriminator column arrived, so the entry is read as it always was
   and the value is built from it here - which is why the read path and the wire are untouched.

   A method rather than a field, because the group's own name is what a consumer should write
   and a field already holding the entry cannot share it. spec/types/polymorphism.md section 7.2. ##~}}
{{~ if field.variants_are_array ~}}
// {{ field.name }} is what this row's {{ field.abstract_type_name }}s are, one per element.
//
// Each element carries its own variant - section 5.3 - so the shapes inside one row may
// differ. Narrow each with a type switch.
func (r *{{ table.record_name }}) {{ field.name }}() []{{ field.abstract_type_name }} {
	built := make([]{{ field.abstract_type_name }}, len(r.{{ field.entry_field_name }}))

	for at := range r.{{ field.entry_field_name }} {
		built[at] = r.{{ field.entry_field_name }}Element(&r.{{ field.entry_field_name }}[at])
	}

	return built
}

{{~## A method rather than a package function, and unexported. Two tables may both hold a
   group of this name, and a package function would then be declared twice. ##~}}
// {{ field.entry_field_name }}Element builds one element's value from the entry the read filled.
func (r *{{ table.record_name }}) {{ field.entry_field_name }}Element(
	entry *{{ field.record_type_name }}) {{ field.abstract_type_name }} {
	switch entry.Type {
{{~ else ~}}
// {{ field.name }} is what this row's {{ field.abstract_type_name }} is. Narrow it with a type
// switch: the interface is sealed, so the variants in this package are the whole list.
func (r *{{ table.record_name }}) {{ field.name }}() {{ field.abstract_type_name }} {
	return r.{{ field.entry_field_name }}Element(&r.{{ field.entry_field_name }})
}

{{~## A method rather than a package function, and unexported. Two tables may both hold a
   group of this name, and a package function would then be declared twice. ##~}}
// {{ field.entry_field_name }}Element builds one value from the entry the read filled.
func (r *{{ table.record_name }}) {{ field.entry_field_name }}Element(
	entry *{{ field.record_type_name }}) {{ field.abstract_type_name }} {
	switch entry.Type {
{{~ end ~}}
{{~ for variant in field.variants ~}}
	case {{ variant.discriminator }}:
		return {{ variant.type_name }}{
			{{ field.abstract_base_name }}: {{ field.abstract_base_name }}{
{{~ for member in field.base_members ~}}
{{~ if member.row_name != '' ~}}
				{{ member.field_name }}: {{ field.entry_access }}.{{ member.field_name }},
				{{ member.row_name }}: {{ field.entry_access }}.{{ member.row_name }},
{{~ else ~}}
				{{ member.field_name }}: {{ field.entry_access }}.{{ member.field_name }},
{{~ end ~}}
{{~ end ~}}
			},
{{~ for member in variant.members ~}}
{{~ if member.row_name != '' ~}}
			{{ member.field_name }}: {{ field.entry_access }}.{{ member.field_name }},
			{{ member.row_name }}: {{ field.entry_access }}.{{ member.row_name }},
{{~ else ~}}
			{{ member.field_name }}: {{ field.entry_access }}.{{ member.field_name }},
{{~ end ~}}
{{~ end ~}}
		}
{{~ end ~}}
	}

{{~## An unknown number is a variant this build does not have. Unlike a column added later,
   which the reader skips, that makes the whole row uninterpretable - so it is reported rather
   than read as a neighbour. ##~}}
	panic(fmt.Sprintf(
		"{{ field.abstract_type_name }}: no variant is numbered %d", {{ field.entry_access }}.Type))
}
{{~ end ~}}
{{~ end ~}}

// {{ table.table_name }} holds every row of {{ table.raw_name }}.
type {{ table.table_name }} struct {
	records []{{ table.record_name }}
{{~ for index in table.indexes ~}}
	{{ index.map_name }} map[{{ index.key_type }}]int
{{~ end ~}}
{{~ if table.matrix ~}}
{{~## The axis as a map and a slice rather than a pointer at the column table - the accessor
      is copied into place after loading, and these two survive that where a pointer at one of
      its fields would not. ##~}}
	columnAt map[{{ table.matrix.column_key_type }}]int
	columnKeys []{{ table.matrix.column_key_type }}
{{~ end ~}}
}

// Records returns every row, in the order the sheet declared them.
func (t *{{ table.table_name }}) Records() []{{ table.record_name }} { return t.records }

// Count returns how many rows the table holds.
func (t *{{ table.table_name }}) Count() int { return len(t.records) }
{{~ if range_over_func }}

// All returns the rows, in the order the file wrote them - `for row := range t.All()`.
//
// The slice header is read once, here. A refresh replaces it rather than its contents, so a
// loop already running keeps the rows it started with.
func (t *{{ table.table_name }}) All() iter.Seq[*{{ table.record_name }}] {
	records := t.records

	return func(yield func(*{{ table.record_name }}) bool) {
		for i := range records {
			if !yield(&records[i]) {
				return
			}
		}
	}
}
{{~ end ~}}
{{~ if table.matrix }}
{{~ m = table.matrix ~}}
{{~## The two lookups composed. Both halves already exist - this table indexes its rows by the
   row axis and the column table indexes its own by the column axis - and what this adds is the
   one call that goes through both. spec/layout/matrix-declaration.md section 8. ##~}}
// LinkColumnAxis hands this table the column axis its cells are positioned by.
//
// Called by the accessor once both files are read. The length check is here rather than in
// the read: a grid is two files, either can be deployed without the other, and a row whose
// array is a different length from the axis is a row whose cells have moved.
//
// What is kept is a map from key to position rather than a pointer at the column table. The
// accessor is copied into place after loading, so a pointer at one of its fields would name
// the copy left behind; a map is a reference and survives that.
func (t *{{ table.table_name }}) LinkColumnAxis(columns *{{ m.column_table }}) error {
	at := make(map[{{ m.column_key_type }}]int, columns.Count())
	keys := make([]{{ m.column_key_type }}, columns.Count())

	for i := range columns.Records() {
{{~## The position travels as the column's own integer type; a subscript is an `int`. ##~}}
		key := columns.Records()[i].{{ m.column_key_member }}
		position := int(columns.Records()[i].{{ m.at_member }})

		at[key] = position
		keys[position] = key
	}

	for i := range t.records {
		if len(t.records[i].{{ m.grid_member }}) != len(keys) {
			return fmt.Errorf(
				"table `{{ table.raw_name }}` holds %d cells for `%v` and its column axis `{{ m.column_table_name }}` holds %d keys; the two files are from different builds",
				len(t.records[i].{{ m.grid_member }}), t.records[i].{{ m.row_key_member }}, len(keys))
		}
	}

	t.columnAt = at
	t.columnKeys = keys

	return nil
}

// RowKeys returns the row axis keys, in the order the file wrote them.
func (t *{{ table.table_name }}) RowKeys() []{{ m.row_key_type }} {
	keys := make([]{{ m.row_key_type }}, len(t.records))

	for i := range t.records {
		keys[i] = t.records[i].{{ m.row_key_member }}
	}

	return keys
}

// ColKeys returns the column axis keys, in the order a row holds its cells.
func (t *{{ table.table_name }}) ColKeys() []{{ m.column_key_type }} { return t.columnKeys }

// Row returns one row of cells, or nil when the grid has no such row.
//
// In the order ColKeys is in, which is what makes a position mean something. The slice is the
// record's own, so it is not a copy.
func (t *{{ table.table_name }}) Row({{ m.row_key_param }} {{ m.row_key_type }}) []{{ m.cell_type }} {
	record := t.{{ m.row_lookup }}({{ m.row_key_param }})
	if record == nil {
		return nil
	}

	return record.{{ m.grid_member }}
}

// At returns the cell where the two keys meet, or an error naming the one that missed.
//
// It errors rather than answering with the type's zero value, because a grid's zero is one
// the sheet can write - 0 in a modifier table is a modifier of zero.
func (t *{{ table.table_name }}) At({{ m.row_key_param }} {{ m.row_key_type }}, {{ m.column_key_param }} {{ m.column_key_type }}) ({{ m.cell_type }}, error) {
	record, at, err := t.cellAt({{ m.row_key_param }}, {{ m.column_key_param }})
	if err != nil {
		var none {{ m.cell_type }}
		return none, err
	}

	return record.{{ m.grid_member }}[at], nil
}
{{~ if m.cells_are_optional }}

// HasAt reports whether the sheet gave the cell where the two keys meet a value.
//
// A grid whose cells are optional reads a blank as the type's zero value, and that value is
// one the sheet could also have written - so this is the only way to tell them apart.
func (t *{{ table.table_name }}) HasAt({{ m.row_key_param }} {{ m.row_key_type }}, {{ m.column_key_param }} {{ m.column_key_type }}) (bool, error) {
	record, at, err := t.cellAt({{ m.row_key_param }}, {{ m.column_key_param }})
	if err != nil {
		return false, err
	}

{{~## A slice rather than a call: Go holds the per-element answers as a field. ##~}}
	return record.{{ m.grid_has_member }}[at], nil
}
{{~ end }}

// cellAt does both lookups once for the readers above.
func (t *{{ table.table_name }}) cellAt({{ m.row_key_param }} {{ m.row_key_type }}, {{ m.column_key_param }} {{ m.column_key_type }}) (*{{ table.record_name }}, int, error) {
	if t.columnAt == nil {
		return nil, 0, fmt.Errorf(
			"table `{{ table.raw_name }}` has no column axis yet; read `{{ m.column_table_name }}` before reading a cell")
	}

	record := t.{{ m.row_lookup }}({{ m.row_key_param }})
	if record == nil {
		return nil, 0, fmt.Errorf("table `{{ table.raw_name }}` has no row `%v`", {{ m.row_key_param }})
	}

	at, found := t.columnAt[{{ m.column_key_param }}]
	if !found {
		return nil, 0, fmt.Errorf("table `{{ table.raw_name }}` has no column `%v`", {{ m.column_key_param }})
	}

	return record, at, nil
}
{{~ end ~}}
{{~ for index in table.indexes }}
{{~## A composite key is held as the text its columns make. Each part carries its own length,
   so no two combinations can make the same text - "a b" with "c" and "a" with "b c" joined by
   a separator alone would be one key, and a lookup that answers with the wrong row is worse
   than one that fails to compile. spec/layout/primary-layout.md section 3.5. ##~}}
{{~ if index.is_composite ~}}
// keyOf{{ index.suffix }} joins the columns of the {{ index.field_name }} key into the text the map is keyed by.
func (t *{{ table.table_name }}) keyOf{{ index.suffix }}({{ index.params }}) string {
{{~ for c in index.components ~}}
{{~ if c.kind == "string" ~}}
	part{{ for.index }} := {{ c.param }}
{{~ else ~}}
	part{{ for.index }} := strconv.FormatInt(int64({{ c.param }}), 10)
{{~ end ~}}
{{~ end ~}}
	return {{ for c in index.components }}strconv.Itoa(len(part{{ for.index }})) + ":" + part{{ for.index }}{{ if !for.last }} + {{ end }}{{ end }}
}

{{~ end ~}}
// FindBy{{ index.suffix }} returns the row with this {{ index.field_name }}, or nil when the table has none.
//
// The lookup to reach for when a missing row is an ordinary answer - an optional
// reference, a key that came from user input.
func (t *{{ table.table_name }}) FindBy{{ index.suffix }}({{ index.params }}) *{{ table.record_name }} {
	position, found := t.{{ index.map_name }}[{{ index.argument }}]
	if !found {
		return nil
	}

	return &t.records[position]
}

// GetBy{{ index.suffix }}OrError returns the row with this {{ index.field_name }}, or an error naming
// what was missing.
//
// For a key that has to be there - one from another table, or a constant. Go has no
// exception to throw, so where the other languages name a throw this one names the error
// it returns; either way the call site can tell without going to the definition.
func (t *{{ table.table_name }}) GetBy{{ index.suffix }}OrError({{ index.params }}) (*{{ table.record_name }}, error) {
	position, found := t.{{ index.map_name }}[{{ index.argument }}]
	if !found {
		return nil, fmt.Errorf(
			"there is no record in table `{{ table.raw_name }}` that corresponds to field `{{ index.field_name }}` value {{ index.value_format }}", {{ index.value_args }})
	}

	return &t.records[position], nil
}

// Contains{{ index.suffix }} reports whether the table holds a row with this {{ index.field_name }}.
func (t *{{ table.table_name }}) Contains{{ index.suffix }}({{ index.params }}) bool {
	_, found := t.{{ index.map_name }}[{{ index.argument }}]
	return found
}
{{~ if index.is_primary && !index.is_composite && range_over_func }}

// Entries yields each row with the {{ index.field_name }} it is keyed by -
// `for key, row := range t.Entries()`.
//
// What this saves a caller is not the key value - the row carries it - but having to know
// which column the key is: {{ index.field_name }} here, something else in the next table.
//
// The rows come in the order the file wrote them rather than the order a map happens to
// hold them, which makes this and All agree. Only the primary key has this: a table keyed
// by several columns together has no single key value to pair a row with.
func (t *{{ table.table_name }}) Entries() iter.Seq2[{{ index.key_type }}, *{{ table.record_name }}] {
	records := t.records

	return func(yield func({{ index.key_type }}, *{{ table.record_name }}) bool) {
		for i := range records {
			if !yield(records[i].{{ index.member }}, &records[i]) {
				return
			}
		}
	}
}
{{~ end ~}}
{{~ end ~}}

// Read loads the table from a .tcb file written by Tabbit.
func (t *{{ table.table_name }}) Read(filename string) error {
	data, err := tabbit.ReadAllBytes(filename)
	if err != nil {
		return err
	}

	// Unconditionally, and with whatever EncryptionKey and MacKey hold - which is nil
	// unless the project set them. A file that is neither encrypted nor signed comes back
	// from this untouched, so the load path is the same either way and there is no
	// condition here that could be the wrong way round. spec/wire/tcb-mac-and-signature.md.
	//
	// What comes back is a window onto data rather than a copy of it, which is why data
	// stays in scope for the whole read.
	opened, err := tabbit.Open(data, EncryptionKey, MacKey, VerifyMac)
	if err != nil {
		return err
	}

	reader := tabbit.NewReader(opened)
	count, columns := tabbit.ReadTableHeader(reader)

	// Column by column, matched by tag rather than position: a column this build does
	// not know is skipped by its block length, and one whose type changed incompatibly
	// fails naming the field.
	//
	// Read into rows of its own and assigned at the end. Reading a table that is already
	// loaded is a refresh, and a refresh that turns out to be unreadable has to leave what
	// the table holds alone - the previous rows and an error, not an empty table.
	records := make([]{{ table.record_name }}, count)
{{~ if table.needs_record_init }}
	// Made with the row rather than by whichever member column arrives first: a Go struct
	// has no field initializer, so otherwise the slice would stay nil until that member
	// was read - and a file that no longer carries it would leave nothing behind at all.
	// Empty rather than the sheet's column count, because the length is the file's since
	// v107 and a number from here would be one the data need not agree with.
	for i := int32(0); i < count; i++ {
{{~ for field in table.fields ~}}
{{~ if field.is_fixed_record_array ~}}
		records[i].{{ field.name }} = make({{ field.array_type }}, 0)
{{~ else if field.members_are_anonymous ~}}
{{~## An array of arrays: both levels made with the row, for the same reason. ##~}}
		records[i].{{ field.name }} = make([][]{{ field.element_type_name }}, {{ field.outer_count }})
		for at := range records[i].{{ field.name }} {
			records[i].{{ field.name }}[at] = make([]{{ field.element_type_name }}, 0)
		}
{{~ else if field.members_are_arrays ~}}
{{~## One record, and the slices are its members - so each of them is made here for the
   same reason. ##~}}
{{~ for member in field.members ~}}
{{~ if member.ref_key_slice_type != '' ~}}
{{~## A reference member holds one key per element as well as one row, and the read writes
   into the key - so both are made. The member's own name is the key's.
   spec/references/reference-surface-naming.md section 4. ##~}}
		records[i].{{ field.name }}.{{ member.name }} = make({{ member.ref_key_slice_type }}, 0)
		records[i].{{ field.name }}.{{ member.row_name }} = make({{ member.slice_type }}, 0)
{{~ else ~}}
		records[i].{{ field.name }}.{{ member.name }} = make({{ member.slice_type }}, 0)
{{~ end ~}}
{{~ end ~}}
{{~ end ~}}
{{~ end ~}}
	}
{{~ end }}
	for _, column := range columns {
		blockEnd := reader.Position() + int(column.ByteLength)

		switch column.Tag {
{{~ for column_view in table.columns ~}}
		case {{ column_view.wire_tag }}:
			if {{ column_view.column_check }} {
{{~ if column_view.is_nullable ~}}
				// The bitmap is at the front of the block, so it is read before the values.
				// The values are written for every row either way, which is what lets the
				// read shapes below stay as they are.
				presence := tabbit.ReadPresence(reader, column, count)
{{~ end ~}}
{{~ if column_view.has_optional_elements ~}}
				// Behind the row bitmap and in front of the values, walked with a counter
				// that steps once per element of every row.
				// spec/types/nullable-array-elements.md.
				elementPresence := tabbit.ReadElementPresence(reader, column)
				elementAt := int32(0)
{{~ end ~}}
{{~## Opened here, ahead of every read shape, because an array's elements read through it
   as well: its block states an encoding for them and one for the row lengths, and the
   cursor is what decodes both. After the presence bitmap, which sits in front of the
   block the cursor is about to start reading. ##~}}
{{~ if column_view.cursor_open != '' ~}}
				{{ column_view.cursor_open }}
{{~ end ~}}
{{~ if column_view.run_call != '' ~}}
{{~## A run of equal values costs one call and then plain assignments, rather than one
   call per row that each re-dispatch on the encoding. An encoding with no run to give
   answers 1, so this loop is correct over all of them. ##~}}
				for i := int32(0); i < count; {
					n, value := cursor.{{ column_view.run_call }}(count - i)
					for ; n > 0; n-- {
						{{ column_view.run_spend }}
						i++
					}
				}
{{~ else ~}}
				for i := int32(0); i < count; i++ {
					r := &records[i]
{{~ if column_view.kind == 'var_array' ~}}
					{{ column_view.length_read }}
					r.{{ column_view.name }} = make({{ column_view.array_type }}, elementCount)
{{~ if column_view.has_optional_elements ~}}
					r.{{ column_view.element_presence_member }} = make([]bool, elementCount)
{{~ end ~}}
					for j := 0; j < elementCount; j++ {
						r.{{ column_view.name }}[j] = {{ column_view.read_value }}
{{~ if column_view.has_optional_elements ~}}
						r.{{ column_view.element_presence_member }}[j] =
							tabbit.IsPresent(elementPresence, elementAt)
						elementAt++
{{~ end ~}}
					}
{{~ else if column_view.kind == 'var_array_ref' ~}}
{{~## A trimmed array of references. Same length as the values - this row's - for the keys
   beside them, which is what `serial_ref` does from the column count.
   spec/types/variable-length-record-arrays.md. ##~}}
					{{ column_view.length_read }}
					r.{{ column_view.row_name }} = make({{ column_view.array_type }}, elementCount)
					r.{{ column_view.name }} = make([]{{ column_view.ref_key_type }}, elementCount)
{{~ if column_view.has_optional_elements ~}}
					r.{{ column_view.element_presence_member }} = make([]bool, elementCount)
{{~ end ~}}
					for j := 0; j < elementCount; j++ {
						r.{{ column_view.name }}[j] = {{ column_view.read_value }}
{{~ if column_view.has_optional_elements ~}}
						r.{{ column_view.element_presence_member }}[j] =
							tabbit.IsPresent(elementPresence, elementAt)
						elementAt++
{{~ end ~}}
					}
{{~ else if column_view.kind == 'record_var' ~}}
					{{ column_view.length_read }}
{{~ if column_view.is_first_member ~}}
					// The first member allocates; the rest check. Allocating again would
					// discard what the members before it wrote, and taking the shorter of
					// two counts would shift every value after it.
					r.{{ column_view.name }} = make({{ column_view.array_type }}, elementCount)
{{~ else ~}}
					if len(r.{{ column_view.name }}) != elementCount {
						return fmt.Errorf(
							"{{ table.raw_name }}: the file gives one member of `{{ column_view.name }}` a different element count than another")
					}
{{~ end ~}}
					for j := 0; j < elementCount; j++ {
						r.{{ column_view.name }}[j]{{ column_view.member_access }}{{ column_view.member_ref_suffix }} = {{ column_view.read_value }}
					}
{{~ else if column_view.kind == 'array_of_arrays_member' ~}}
{{~## One inner slice. Which outer element it is, is which column this is - so the outer
   index is fixed here and the loop runs the inner length. spec/types/nested-multi-level.md. ##~}}
					{{ column_view.length_read }}
					r.{{ column_view.name }}[{{ column_view.member_at }}] = make({{ column_view.element_slice_type }}, elementCount)
					for j := 0; j < elementCount; j++ {
						r.{{ column_view.name }}[{{ column_view.member_at }}][j] = {{ column_view.read_value }}
					}
{{~ else if column_view.kind == 'record_member_var' ~}}
{{~## The member is the array: the index goes after its name rather than before, and its
   length is this row's - see spec/types/nested-multi-level.md. ##~}}
					{{ column_view.length_read }}
{{~ if column_view.row_member_access != '' ~}}
{{~## A reference member holds one key per element as well as one row, and the read writes
   into the key - so both are made. The member's own name is the key's.
   spec/references/reference-surface-naming.md section 4. ##~}}
					r.{{ column_view.name }}{{ column_view.member_access }} = make([]{{ column_view.ref_key_type }}, elementCount)
					r.{{ column_view.name }}{{ column_view.row_member_access }} = make({{ column_view.element_slice_type }}, elementCount)
{{~ else ~}}
					r.{{ column_view.name }}{{ column_view.member_access }} = make({{ column_view.element_slice_type }}, elementCount)
{{~ end ~}}
					for j := 0; j < elementCount; j++ {
						r.{{ column_view.name }}{{ column_view.member_access }}{{ column_view.member_ref_suffix }}[j] = {{ column_view.read_value }}
					}
{{~ else if column_view.kind == 'scalar_ref' ~}}
					r.{{ column_view.name }} = {{ column_view.read_value }}
{{~ else ~}}
					r.{{ column_view.name }}{{ column_view.member_access }}{{ column_view.member_ref_suffix }} = {{ column_view.read_value }}
{{~ end ~}}
				}
{{~ end ~}}
{{~ if column_view.is_nullable }}
				// A pass of its own rather than a line inside each read shape, so the row
				// index is worked out once. The block carries a value for every row, so an
				// absent one has just been given whatever was there; putting the empty
				// value back is what makes this path agree with the JSON one.
				for i := int32(0); i < count; i++ {
					records[i].{{ column_view.presence_member }} = tabbit.IsPresent(presence, i)

					if !records[i].{{ column_view.presence_member }} {
						records[i].{{ column_view.name }} = {{ column_view.empty_value }}
					}
				}
{{~ end ~}}
			}
{{~ end ~}}
		default:
			// A column added after this code was generated.
			reader.Skip(column.ByteLength)
		}

		tabbit.CheckBlockEnd(reader, column, blockEnd)
	}

	if err := reader.Err(); err != nil {
		return fmt.Errorf("{{ table.raw_name }}: %w", err)
	}

{{~ if table.containers | array.size > 0 ~}}
{{~## The lookups a `set` and a `map` publish beside their slices. Here rather than on the way
   through: a map needs its key column and how long it is, and the columns arrive one at a
   time. spec/types/set-and-map.md section 7.3. ##~}}
	for i := range records {
		r := &records[i]
{{~ for container in table.containers ~}}
		r{{ container.access }}.{{ container.name }} =
			make({{ container.type_name }}, len(r{{ container.access }}.{{ container.source }}))
		for j := range r{{ container.access }}.{{ container.source }} {
{{~ if container.stored_value == '' ~}}
			r{{ container.access }}.{{ container.name }}[r{{ container.access }}.{{ container.source }}[j]] = true
{{~ else if container.stored_value == 'j' ~}}
			r{{ container.access }}.{{ container.name }}[r{{ container.access }}.{{ container.source }}[j]] = j
{{~ else ~}}
			r{{ container.access }}.{{ container.name }}[r{{ container.access }}.{{ container.source }}[j]] =
				r{{ container.access }}.{{ container.stored_value }}
{{~ end ~}}
		}
{{~ end ~}}
	}

{{~ end ~}}
{{~ for index in table.indexes ~}}
	{{ index.map_name }} := make(map[{{ index.key_type }}]int, len(records))
	for i := range records {
{{~ if index.is_composite ~}}
		{{ index.map_name }}[t.keyOf{{ index.suffix }}({{ for c in index.components }}records[i].{{ c.member }}{{ if !for.last }}, {{ end }}{{ end }})] = i
{{~ else ~}}
		{{ index.map_name }}[records[i].{{ index.member }}] = i
{{~ end ~}}
	}

{{~ end ~}}
	// Published, now that every column read and the indexes are built.
	t.records = records
{{~ for index in table.indexes ~}}
	t.{{ index.map_name }} = {{ index.map_name }}
{{~ end ~}}

	return nil
}
