{{~##
   One record type as a USTRUCT.

   Included from two places and written once, because the type is the same shape wherever it
   is declared: a group nobody declared gets it beside the table's row struct, and a group a
   `.tbs` file typed gets one copy above the tables - a USTRUCT name is global, so the second
   copy would be an error rather than a second type.
   spec/types/declared-struct-identity.md.
##~}}
{{~ if rt.is_outermost ~}}
/** One element of {{ rt.owner }}. */
{{~ else ~}}
/** A record inside {{ rt.owner }}. */
{{~ end ~}}
USTRUCT(BlueprintType)
struct {{ api_macro }} {{ rt.type_name }}
{
    GENERATED_BODY()

{{~ for member in rt.members ~}}
{{~ for line in member.comment ~}}
    /** {{ line }} */
{{~ end ~}}
{{~ if member.blueprint_visible ~}}
    UPROPERTY(EditAnywhere, BlueprintReadOnly, Category = "{{ rt.category }}")
{{~ else ~}}
    // No UPROPERTY: {{ member.not_visible_because }}
{{~ end ~}}
    {{ member.declaration }}

{{~ end ~}}
{{~## The second layer of a container's surface. The arrays above are the file's order; these
   are the lookup, and neither of the engine's containers keeps one. No UPROPERTY: the header
   tool has no property type for a map keyed by anything a sheet may key by, and what a
   Blueprint reads is the array. spec/types/set-and-map.md section 7. ##~}}
{{~ for line in rt.lookups ~}}
    {{ line }}
{{~ end ~}}
{{~ if rt.lookups | array.size > 0 }}
{{~ end ~}}};

