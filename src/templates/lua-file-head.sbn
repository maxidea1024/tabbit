{{~##
   What every generated Lua module starts with: the banner, the relative require prefix,
   and the reader.

   `_root` is this module's own mount point, taken off the name require was given - so the
   output works wherever it is dropped on package.path, without a prefix a recipe would
   have to set. A file at the output root strips one component and a file one directory
   deep strips two; `root_pattern` is whichever this file needs.

   `requires` is what this file actually needs from its siblings, worked out by
   TypeDependencies.
##~}}
-- ------------------------------------------------------------------------------
-- Generated by Tabbit. DO NOT EDIT.
--
-- Changes to this file may cause incorrect behavior and will be lost if the code is
-- regenerated.
-- ------------------------------------------------------------------------------

local _root = (...):match("{{ root_pattern }}")
local tcb = require(_root .. "tabbit.tcb_reader")
{{~ for line in requires ~}}
{{ line }}
{{~ end ~}}
