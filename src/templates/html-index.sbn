{{~##
   The overview: what the conversion produced, in counters.

   The counters exist because the pages had none. A reader could see one table's record
   count in its heading and nothing about the model as a whole - not how many tables, not
   how many rows, not what the columns are typed as. Those are the first questions
   somebody checking a conversion asks, and answering them needed no new data: every
   number here is counted off the model.

   The lists of entities are not here. They were, and each of them grew with the project
   until the page was a wall of names with the counters above it - so each kind has a page
   of its own now, sortable and filterable, and every card here is the way in.
##~}}
{{~ include 'html-head.sbn' ~}}
<p class="lead">테이블 {{ stats.tables }}개 · 행 {{ stats.rows }}개 · 컬럼 {{ stats.columns }}개 · {{ stats.workbooks }}</p>

<div class="cards">
<a class="card" href="tables.html"><div class="n">{{ stats.tables }}</div><div class="k"><svg class="i"><use href="#i-table"></use></svg>테이블</div></a>
<div class="card"><div class="n">{{ stats.rows }}</div><div class="k">행</div></div>
<a class="card" href="fields.html"><div class="n">{{ stats.columns }}</div><div class="k"><svg class="i"><use href="#i-column"></use></svg>컬럼</div></a>
<div class="card"><div class="n">{{ stats.cells }}</div><div class="k">셀</div></div>
<a class="card" href="enums.html"><div class="n">{{ stats.enums }}</div><div class="k"><svg class="i"><use href="#i-enum"></use></svg>enum</div></a>
<div class="card"><div class="n">{{ stats.labels }}</div><div class="k">enum 레이블</div></div>
<a class="card" href="constantsets.html"><div class="n">{{ stats.constant_sets }}</div><div class="k"><svg class="i"><use href="#i-const"></use></svg>상수 세트</div></a>
<div class="card"><div class="n">{{ stats.constants }}</div><div class="k">상수</div></div>
</div>

<h2>컬럼의 모양</h2>
<div class="cols">
<div>
<h3>타입별</h3>
<div class="dist">
{{~ for item in type_distribution ~}}
<span class="k">{{ item.name }}</span><span class="track"><div style="width: {{ item.percent }}%"></div></span><span class="v">{{ item.count }}</span>
{{~ end ~}}
</div>
</div>
<div>
<h3>역할별</h3>
<div class="dist">
{{~ for item in role_distribution ~}}
<span class="k">{{ item.name }}</span><span class="track"><div style="width: {{ item.percent }}%"></div></span><span class="v">{{ item.count }}</span>
{{~ end ~}}
</div>
</div>
<div>
<h3>측별</h3>
<div class="dist">
{{~ for item in side_distribution ~}}
<span class="k">{{ item.name }}</span><span class="track"><div style="width: {{ item.percent }}%"></div></span><span class="v">{{ item.count }}</span>
{{~ end ~}}
</div>
</div>
</div>

{{~ if largest_tables | array.size > 0 ~}}
<h2><svg class="i"><use href="#i-table"></use></svg>큰 테이블</h2>
<div class="dist">
{{~ for item in largest_tables ~}}
<span class="k"><svg class="i"><use href="#i-table"></use></svg><a href="{{ item.href }}">{{ item.name }}</a></span><span class="track"><div style="width: {{ item.percent }}%"></div></span><span class="v">{{ item.count }}</span>
{{~ end ~}}
</div>
{{~ end ~}}

<h2 id="source-sheets"><svg class="i"><use href="#i-workbook"></use></svg>원본 워크북<span class="count">{{ source_sheets | array.size }}</span></h2>
<ul class="entities">
{{~## A workbook on disk has no url, and `href=""` is a link back to this page. ##~}}
{{~ for sheet in source_sheets ~}}
{{~ if sheet.url != '' ~}}
<li><svg class="i"><use href="#i-workbook"></use></svg><a href="{{ sheet.url }}">{{ sheet.filename }}</a> <span class="n-of">{{ sheet.detail }}</span></li>
{{~ else ~}}
<li><svg class="i"><use href="#i-workbook"></use></svg>{{ sheet.filename }} <span class="n-of">{{ sheet.detail }}</span></li>
{{~ end ~}}
{{~ end ~}}
</ul>
{{ include 'html-foot.sbn' }}
