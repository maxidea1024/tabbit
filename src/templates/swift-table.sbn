{{~##
   One table: its record class and its table class. `table` is the single table this file
   is for, so nothing here loops over the model.
##~}}
{{ include 'swift-file-head.sbn' ~}}

// Generated from {{ table.location }}
{{~ for line in table.comment ~}}
/// {{ line }}
{{~ end ~}}
public final class {{ table.record_name }} {

    public init() {}
{{~ for field in table.fields }}
{{~ for line in field.comment ~}}
    /// {{ line }}
{{~ end ~}}
{{~ for declaration in field.declarations ~}}
    {{ declaration }}
{{~ end ~}}
{{~ if field.is_nullable ~}}
    /// Whether this row has a value for {{ field.name }}. The value property keeps its type
    /// and holds the type's empty value when the row had none; this says which it was.
    public var {{ field.presence_member }}: Bool = false
{{~ end ~}}
{{~ if field.has_optional_elements ~}}
    /// Which of {{ field.name }}'s elements have a value. Empty where the file did not carry
    /// the column, and then every index is out of range anyway.
    public var {{ field.element_presence_member }}: [Bool] = []
{{~ end ~}}
{{~ end ~}}
{{~ for field in table.fields ~}}
{{~ if field.variants.size > 0 }}

{{~## **The value, built once on first use.** The entry above is what the read filled - one
   assignment per column - and which variant it is only became knowable when the discriminator
   column arrived. Building it here keeps the read path and the wire exactly as they were.
   spec/types/polymorphism.md section 7.2. ##~}}
{{~ if field.variants_are_array ~}}
{{~## **The array shape.** Each element carries its own discriminator - section 5.3 - so the
   shapes inside one row may differ, and what a consumer reads is an array of the abstract type.
   The function that builds one is below and is the same either way. ##~}}
    private var {{ field.name }}Value: [{{ field.abstract_type_name }}]?

    /// What this row's {{ field.abstract_type_name }}s are, one per element.
    public var {{ field.name }}Of: [{{ field.abstract_type_name }}] {
        get {
            if let all = {{ field.name }}Value { return all }

            let all = {{ field.name }}.map { Self.{{ field.name }}Element($0) }

            {{ field.name }}Value = all
            return all
        }
    }
{{~ else ~}}
    private var {{ field.name }}Value: {{ field.abstract_type_name }}?

    /// What this row's {{ field.abstract_type_name }} is. `switch` over it is exhaustive.
    public var {{ field.name }}Of: {{ field.abstract_type_name }} {
        get {
            if let built = {{ field.name }}Value { return built }

            let built = Self.{{ field.name }}Element({{ field.name }})

            {{ field.name }}Value = built
            return built
        }
    }
{{~ end ~}}

    /// Builds one value from the entry the read filled.
    private static func {{ field.name }}Element(
        _ entry: {{ field.record_type_name }}
    ) -> {{ field.abstract_type_name }} {
            let built: {{ field.abstract_type_name }}
            switch entry.type {
{{~ for variant in field.variants ~}}
            case {{ variant.discriminator }}:
                built = .{{ variant.case_name }}({{ variant.type_name }}(
{{~ for member in field.base_members ~}}
{{~ if member.row_name != '' ~}}
{{~## A reference member is two of these: the key the cell held under its own name, and the row
   it resolved to under the derived one. spec/references/reference-surface-naming.md 4 and 5. ##~}}
                    {{ member.name }}: entry.{{ member.name }},
                    {{ member.row_name }}: entry.{{ member.row_name }},
{{~ else ~}}
                    {{ member.name }}: entry.{{ member.name }},
{{~ end ~}}
{{~ end ~}}
{{~ for member in variant.members ~}}
{{~ if member.row_name != '' ~}}
{{~## A reference member is two of these: the key the cell held under its own name, and the row
   it resolved to under the derived one. spec/references/reference-surface-naming.md 4 and 5. ##~}}
                    {{ member.name }}: entry.{{ member.name }},
                    {{ member.row_name }}: entry.{{ member.row_name }},
{{~ else ~}}
                    {{ member.name }}: entry.{{ member.name }},
{{~ end ~}}
{{~ end ~}}
                ))
{{~ end ~}}
{{~## An unknown number is a variant this build does not have. Unlike a column added later,
   which the reader skips, that makes the whole row uninterpretable. ##~}}
            default:
                fatalError(
                    "{{ field.abstract_type_name }}: no variant is numbered \(entry.type)")
            }

            return built
    }
{{~ end ~}}
{{~ end ~}}
{{~## A column whose value is a row of one of several tables. One property for the resolved row
   whatever table it came from, and the discriminator saying which - the targets take separate
   id bands, so at most one of them ever answers. spec/references/multi-target-accessors.md. ##~}}
{{~## The element type of each record group. Nested rather than a second top-level type,
   which Swift would allow in this file - nesting scopes the name, so two tables each
   holding a `Slot` group do not collide in the module they share.

   A struct rather than a class: an element has no identity of its own and lives inline in
   the array, so there is no allocation per element and no reference to keep.
   spec/targets/swift-language-support.md. ##~}}
{{~ for field in table.fields ~}}
{{~## An array of arrays declares no element type: its outer level has no name, so there is
   nothing for a struct to be. spec/types/nested-multi-level.md. ##~}}
{{~ if field.is_record && !field.members_are_anonymous }}
{{~## One struct per level, innermost first - the view flattened the nesting so this loop
   does not have to know how deep it went. spec/types/nested-multi-level.md. ##~}}
{{~ for rt in field.record_types ~}}
{{~ if rt.is_outermost ~}}
    /// One element of {{ rt.owner }}.
{{~ else ~}}
    /// A record inside {{ rt.owner }}.
{{~ end ~}}
    public struct {{ rt.type_name }} {

        public init() {}
{{~ for member in rt.members }}
{{~ for line in member.comment ~}}
        /// {{ line }}
{{~ end ~}}
{{~ for line in member.declarations ~}}
        {{ line }}
{{~ end ~}}
{{~ end ~}}
{{~## The per-target accessors of every member of this struct that reaches several tables. A
   computed property where the member is one value; a method taking the element number where the
   member is the array, which is the third place an element number sits.
   spec/references/multi-target-accessors.md. ##~}}
{{~## The second layer of a container's surface. The arrays above are the file's order; these
   are the lookup, and neither of this language's hash containers keeps one.
   spec/types/set-and-map.md section 7. ##~}}
{{~ for line in rt.lookups ~}}
        {{ line }}
{{~ end ~}}
    }
{{~ end ~}}
{{~ end ~}}
{{~ end ~}}
}

/// Every row of {{ table.raw_name }}.
{{~## Conforming to Sequence puts its members - `max` - `min` - `first` - into the class body's
   own scope, where they shadow the global functions of the same name. `Swift.max` below is
   spelled that way for this reason and has to stay that way.
   spec/targets/table-collection-surface.md section 3.2. ##~}}
public final class {{ table.table_name }}: Sequence {

    public init() {}

    /// How many rows the table holds.
    public var count: Int { records.count }

    /// The rows, in the order the file wrote them. Conforming to `Sequence` on top of this
    /// is what gives the table `map` - `filter` - `first(where:)` without any of them being
    /// written here.
    ///
    /// The array is read once, here. A refresh replaces it rather than appending to it, so a
    /// loop already running keeps the rows it started with.
    public func makeIterator() -> Array<{{ table.record_name }}>.Iterator {
        records.makeIterator()
    }

    /// Every row, in the order the sheet declared them.
    ///
    /// The array a read published, not one a read fills. A refresh replaces the value rather
    /// than appending to it, so whoever holds this holds one whole load.
    public private(set) var records: [{{ table.record_name }}] = []
{{~ for index in table.indexes ~}}

    private var {{ index.map_name }}: [{{ index.key_type }}: {{ table.record_name }}] = [:]
{{~ end ~}}
{{~ if table.matrix }}
{{~ m = table.matrix ~}}
{{~## The two lookups composed. Both halves already exist - this table indexes its rows by the
   row axis and the column table indexes its own by the column axis - and what this adds is the
   one call that goes through both. spec/layout/matrix-declaration.md section 8. ##~}}
    private var columnAxis: {{ m.column_table }}?

    /// Hands this table the column axis its cells are positioned by.
    ///
    /// Called by the accessor once both files are read, and the length check is here rather
    /// than in the read. A grid is two files, either can be deployed without the other, and a
    /// row whose array is a different length from the axis is a row whose cells have moved.
    public func linkColumnAxis(_ columns: {{ m.column_table }}) throws {
        for record in records where record.{{ m.grid_member }}.count != columns.records.count {
            throw TcbError(
                "table `{{ table.raw_name }}` holds \(record.{{ m.grid_member }}.count) cells for "
                + "`\(record.{{ m.row_key_member }})` and its column axis `{{ m.column_table_name }}` holds "
                + "\(columns.records.count) keys; the two files are from different builds")
        }

        columnAxis = columns
    }

    /// The row axis keys, in the order the file wrote them.
    public var rowKeys: [{{ m.row_key_type }}] { records.map { $0.{{ m.row_key_member }} } }

    /// The column axis keys, in the order a row holds its cells.
    public var colKeys: [{{ m.column_key_type }}] {
        columnAxis?.records.map { $0.{{ m.column_key_member }} } ?? []
    }

    /// One row of cells, or nil when the grid has no such row.
    ///
    /// In the order `colKeys` is in, which is what makes a position mean something.
    public func row(_ {{ m.row_key_param }}: {{ m.row_key_type }}) -> [{{ m.cell_type }}]? {
        {{ m.row_lookup }}({{ m.row_key_param }})?.{{ m.grid_member }}
    }

    /// The cell where the two keys meet, or a thrown error naming the one that missed.
    ///
    /// It throws rather than answering with the type's empty value, because a grid's empty
    /// value is one the sheet can write - 0 in a modifier table is a modifier of zero.
    public func at(
        _ {{ m.row_key_param }}: {{ m.row_key_type }}, _ {{ m.column_key_param }}: {{ m.column_key_type }}
    ) throws -> {{ m.cell_type }} {
        let found = try cellAt({{ m.row_key_param }}, {{ m.column_key_param }})
        return found.record.{{ m.grid_member }}[found.at]
    }
{{~ if m.cells_are_optional }}

    /// Whether the sheet gave the cell where the two keys meet a value.
    ///
    /// A grid whose cells are optional reads a blank as the type's empty value, and that value
    /// is one the sheet could also have written - so this is the only way to tell them apart.
    public func hasAt(
        _ {{ m.row_key_param }}: {{ m.row_key_type }}, _ {{ m.column_key_param }}: {{ m.column_key_type }}
    ) throws -> Bool {
        let found = try cellAt({{ m.row_key_param }}, {{ m.column_key_param }})
        return found.record.{{ m.grid_has_member }}[found.at]
    }
{{~ end }}

    /// Both lookups, done once for the readers above.
    private func cellAt(
        _ {{ m.row_key_param }}: {{ m.row_key_type }}, _ {{ m.column_key_param }}: {{ m.column_key_type }}
    ) throws -> (record: {{ table.record_name }}, at: Int) {
        guard let axis = columnAxis else {
            throw TcbError(
                "table `{{ table.raw_name }}` has no column axis yet; "
                + "read `{{ m.column_table_name }}` before reading a cell")
        }

        guard let record = {{ m.row_lookup }}({{ m.row_key_param }}) else {
            throw RecordNotFoundError(
                "table `{{ table.raw_name }}` has no row `\({{ m.row_key_param }})`")
        }

        guard let column = axis.{{ m.column_lookup }}({{ m.column_key_param }}) else {
            throw RecordNotFoundError(
                "table `{{ table.raw_name }}` has no column `\({{ m.column_key_param }})`")
        }

        return (record, Int(column.{{ m.at_member }}))
    }

{{~ end ~}}
{{~ for index in table.indexes }}
{{~## A key of several columns is held as the text they make. Each part carries its own
   length, so no two combinations can make the same text - joined by a separator alone,
   ("a b", "c") and ("a", "b c") would be one key and one of the two rows would be lost.
   spec/layout/primary-layout.md section 3.5. ##~}}
{{~ if index.is_composite ~}}
    /// Joins the columns of the {{ index.field_name }} key into the text the map is keyed by.
    private static func keyOf{{ index.suffix }}({{ index.params }}) -> String {
        let parts: [String] = [
{{~ for c in index.components ~}}
{{~ if c.kind == "string" ~}}
            {{ c.param }},
{{~ else if c.kind == "enum" ~}}
            String({{ c.param }}.rawValue),
{{~ else ~}}
            String({{ c.param }}),
{{~ end ~}}
{{~ end ~}}
        ]

        var text = ""

        for part in parts {
            text += "\(part.count):\(part)"
        }

        return text
    }

    /// The row with this {{ index.field_name }}, or nil when the table has none.
    ///
    /// The lookup to reach for when a missing row is an ordinary answer - an optional
    /// reference, a key that came from user input.
    public func findBy{{ index.suffix }}({{ index.params }}) -> {{ table.record_name }}? {
        {{ index.map_name }}[{{ index.argument }}]
    }
{{~ else ~}}
    /// The row with this {{ index.field_name }}, or nil when the table has none.
    ///
    /// The lookup to reach for when a missing row is an ordinary answer - an optional
    /// reference, a key that came from user input.
    public func findBy{{ index.suffix }}(_ key: {{ index.key_type }}) -> {{ table.record_name }}? {
        {{ index.map_name }}[key]
    }
{{~ end ~}}

    /// The row with this {{ index.field_name }}, or a thrown error naming what was missing.
    ///
    /// For a key that has to be there - one from another table, or a constant. The name says
    /// it throws, because a caller reading getBy{{ index.suffix }}OrThrow(key).name at a
    /// glance cannot otherwise tell whether the next line is a nil check or a catch.
    public func getBy{{ index.suffix }}OrThrow({{ index.params }}) throws -> {{ table.record_name }} {
        guard let record = {{ index.map_name }}[{{ index.argument }}] else {
            throw RecordNotFoundError(
                "there is no record in table `{{ table.raw_name }}` that corresponds to "
                + "field `{{ index.field_name }}` value {{ index.value_format }}")
        }

        return record
    }

    /// Whether the table holds a row with this {{ index.field_name }}.
    public func contains{{ index.suffix }}({{ index.params }}) -> Bool {
        {{ index.map_name }}[{{ index.argument }}] != nil
    }
{{~ if index.is_primary }}

    /// The row with this {{ index.field_name }}, or nil when the table has none.
    ///
    /// `findBy{{ index.suffix }}` under the spelling Swift uses for a keyed collection. It
    /// answers with an optional because that is what `Dictionary` does here, and the type
    /// says so - a language whose own map throws generates a subscript that throws.
    /// spec/targets/table-collection-surface.md section 5.7.
    ///
    /// This is the key, not the row's position. `table[0]` is the row whose
    /// {{ index.field_name }} is 0, not the first row - the rows in order are `records`.
    public subscript({{ index.params }}) -> {{ table.record_name }}? {
        findBy{{ index.suffix }}({{ index.call_args }})
    }
{{~ end ~}}
{{~ if index.is_primary && !index.is_composite }}

    /// Each row with the {{ index.field_name }} it is keyed by -
    /// `for (key, row) in table.entries`.
    ///
    /// What this saves a caller is not the key value - the row carries it - but having to
    /// know which column the key is: {{ index.field_name }} here, something else in the
    /// next table.
    ///
    /// The rows come in the order the file wrote them rather than the order the dictionary
    /// holds them, which makes this and iterating the table agree. Only the primary key has
    /// this: a table keyed by several columns together has no single key value to pair a
    /// row with.
    public var entries: LazyMapSequence<[{{ table.record_name }}], (key: {{ index.key_type }}, row: {{ table.record_name }})> {
        records.lazy.map { (key: $0.{{ index.member }}, row: $0) }
    }
{{~ end ~}}
{{~ end ~}}

    /// Loads the table from a .tcb file written by Tabbit.
    ///
    /// Column by column, matched by tag rather than position: a column this build does not
    /// know is skipped by its block length, and one whose type changed incompatibly throws
    /// naming the field.
    ///
    /// The keys are parameters rather than properties of a shared object, because Swift's
    /// concurrency checking makes mutable global state an error and because the accessor
    /// holding them is an instance - which is what lets two loads of two data sets exist at
    /// once. {{ accessor_name }} passes its own. spec/targets/accessor-instances.md.
    public func read(
        _ filename: String,
        key: [UInt8]? = nil,
        macKey: [UInt8]? = nil,
        verifyMac: Bool = true
    ) throws {
        // Opened unconditionally, and with whatever the caller holds - which is nil unless
        // the project set it. A file that is neither encrypted nor signed comes back from
        // this untouched, so the load path is the same either way and there is no condition
        // here that could be the wrong way round. spec/wire/tcb-mac-and-signature.md.
        let bytes = try Tcb.openTable(
            try Tcb.readAllBytes(filename), key: key, macKey: macKey, verifyMac: verifyMac)

        let reader = Tcb.Reader(bytes)
        let header = try Tcb.readTableHeader(reader)
        let count = header.rowCount

        // Read into storage of its own and published at the end: reading a table that is
        // already loaded is a refresh, and one that turns out to be unreadable has to leave
        // the rows already there alone.
        var loaded = [{{ table.record_name }}]()
        loaded.reserveCapacity(count)

        for _ in 0 ..< count { loaded.append({{ table.record_name }}()) }
{{~ for index in table.indexes ~}}
        var loadedBy{{ index.suffix }} = [{{ index.key_type }}: {{ table.record_name }}](
            minimumCapacity: count)
{{~ end ~}}

        for column in header.columns {
            let blockEnd = reader.position + column.byteLength

            switch column.tag {
{{~ for column_view in table.columns ~}}
            case {{ column_view.wire_tag }}:
                {{ column_view.column_check }}
{{~ if column_view.is_nullable ~}}
                // The bitmap is at the front of the block, so it is read before the values.
                // The values are written for every row either way, which is what lets the
                // read shapes below stay as they are.
                let presence = try Tcb.readPresence(reader, column, count)
{{~ end ~}}
{{~ if column_view.has_optional_elements ~}}
                // Behind the row bitmap and in front of the values, walked with a counter
                // that steps once per element of every row.
                // spec/types/nullable-array-elements.md.
                let elementPresence = try Tcb.readElementPresence(reader, column)
                var elementAt = 0
{{~ end ~}}
{{~## Constructed after the check and before the rows: a dictionary encoding decodes its
      dictionary here, at the head of the block. Opened ahead of every read shape, because
      an array's elements read through it as well. After the presence bitmap, which sits in
      front of the block the cursor is about to start reading. ##~}}
{{~ if column_view.cursor_open != '' ~}}
                {{ column_view.cursor_open }}
{{~ end ~}}
{{~ if column_view.run_call != '' ~}}
{{~## A run of equal values costs one call and then plain assignments, rather than one call
      per row that each re-dispatch on the encoding. An encoding with no run to give answers
      1, so this loop is correct over all of them. ##~}}
                var at = 0
                while at < count {
                    var n = try cursor.{{ column_view.run_call }}(count - at)
                    while n > 0 {
                        let i = at
                        {{ column_view.run_spend }}
                        at += 1
                        n -= 1
                    }
                }
{{~ else ~}}
                for record in loaded {
{{~ if column_view.kind == 'var_array' ~}}
                    let elementCount = Swift.max(0, {{ column_view.length_read }})
                    record.{{ column_view.name }} = []
                    record.{{ column_view.name }}.reserveCapacity(elementCount)
{{~ if column_view.has_optional_elements ~}}
                    record.{{ column_view.element_presence_member }} = []
                    record.{{ column_view.element_presence_member }}.reserveCapacity(elementCount)

                    for _ in 0 ..< elementCount {
                        record.{{ column_view.name }}.append({{ column_view.read_element }})
                        record.{{ column_view.element_presence_member }}.append(
                            Tcb.isPresent(elementPresence, elementAt))
                        elementAt += 1
                    }
{{~ else ~}}

                    for _ in 0 ..< elementCount {
                        record.{{ column_view.name }}.append({{ column_view.read_element }})
                    }
{{~ end ~}}
{{~ else if column_view.kind == 'record_var' ~}}
                    let elementCount = Swift.max(0, {{ column_view.length_read }})
{{~ if column_view.is_first_member ~}}
                    // The first member allocates; the rest check. Allocating again would
                    // discard what the members before it wrote, and taking the shorter of two
                    // counts would shift every value after it.
                    record.{{ column_view.name }} = [{{ column_view.record_type_name }}](
                        repeating: {{ column_view.record_type_name }}(), count: elementCount)
{{~ else ~}}
                    if record.{{ column_view.name }}.count != elementCount {
                        throw TcbError(
                            "{{ table.raw_name }}.{{ column_view.name }}: the file gives one "
                            + "member of this record a different element count than another")
                    }
{{~ end ~}}

                    for element in 0 ..< elementCount {
                        record.{{ column_view.name }}[element]{{ column_view.member_access }}{{ column_view.member_ref_suffix }} = {{ column_view.read_element }}
                    }
{{~ else if column_view.kind == 'array_of_arrays_member' ~}}
{{~## One inner array. Which outer element it is, is which column this is - so that index is
   fixed and the loop runs the inner length. spec/types/nested-multi-level.md. ##~}}
                    let elementCount = Swift.max(0, {{ column_view.length_read }})
                    record.{{ column_view.name }}[{{ column_view.member_at }}] = []
                    record.{{ column_view.name }}[{{ column_view.member_at }}].reserveCapacity(elementCount)
                    for _ in 0 ..< elementCount {
                        record.{{ column_view.name }}[{{ column_view.member_at }}].append({{ column_view.read_element }})
                    }
{{~ else if column_view.kind == 'record_member_var' ~}}
{{~## The member is the array: the index goes after its name rather than before. Same
   columns and same loop as the case below - see spec/types/nested-multi-level.md. ##~}}
                    let elementCount = Swift.max(0, {{ column_view.length_read }})
                    record.{{ column_view.name }}{{ column_view.member_access }}{{ column_view.member_ref_suffix }} = []
                    record.{{ column_view.name }}{{ column_view.member_access }}{{ column_view.member_ref_suffix }}.reserveCapacity(elementCount)
                    for _ in 0 ..< elementCount {
                        record.{{ column_view.name }}{{ column_view.member_access }}{{ column_view.member_ref_suffix }}.append({{ column_view.read_element }})
                    }
{{~ else if column_view.kind == 'var_array_ref' ~}}
{{~## A trimmed array of references. The keys are the array this row's length fills; the
   resolved rows are filled by the linking pass. spec/types/variable-length-record-arrays.md. ##~}}
                    let elementCount = Swift.max(0, {{ column_view.length_read }})
                    record.{{ column_view.name }} = []
                    record.{{ column_view.name }}.reserveCapacity(elementCount)
{{~ if column_view.has_optional_elements ~}}
                    record.{{ column_view.element_presence_member }} = []
                    record.{{ column_view.element_presence_member }}.reserveCapacity(elementCount)

                    for _ in 0 ..< elementCount {
                        record.{{ column_view.name }}.append({{ column_view.read_element }})
                        record.{{ column_view.element_presence_member }}.append(
                            Tcb.isPresent(elementPresence, elementAt))
                        elementAt += 1
                    }
{{~ else ~}}

                    for _ in 0 ..< elementCount {
                        record.{{ column_view.name }}.append({{ column_view.read_element }})
                    }
{{~ end ~}}
{{~ else if column_view.kind == 'scalar_ref' ~}}
                    record.{{ column_view.name }} = {{ column_view.read_scalar }}
{{~ else ~}}
                    record.{{ column_view.name }}{{ column_view.member_access }}{{ column_view.member_ref_suffix }} = {{ column_view.read_scalar }}
{{~ end ~}}
                }
{{~ end ~}}
{{~ if column_view.is_nullable }}
                // A pass of its own rather than a line inside each read shape, so the row
                // index is worked out once. The block carries a value for every row, so an
                // absent one has just been given whatever was there; putting the empty value
                // back is what makes this path agree with the JSON one.
                for row in 0 ..< count {
                    let record = loaded[row]
                    record.{{ column_view.presence_member }} = Tcb.isPresent(presence, row)

                    if !record.{{ column_view.presence_member }} {
                        record.{{ column_view.name }} = {{ column_view.empty_value }}
                    }
                }
{{~ end ~}}
{{~ end ~}}
            default:
                // A column added after this code was generated.
                try reader.skip(column.byteLength)
            }

            try Tcb.checkBlockEnd(reader, column, blockEnd)
        }
{{~ if table.container_fill | array.size > 0 }}
{{~## The lookups a `set` and a `map` publish beside their arrays. By index, because an
   element of an array of structs is a copy - mutating `record` would throw the answer away.
   Here rather than on the way through: a map needs its key column and how long it is, and
   the columns arrive one at a time. spec/types/set-and-map.md section 7.3. ##~}}
        for i in 0..<loaded.count {
{{~ for line in table.container_fill ~}}
            {{ line }}
{{~ end ~}}
        }
{{~ end ~}}
{{~ if table.indexes | array.size > 0 }}
        for record in loaded {
{{~ for index in table.indexes ~}}
{{~ if index.is_composite ~}}
            loadedBy{{ index.suffix }}[Self.keyOf{{ index.suffix }}({{ for c in index.components }}record.{{ c.member }}{{ if !for.last }}, {{ end }}{{ end }})] = record
{{~ else ~}}
            loadedBy{{ index.suffix }}[record.{{ index.member }}] = record
{{~ end ~}}
{{~ end ~}}
        }
{{~ end ~}}

        // Published, now that every column read.
        records = loaded
{{~ for index in table.indexes ~}}
        {{ index.map_name }} = loadedBy{{ index.suffix }}
{{~ end ~}}
    }
}
