{{~##
 One module per table: the row interface the JSON is parsed into, the record class, and
 the table class with both read paths.

 Both a JSON and a binary path are generated so a consumer picks per deployment rather
 than per build - JSON where the data is inspected by hand or served as text, binary
 where size and parse time matter. The two produce identical values, which is why the
 reader formats dates and durations as the strings the JSON export writes.

 Anything needing the model arrives already rendered from TsView.
##~}}
{{ include 'ts-head.sbn' ~}}
import * as fs from 'fs'
import * as tabbit from '../tabbit/tcb-reader'

// The accessor, for the encryption key it holds. `tables` imports this module back, and
// that cycle is only ever read from inside a method - by which point both modules have
// finished evaluating - so neither one is half built when the binding is used.
import { {{ accessor_name }} } from '../{{ accessor_file }}'
{{~ if imports | array.size > 0 ~}}

// Automatically import to handle external type references.
{{~ for line in imports ~}}
{{ line }}
{{~ end ~}}
{{~ end ~}}

{{~## The element type of each record group, and the shape the JSON export carries it
   in. Two interfaces because a member's exported type is not always its member type -
   a 64-bit integer travels as a string. See spec/types/nested-fields.md. ##~}}
{{~ for field in fields ~}}
{{~## An array of arrays declares no element interface: its outer level has no name, so
   there is nothing for one to describe. spec/types/nested-multi-level.md. ##~}}
{{~ if field.is_record && !field.members_are_anonymous ~}}
{{~## One interface per level, innermost first - the view flattened the nesting so this loop
   does not have to know how deep it went. spec/types/nested-multi-level.md. ##~}}
{{~ for rt in field.record_types ~}}
{{~## A shared type is written once in a module of its own, and imported above. The `…Json`
   twin below is this module's parsing detail and stays either way.
   spec/types/declared-struct-identity.md. ##~}}
{{~ if !rt.is_shared ~}}
{{~ if rt.is_outermost ~}}
/** One element of {{ name }}Record.{{ field.prop_name }}. */
{{~ else ~}}
/** A record inside {{ name }}Record.{{ field.prop_name }}. */
{{~ end ~}}
export interface {{ rt.type_name }} {
{{~ for member in rt.members ~}}
{{~ for line in member.comment ~}}
  {{ line }}
{{~ end ~}}
{{~ if member.ref_key_type_name != '' ~}}
{{~## A reference member carries two things: the key that came off the wire under the
   member's own name, and the row it resolved to under the derived one. Whether the
   resolution happened the key answers, so there is no third property for it.
   spec/references/reference-surface-naming.md sections 4 and 5. ##~}}
  {{ member.prop_name }}: {{ member.ref_key_type_name }}
  {{ member.row_prop_name }}: {{ member.field_type }}
{{~ else ~}}
  {{ member.prop_name }}: {{ member.field_type }}
{{~ end ~}}
{{~ end ~}}
{{~## The second layer of a container's surface. Properties rather than accessors, which is
   this language's own convention - an interface declares no method, so where every other
   language puts a lookup on the element type this puts the container itself. `Map` and `Set`
   keep insertion order here, so iterating one gives the file's order back.
   spec/types/set-and-map.md section 7.2. ##~}}
{{~ for lookup in rt.lookups ~}}
{{~ if lookup.is_map ~}}
{{~ if lookup.prop_name == 'byKey' ~}}
  /** What each key is mapped to. Insertion order, which is the file's. */
{{~ else ~}}
  /** Where each key sits among the entries - this map's value is a struct, which is a
      property per column, so what a lookup can answer with is the position. */
{{~ end ~}}
{{~ else ~}}
  /** The elements of `{{ lookup.source_prop }}`, for asking whether one is there. */
{{~ end ~}}
  {{ lookup.prop_name }}: {{ lookup.type_name }}
{{~ end ~}}
}
{{~ end ~}}

{{~ if field.variants.size > 0 ~}}
{{~## The union built from one entry. A `switch` so a variant the file names and this build
   does not have is reported rather than read as a neighbour - unlike a column added later,
   which the reader skips, an unknown variant makes the whole row uninterpretable.
   spec/types/polymorphism.md section 7.2. ##~}}
function build{{ field.prop_name | string.capitalize }}(e: {{ rt.type_name }}): {{ field.abstract_type_name }} {
  switch (e.type) {
{{~ for variant in field.variants ~}}
    case {{ variant.discriminator }}:
      return {
        kind: '{{ variant.type_name }}',
{{~ for member in field.base_members ~}}
{{~ if member.row_name != '' ~}}
        {{ member.prop_name }}: e.{{ member.prop_name }},
        {{ member.row_name }}: e.{{ member.row_name }},
{{~ else ~}}
        {{ member.prop_name }}: e.{{ member.prop_name }},
{{~ end ~}}
{{~ end ~}}
{{~ for member in variant.members ~}}
{{~ if member.row_name != '' ~}}
{{~## The row from the row and the key from the key. The entry carries both. ##~}}
        {{ member.prop_name }}: e.{{ member.prop_name }},
        {{ member.row_name }}: e.{{ member.row_name }},
{{~ else ~}}
        {{ member.prop_name }}: e.{{ member.prop_name }},
{{~ end ~}}
{{~ end ~}}
      }
{{~ end ~}}
  }

  throw new Error(`{{ field.abstract_type_name }}: no variant is numbered ${e.type}. This build knows {{ field.variants | array.map "type_name" | array.join ", " }}.`)
}

{{~ end ~}}
/** {{ rt.type_name }} as the .json export carries it. */
interface {{ rt.type_name }}Json {
{{~ for member in rt.members ~}}
  {{ member.prop_name }}: {{ member.json_wire_type }}
{{~ end ~}}
}

{{ end ~}}
{{~ end ~}}
{{~ end ~}}
/** A type for handling rows when parsing .json. */
interface IDataRow {
{{~ for field in fields ~}}
{{~ if field.is_array ~}}
  {{ field.prop_name }}: {{ field.json_wire_type }}[]
{{~ else ~}}
  {{ field.prop_name }}: {{ field.json_wire_type }}
{{~ end ~}}
{{~ end ~}}
}
{{~## The per-target accessors of every record member reaching several tables. Functions
   beside the element rather than members of it: this language's element type is an interface,
   and an interface declares no accessor - every other language puts the accessor on the
   element, which is that language's own convention. spec/references/multi-target-accessors.md. ##~}}

// Generated from {{ location }}
{{~ for line in comment ~}}
{{ line }}
{{~ end ~}}
export class {{ name }}Record {
  /** Default constructor */
  constructor() {
  }
{{~## The readable surface first, and the storage below it. A getter and its
   backing field on adjacent lines reads as noise where the field is never the
   thing a consumer wants; grouped, the top of the record is what it holds and
   the bottom is how. ##~}}
{{~ for field in fields }}
{{~ for line in field.comment ~}}
  {{ line }}
{{~ end ~}}
{{~## **No length constant.** A number published here could only be the one the sheet had
   when this code was generated, and a consumer holding to it would be holding to something
   the data no longer has to agree with - `length` on the array is the answer and it cannot
   go stale. Where several columns fill one array the length is still a number this code has
   to know, and there it is written into the allocation rather than published.
   spec/types/nullable-array-elements.md. ##~}}
{{~ if field.variants.size > 0 ~}}
{{~## **The union, built once on first use.** The entry below is what the read filled - one
   assignment per column - and which variant it is only became knowable when the discriminator
   column arrived. Building it here rather than while reading keeps the read path and the wire
   exactly as they were, and a row nobody looks at costs nothing.
   spec/types/polymorphism.md section 7.2.

   This comes before the array branches on purpose: a polymorphic column is read as entries
   either way, and what a consumer wants is the union - one of it, or a list of it. ##~}}
{{~ if field.variants_are_array ~}}
  public get {{ field.prop_name }}(): {{ field.abstract_type_name }}[] {
    return this.{{ field.field_name }}_value ?? (this.{{ field.field_name }}_value = this.{{ field.field_name }}.map(build{{ field.prop_name | string.capitalize }}))
  }

  private {{ field.field_name }}_value: {{ field.abstract_type_name }}[] | null = null
{{~ else ~}}
  public get {{ field.prop_name }}(): {{ field.abstract_type_name }} {
    return this.{{ field.field_name }}_value ?? (this.{{ field.field_name }}_value = build{{ field.prop_name | string.capitalize }}(this.{{ field.field_name }}))
  }

  private {{ field.field_name }}_value: {{ field.abstract_type_name }} | null = null
{{~ end ~}}
{{~ else if field.kind == 'array_of_arrays' ~}}
{{~## The declared type is already the inner array, so the accessor is that array's array.
   spec/types/nested-multi-level.md. ##~}}
  public get {{ field.prop_name }}(): {{ field.field_type }}[] { return this.{{ field.field_name }} }
{{~ else if field.is_array && field.row_prop_name != '' ~}}
{{~## The column's name is the key's, because the key is what the cell holds. The rows are
   linked after loading and take a derived name.
   spec/references/reference-surface-naming.md sections 4 and 5. ##~}}
  public get {{ field.prop_name }}(): {{ field.ref_key_type_name }}[] { return this.{{ field.field_name }}_{{ field.ref_table }}_index }
  public get {{ field.row_prop_name }}(): {{ field.field_type }}[] { return this.{{ field.field_name }} }
{{~ else if field.is_array ~}}
  public get {{ field.prop_name }}(): {{ field.field_type }}[] { return this.{{ field.field_name }} }
{{~ else if field.row_prop_name != '' ~}}
  public get {{ field.prop_name }}(): {{ field.ref_key_type_name }} { return this.{{ field.field_name }}_{{ field.ref_table }}_index }
  public get {{ field.row_prop_name }}(): {{ field.field_type }} { return this.{{ field.field_name }} }
{{~ else ~}}
  public get {{ field.prop_name }}(): {{ field.field_type }} { return this.{{ field.field_name }} }
{{~ end ~}}
{{~ if field.is_nullable ~}}
{{~## The value accessor keeps its type and yields the type's empty value when the row had
   none; this says which it was. Same shape as every other language's, deliberately. ##~}}
  /** Whether this row has a value for `{{ field.prop_name }}`. */
  public get has{{ field.pascal_name }}(): boolean { return this.{{ field.presence_field }} }
{{~ end ~}}
{{~ if field.has_optional_elements ~}}
{{~## The same answer one level in. True where the row never got a bitmap: a column the file
   does not carry leaves the array empty, and an index into it is out of range anyway. ##~}}
  /** Whether element `index` of `{{ field.prop_name }}` has a value. */
  public has{{ field.pascal_name }}At(index: number): boolean {
    return this.{{ field.element_presence_field }} === null
      || index < 0 || index >= this.{{ field.element_presence_field }}.length
      || this.{{ field.element_presence_field }}[index]
  }
{{~ end ~}}
{{~ end ~}}
{{~## A column whose value is a row of one of several tables. The getter above hands back the
   key; these say which table it is in and hand back that table's row.

   One slot behind them all: the targets take separate id bands, so at most one of them ever
   answers and the rest would be permanently undefined. TypeScript can spell the slot as a
   union of the target types, so each getter narrows rather than asserts.
   spec/references/multi-target-accessors.md. ##~}}
{{~## Called by the accessor once every table is read, and by nothing else. Kept away
   from the getters above because a consumer never calls one. ##~}}
{{~ if reference_fields | array.size > 0 ~}}

{{~ for field in fields ~}}
{{~ if field.kind == 'array_ref' ~}}
  public setReference_{{ field.prop_name }}_INTERNAL(index: number, value: {{ field.reference_setter_type }}): void { this.{{ field.field_name }}[index] = value; }
{{~ else if field.kind == 'scalar_ref' ~}}
{{~ if field.reference_is_record ~}}
  public setReference_{{ field.prop_name }}_INTERNAL(value: {{ field.reference_setter_type }}) { this.{{ field.field_name }} = value; }
{{~ else ~}}
  public setReference_{{ field.prop_name }}_INTERNAL(value: {{ field.reference_setter_type }}) { this.{{ field.field_name }} = value }
{{~ end ~}}
{{~ end ~}}
{{~ end ~}}
{{~ end ~}}
{{~## Public rather than private: the enclosing table writes them as it reads, and
   the accessor writes the reference members as it resolves them. ##~}}

{{~ for field in fields ~}}
{{~ if field.kind == 'array_ref' ~}}
  public {{ field.field_name }}: {{ field.field_type }}[] = []
  public {{ field.field_name }}_{{ field.ref_table }}_index: {{ field.ref_key_type_name }}[] = []
{{~ else if field.kind == 'record_var_array' || field.kind == 'array_of_arrays' ~}}
{{~## Created with the record, not by the read. Each member column fills one property of
   each element, so there has to be an element there to fill - and a member whose column
   the file does not carry then holds its empty value rather than undefined.

   A trimmed group is the exception and starts empty: how long this row's array is only
   becomes known as it is read. ##~}}
  public {{ field.field_name }}: {{ field.field_type }}[] = {{ field.default_value }}
{{~ else if field.kind == 'var_array' ~}}
  public {{ field.field_name }}: {{ field.field_type }}[] = []
{{~ else if field.kind == 'scalar_ref' ~}}
  public {{ field.field_name }}: {{ field.field_type }}
  public {{ field.field_name }}_{{ field.ref_table }}_index: {{ field.ref_key_type_name }} = {{ field.ref_key_initial }}
{{~ else ~}}
  public {{ field.field_name }}: {{ field.field_type }} = {{ field.default_value }}
{{~ end ~}}
{{~ if field.is_nullable ~}}
{{~## False until a read says otherwise, so a file that does not carry the column leaves
   the member absent rather than claiming a value it never got. ##~}}
  public {{ field.presence_field }}: boolean = false
{{~ end ~}}
{{~ if field.has_optional_elements ~}}
  public {{ field.element_presence_field }}: boolean[] | null = null
{{~ end ~}}
{{~ end ~}}
{{~## One slot for the resolved row whatever table it came from, typed as the union of those
   tables' records, and the discriminator that says which. spec/references/multi-target-accessors.md. ##~}}

  /** Populate field values. */
  public populateFieldValues(dataRow: IDataRow): void {
{{~ for field in fields ~}}
    {{ field.from_named_row }}
{{~ end ~}}
  }

  /** Populate field values. */
  public populateFieldValuesCompact(dataRow: any[]): void {
    let offset = 0
{{~ for field in fields ~}}
{{~ for line in field.from_compact_row ~}}
    {{ line }}
{{~ end ~}}
{{~ end ~}}
  }
}

