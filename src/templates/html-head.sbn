<html lang="ko">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<style>
:root {
  --bg: #fff; --fg: #1f2328; --muted: #59636e; --faint: #818b98;
  --line: #d1d9e0; --line-soft: #eaeef2; --head-line: #dfe4ea; --head: #f6f8fa; --zebra: #fbfcfd;
  --hover: #fff8c5; --link: #0969da; --accent: #0969da;
  --num: #0a7c4a; --key: #0a7c4a; --type: #6639ba; --flag: #9a6700; --none: #a0a8b0;
  --str: #a31515; --bad: #cf222e; --good: #c8a200; --true: #1a7f37;
  --bar: #f6f8fa; --card: #f6f8fa; --shadow: rgba(31, 35, 40, .12);
  --thumb: #ced3d9; --thumb-hover: #aeb6c0;
  color-scheme: light;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --bg: #0d1117; --fg: #e6edf3; --muted: #9198a1; --faint: #6e7681;
    --line: #30363d; --line-soft: #21262d; --head-line: #2b3138; --head: #161b22; --zebra: #11161d;
    --hover: #2d2611; --link: #4493f8; --accent: #4493f8;
    --num: #3fb950; --key: #3fb950; --type: #d2a8ff; --flag: #d29922; --none: #545d68;
    --str: #ce9178; --bad: #f85149; --good: #ffd60a; --true: #3fb950;
    --bar: #161b22; --card: #161b22; --shadow: rgba(1, 4, 9, .8);
    --thumb: #30363d; --thumb-hover: #484f58;
    color-scheme: dark;
  }
}
:root[data-theme="dark"] {
  --bg: #0d1117; --fg: #e6edf3; --muted: #9198a1; --faint: #6e7681;
  --line: #30363d; --line-soft: #21262d; --head-line: #2b3138; --head: #161b22; --zebra: #11161d;
  --hover: #2d2611; --link: #4493f8; --accent: #4493f8;
  --num: #3fb950; --key: #3fb950; --type: #d2a8ff; --flag: #d29922; --none: #545d68;
  --str: #ce9178; --bad: #f85149; --good: #ffd60a; --true: #3fb950;
  --bar: #161b22; --card: #161b22; --shadow: rgba(1, 4, 9, .8);
  --thumb: #30363d; --thumb-hover: #484f58;
  color-scheme: dark;
}
* { box-sizing: border-box; }

/* One scrolling region per page, not two.

   The table used to scroll inside its box while the page scrolled too, and a sticky cell
   sticks to its own scrolling box - so as soon as the page moved down, the column names
   were pinned to a box edge that had gone up behind the bar, and the top rows of data
   went with them. The window is the frame now: the bar and the breadcrumb hold their
   place because nothing above them moves, and what scrolls is the one region that has
   more in it than fits. */
html, body { height: 100%; }
body { display: flex; flex-direction: column; overflow: hidden; }

/* A fragment jump scrolls its target to the top of its scroller. Room above it - and
   more of it for a row, whose scroller has the header stack pinned across the top. */
[id] { scroll-margin-top: 12px; }
tbody td[id] { scroll-margin-top: 96px; }
body {
  margin: 0; background: var(--bg); color: var(--fg);
  font: 14px/1.55 -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial,
        "Malgun Gothic", "Apple SD Gothic Neo", sans-serif;
}
a { color: var(--link); text-decoration: none; }
a:hover { text-decoration: underline; }
code { font-family: Consolas, "SF Mono", Menlo, monospace; font-size: 12px; }

/* ---- scrollbars. Thin and quiet, and the same in both themes: the platform default is
   a wide grey bar that reads as part of the page rather than part of the window. ---- */
* { scrollbar-width: thin; scrollbar-color: var(--thumb) transparent; }
::-webkit-scrollbar { width: 11px; height: 11px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb {
  background: var(--thumb); border-radius: 8px;
  border: 3px solid var(--bg); background-clip: padding-box;
}
::-webkit-scrollbar-thumb:hover { background: var(--thumb-hover); background-clip: padding-box; }
::-webkit-scrollbar-corner { background: transparent; }

/* ---- icons ---- */
.i {
  width: 14px; height: 14px; flex: 0 0 14px; vertical-align: -2px;
  fill: none; stroke: currentColor; stroke-width: 1.4;
  stroke-linecap: round; stroke-linejoin: round;
  color: var(--faint);
}
a .i, .side-list a .i { color: inherit; opacity: .75; }
h2 .i, h3 .i { color: var(--faint); margin-right: 4px; }
.entities .i, .bar .i { margin-right: 5px; }
td .i, th .i { margin-right: 4px; }

/* ---- top bar and breadcrumb ---- */
.bar {
  display: flex; align-items: center; gap: 18px; flex-wrap: wrap;
  flex: 0 0 auto; z-index: 5;
  padding: 8px 20px; background: var(--bar); border-bottom: 1px solid var(--line);
}
.brand { display: flex; align-items: center; gap: 7px; font-weight: 600; letter-spacing: .02em; }
.brand .mark { width: 18px; height: 18px; border-radius: 4px; display: block; }
.bar nav { display: flex; gap: 14px; flex-wrap: wrap; }
.bar nav a { color: var(--muted); display: inline-flex; align-items: center; }
.bar nav a.on { color: var(--fg); font-weight: 600; }
.bar nav a.on .i { color: var(--accent); opacity: 1; }
.theme {
  margin-left: auto; display: inline-flex; align-items: center; gap: 6px;
  padding: 3px 9px; font: inherit; font-size: 12px; cursor: pointer;
  color: var(--muted); background: var(--bg);
  border: 1px solid var(--line); border-radius: 6px;
}
.theme:hover { color: var(--fg); border-color: var(--thumb-hover); }
.theme .i { color: inherit; }
.crumbs { flex: 0 0 auto; padding: 8px 20px 0; color: var(--faint); font-size: 12px; }
.crumbs span + span::before { content: "/"; margin: 0 6px; color: var(--line); }

/* ---- page frame ---- */
.page {
  display: flex; align-items: stretch; gap: 24px; padding: 4px 20px 8px;
  flex: 1 1 auto; min-height: 0;
}

/* A page of prose and counters scrolls; a page that is one table does not - its table
   does, which is what keeps the column names on screen. `overflow` on the second is a
   backstop for a window too short to hold even the heading. */
main { min-width: 0; flex: 1 1 auto; overflow: auto; padding-bottom: 12px; }

/* The fill chain: main, the block holding the tools and the table, and the table's box -
   each a flex column that may shrink, so the box ends up exactly the height that is left
   and scrolls its rows inside that. `min-height` keeps it usable in a short window. */
main.fill { display: flex; flex-direction: column; overflow: hidden; }
main.fill [data-table] { display: flex; flex-direction: column; flex: 1 1 auto; min-height: 0; }
main.fill .scroll { flex: 0 1 auto; min-height: 90px; }
h1 { font-size: 21px; margin: 12px 0 2px; }
h2 { font-size: 16px; margin: 28px 0 10px; display: flex; align-items: center; }
h3 { font-size: 14px; margin: 0 0 6px; font-weight: 600; }
h2 .count { color: var(--faint); font-weight: 400; font-size: 12px; margin-left: 6px; }
.lead { color: var(--muted); margin: 0 0 4px; }
.comment { color: var(--muted); margin: 0 0 10px; white-space: pre-wrap; max-width: 90ch; }
.none { color: var(--none); font-style: italic; }

/* ---- sidebar ---- */
aside {
  width: 230px; flex: 0 0 230px; min-height: 0;
  display: flex; flex-direction: column; padding-top: 14px;
}
.side-head {
  display: flex; align-items: center; gap: 5px;
  font-size: 11px; letter-spacing: .02em;
  color: var(--faint); margin-bottom: 6px;
}
.side-list { list-style: none; margin: 6px 0 0; padding: 0 4px 0 0; overflow: auto; }
.side-list li { padding: 2px 0; }
.side-list a { color: var(--muted); display: flex; align-items: center; gap: 6px; }
.side-list li.on a { color: var(--fg); font-weight: 600; }
input[type=search] {
  width: 100%; padding: 5px 8px; font: inherit; font-size: 12px;
  color: var(--fg); background: var(--bg);
  border: 1px solid var(--line); border-radius: 6px;
}
input[type=search]:focus { outline: 2px solid var(--accent); outline-offset: -1px; }

/* ---- stat cards and distribution bars ---- */
.cards { display: flex; flex-wrap: wrap; gap: 10px; margin: 14px 0 4px; }
.card {
  display: block; background: var(--card); border: 1px solid var(--line-soft);
  border-radius: 8px; padding: 9px 14px; min-width: 116px; color: inherit;
}
/* The cards that go somewhere say so. Half of them are counters and half are doors, and
   they looked alike - a reader found out which by clicking. The arrow is the same mark the
   page puts on a reference, so it reads as "there is more this way" here too. */
a.card { position: relative; padding-right: 26px; }
a.card::after {
  content: "→"; position: absolute; top: 8px; right: 10px;
  font-size: 12px; color: var(--faint);
}
a.card:hover { border-color: var(--accent); text-decoration: none; }
a.card:hover::after { color: var(--accent); }
.card .n { font-size: 19px; font-weight: 600; }
.card .k {
  display: flex; align-items: center; gap: 4px; font-size: 11px; color: var(--faint);
  letter-spacing: .02em;
}
.dist {
  display: grid; grid-template-columns: 8.5em minmax(140px, 1fr) 4.5em;
  gap: 3px 10px; align-items: center; max-width: 620px;
}
.dist .k { display: flex; align-items: center; gap: 5px; color: var(--muted); font-size: 12px; }
.dist .v { color: var(--faint); font-size: 12px; text-align: right; }
.track { background: var(--line-soft); border-radius: 3px; height: 9px; }
.track div { background: var(--accent); border-radius: 3px; height: 9px; opacity: .75; }
.cols { display: flex; flex-wrap: wrap; gap: 24px 40px; align-items: flex-start; }

/* ---- lists ---- */
.entities { list-style: none; margin: 0; padding: 0; columns: 2; column-gap: 40px; }
.entities li { padding: 1px 0; break-inside: avoid; }
.entities .why { color: var(--muted); }

/* ---- tables ---- */
/* Wide enough for the table and no wider: a box stretched to the page around a narrow
   table reads as a table with empty columns.

   The height is capped so that the table scrolls inside this box rather than the page
   scrolling past it. That is what makes the header rows hold: a sticky cell sticks to its
   scrolling ancestor, and with no cap this box never scrolled - it just moved up with the
   page and took the column names with it, leaving a screen of values whose columns the
   reader had to scroll back up to name. */
.scroll {
  overflow: auto; width: fit-content; max-width: 100%;
  border: 1px solid var(--line); border-radius: 8px;
  overscroll-behavior: contain;
}
table { border-collapse: separate; border-spacing: 0; margin: 0; font-size: 13px; }
th, td {
  border-right: 1px solid var(--line-soft); border-bottom: 1px solid var(--line-soft);
  padding: 3px 9px; text-align: left; vertical-align: top; white-space: nowrap;
}
th:last-child, td:last-child { border-right: 0; }
/* The whole band is one sticky element, and that is what keeps its lines intact.
   Each header row used to stick on its own at an offset the page computed - 23px, 46px,
   69px - and at a device pixel ratio that is not a whole number a row's rendered height
   and its offset round differently. The rows then overlapped by a fraction: a line came
   out doubled where two edges landed together and gone where one covered another, and it
   changed as the table scrolled. Sticking `thead` instead makes the rows' edges internal
   to one painted box, so the arithmetic - and the whole class of problem - is gone. */
thead { position: sticky; top: 0; z-index: 2; }
thead th {
  background: var(--head); position: static;
  border-right: 1px solid var(--head-line);
  border-bottom: 1px solid var(--head-line);
}
/* The band's own edge is the one line that separates headings from values, so it is drawn
   in the grid's colour and the rows inside it in a lighter one. */
thead tr:last-child th { border-bottom: 1px solid var(--line); }
/* Every header row the same height. A row was as tall as its own text before, and the
   description row of a sheet with no column comments is empty. */
thead th { height: 23px; line-height: 17px; padding-top: 3px; padding-bottom: 3px; }
thead tr.names th { font-weight: 600; cursor: pointer; }
thead tr.names th.sorted::after { content: " \25B4"; color: var(--faint); }
thead tr.names th.sorted.desc::after { content: " \25BE"; }
thead tr.about th, thead tr.side th { font-weight: 400; color: var(--muted); font-size: 12px; }
thead tr.types th { font-weight: 400; }
tbody tr:nth-child(even) { background: var(--zebra); }
tbody tr:hover > td { background: var(--hover); }
tbody tr.out { display: none; }

/* The first column is the key, and a table 100 columns wide is read by scrolling
   sideways - which used to take the key off the screen. A sticky cell is painted over
   the ones it passes, so each state needs its own background rather than the row's.

   Scoped to a scrolling table. Unscoped, it also painted the first cell of the enum
   card's table, so a highlighted row in the card came out highlighted from its second
   cell onwards. */
.scroll thead th:first-child, .scroll tbody td:first-child { position: sticky; left: 0; }
.scroll thead th:first-child { z-index: 3; }
/* The same reason as the header: this cell is sticky sideways, so its right-hand line is
   painted from inside it.

   **And `z-index`, without which the cell held its place and lost the paint.** A positioned
   element left at `auto` is painted in document order, so every cell to the right of this one
   went over it: scrolling sideways drew the second column's values across the key, and the two
   texts sat on top of each other. Below the header's 3, because where the two meet the header
   is the one that has to win. */
.scroll tbody td:first-child {
  z-index: 2;
  background: var(--bg); border-right: 0; box-shadow: inset -1px 0 0 var(--line-soft);
}
.scroll tbody tr:nth-child(even) td:first-child { background: var(--zebra); }
.scroll tbody tr:hover > td:first-child { background: var(--hover); }

/* The row a reference pointed at, once the jump has landed on it. */
tbody td:target { box-shadow: inset 0 0 0 2px var(--accent); }
tbody tr:has(td:target) > td { background: var(--hover); }

/* A long value shows what fits and says there is more. The clip is on a span rather than
   on the cell because a table in auto layout may widen a cell past its own max-width, and
   then nothing is clipped at all. Clicking the cell lifts it. */
.clip {
  display: block; max-width: 46ch; overflow: hidden;
  text-overflow: ellipsis; white-space: nowrap;
}
/* A record entry: objects, with the member names quiet and the values not. Expanded, one
   object per line - a row of them on one line is what made the flat columns unreadable. */
td.record .clip { max-width: 60ch; }
/* The member names are in the markup so the panel can print them, and out of the cell
   because a tuple of three values beside a hundred rows of them is what fits. */
/* A workbook's file name beside a sheet's: quieter, so the pair reads as one location
   rather than as two columns crammed into one. */
/* A column whose keys name rows that are not there. In the flag colour rather than the
   `?` grey: the `?` on a type is the schema allowing an empty cell, and this is the data
   being wrong. */
.broken { color: var(--flag); font-size: 11px; white-space: nowrap; }
.book { color: var(--muted); }
.mem { color: var(--faint); }
td.record .mem, td.record .msep { display: none; }
th /* A workbook's file name beside a sheet's: quieter, so the pair reads as one location
   rather than as two columns crammed into one. */
/* A column whose keys name rows that are not there. In the flag colour rather than the
   `?` grey: the `?` on a type is the schema allowing an empty cell, and this is the data
   being wrong. */
.broken { color: var(--flag); font-size: 11px; white-space: nowrap; }
.book { color: var(--muted); }
.mem { color: var(--faint); }
.obj { white-space: nowrap; }
td.record.open .obj { display: block; }
td.record.open .clip { max-width: 80ch; white-space: normal; }
td.text { cursor: pointer; }
td.text.open .clip { max-width: 72ch; white-space: normal; overflow: visible; }

/* Everything left aligned, headings and values alike. A column of right-aligned numbers
   beside a column of left-aligned text puts a ragged gap down the middle of a table whose
   columns are read across, not summed. */
.num { color: var(--num); }
.key code { color: var(--key); }
.enum { white-space: nowrap; }
.type { color: var(--type); }
/* The column a row is found by. Marked on the type, where the question "which one is the
   key" comes up. */
.keymark { font-size: 11px; }
/* A column whose sheet names the tables its value belongs to, without that being a
   resolved reference. Quieter than a reference, because it is a declaration. */
.declared { color: var(--faint); }
.declared a { color: var(--muted); }
.flag { color: var(--flag); }
.sep { color: var(--faint); }
/* No value, spelled the way a database grid spells it - and the only thing on the page in
   italic, so it is never read as a value. An empty string and an empty array are values, so
   they are upright. */
.null { color: var(--none); font-style: italic; }
.empty { color: var(--none); }
/* A string literal, coloured the way an editor colours one - quotes included, since the
   quotes are part of the literal. It reads as a value of a kind rather than as text that
   happens to be in a cell, which is the same reason numbers and enums have their own. */
.str { color: var(--str); }
/* True and false differ in shape first and colour second. In one shape and two colours a
   column of `false` still reads as ticked - the eye takes the silhouette and not the hue.

   The tick used to be `--good`, which is the amber this page uses for a flag: on the light
   theme that is a yellow glyph on white, and a column of them was the hardest thing on the
   page to pick out. Green rather than amber, a size up and a weight up - a tick is a mark
   rather than a letter, so it can afford both. `--true` is its own token because `--num` is
   also green and the two are set separately per theme. */
.yes, .no { font-weight: 700; font-size: 15px; line-height: 1; }
.yes { color: var(--true); }
.no { color: var(--bad); }
.n-of { color: var(--faint); font-size: 11px; margin-left: 4px; }
/* A bit pattern, coloured as the number it is. Monospace because the digits of a pattern are
   read by position, and a proportional font puts the same nibble at a different offset on
   every row. */
.bits { color: var(--num); font-family: Consolas, "SF Mono", Menlo, monospace; }
/* A member the row's variant does not declare.

   Upright, because italic on this page means a value is absent and this is not an absence -
   the member is not part of what this row is. And dotted underneath, because a dash and an
   italic `null` differ by too little for a reader who has not been told: the underline says
   there is something to hover, and the page carries a line saying what. */
.na { color: var(--none); border-bottom: 1px dotted var(--none); cursor: help; }
/* The variants that declare a member, beside its type in the header. Smaller than the type and
   in the flag colour, so a type row of a wide union still reads as types first. */
.of { color: var(--flag); font-size: 11px; }
a.variant { color: var(--flag); }
/* A colour, drawn. Its own border rather than none, so white on the light theme and black on
   the dark one are still squares and not gaps. The colour itself is an inline style: a page
   cannot carry a rule per colour a workbook holds. */
.swatch {
  display: inline-block; width: 11px; height: 11px; border-radius: 3px;
  border: 1px solid var(--line); margin-right: 6px; vertical-align: -1px;
}
.tools { display: flex; align-items: center; gap: 12px; margin: 0 0 8px; flex-wrap: wrap; }
.tools input[type=search] { width: 260px; }
.hint { color: var(--faint); font-size: 12px; }
.warn {
  color: var(--flag); background: var(--card); border: 1px solid var(--line-soft);
  border-radius: 6px; padding: 5px 10px; font-size: 12px; margin: 0;
}
/* ---- the enum card, built by the script from the definitions at the foot ---- */
#enumcard p { margin: 0 0 6px; }
#enumcard table { font-size: 12px; }
#enumcard tbody tr { background: none; }
#enumcard td {
  border: 0; padding: 2px 10px 2px 0; white-space: nowrap;
  border-radius: 0;
}
#enumcard td:first-child { padding-left: 6px; border-radius: 4px 0 0 4px; }
#enumcard td:last-child { padding-right: 8px; border-radius: 0 4px 4px 0; }
#enumcard tbody tr:hover > td { background: none; }
#enumcard tr.on td { background: var(--hover); font-weight: 600; color: var(--fg); }
/* Narrower than the window, always. An enum with long label comments made the card wider
   than the screen, and a card placed by its left edge then sat off it entirely. */
/* A width that does not depend on where the panel is placed. Without it the panel is
   shrink-to-fit against whatever room is left to the right, so a cell near the edge got a
   panel one character wide. */
#enumcard { width: max-content; max-width: min(560px, 92vw); }
/* The same panel holding a value rather than an enum: it wraps, and it keeps whatever
   line breaks the cell had. */
#enumcard.wrap { white-space: pre-wrap; word-break: break-word; color: var(--fg); }
#enumcard.code { font-family: Consolas, "SF Mono", Menlo, monospace; font-size: 12px; }
#enumcard td:last-child { white-space: normal; }

/* ---- a declared type: what every variant carries, and what one of them may be ----

   The two were an `h2` and a run of `h3`s with a small table under each, and at 41 variants
   that is a wall: every heading the same weight as the last, every table its own width, and
   nothing saying which of them hang off which. What the declaration says is a relationship,
   and the page was not drawing one.

   So the base is a panel and the variants are cards on a rail that runs down from it. The
   rail is one border on the container - a reader follows it from the shared members to the
   list of shapes - and each card has its own edge, so where one variant ends and the next
   begins is a line rather than a guess. */
.base {
  border: 1px solid var(--line); border-left: 3px solid var(--accent);
  border-radius: 8px; background: var(--card); padding: 12px 14px; margin: 0 0 6px;
}
.base > :first-child { margin-top: 0; }
.base > :last-child { margin-bottom: 0; }
.base table { background: var(--bg); }

/* The rail. Indented so the cards sit under the panel above them rather than beside it. */
.variants { margin: 0 0 0 14px; padding: 14px 0 2px 20px; border-left: 2px solid var(--line); }
.variant {
  position: relative;
  border: 1px solid var(--line); border-radius: 8px;
  padding: 10px 12px; margin: 0 0 12px;
}
/* A stub from the rail to the card, so the two read as joined rather than merely near. */
.variant::before {
  content: ""; position: absolute; left: -20px; top: 18px;
  width: 18px; border-top: 2px solid var(--line);
}
.variant > h3 { margin: 0 0 8px; display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
.variant .tag {
  font-size: 11px; font-weight: 400; color: var(--muted);
  padding: 1px 7px; border: 1px solid var(--line); border-radius: 999px;
}
.variant .none { margin: 0; }
.variant table { width: auto; min-width: 340px; }

/* The variant names as one row of chips, for a type with dozens of them: the page is
   otherwise a scroll with no way to see what is on it. */
.chips { display: flex; flex-wrap: wrap; gap: 6px; margin: 0 0 14px; }
.chips a {
  font-size: 12px; padding: 2px 9px; border-radius: 999px;
  border: 1px solid var(--line); color: var(--muted);
}
.chips a:hover { color: var(--fg); border-color: var(--accent); text-decoration: none; }

/* ---- the reference graph ---- */
.graph { display: block; background: var(--bg); }
/* The drawing is taller than a window at a few hundred tables, and scrolling it inside its
   own box means the rest of the page is not repainted with it. */
/* The drawing is moved around rather than scrolled: the viewport is a window of a fixed
   size and the drawing inside it is panned and zoomed, so nothing depends on the layout
   being smaller than the page. */
.viewport {
  height: 58vh; min-height: 260px; overflow: hidden;
  border: 1px solid var(--line); border-radius: 8px; background: var(--bg);
}
/* The list that drives the drawing sits beside it. Under it, choosing a table meant
   scrolling to the list, choosing, and scrolling back to see what changed - and on a tall
   drawing the two were never on screen together. The drawing sets the row's height and the
   list stretches to it, scrolling its own rows inside. */
.graphrow {
  display: flex; align-items: stretch; gap: 14px; min-width: 0;
  /* A definite height, because both columns are sized from it: without one the row is as
     tall as the longer column's content, which is a list of every table in the model. */
  height: 66vh; min-height: 320px;
}
.graphrow > * { min-height: 0; }
.graphrow .viewport { height: auto; flex: 1 1 auto; min-height: 0; }
.graphrow > .picker {
  flex: 0 0 clamp(240px, 26%, 330px); min-width: 0;
  display: flex; flex-direction: column;
}
/* Tighter cells, because four columns in a 240px box is what this list is. */
.graphrow .picker th, .graphrow .picker td { padding-left: 6px; padding-right: 6px; }
.graphrow > .stage { flex: 1 1 auto; min-width: 0; display: flex; flex-direction: column; }
.graphrow h2 { margin-top: 0; }
.graphrow .picker [data-table] { display: flex; flex-direction: column; flex: 1 1 auto; min-height: 0; }
.graphrow .picker .scroll { flex: 1 1 auto; min-height: 0; width: 100%; }
.graphrow .picker table { width: 100%; }
.graphrow .picker input[type=search] { width: 100%; }
.graphrow .picker .tools { gap: 6px; }
/* The two drawings take turns, and this rule is what makes them.

   `hidden` is an HTML content attribute and the browser's own stylesheet does not apply it to
   an SVG element, so setting it on a group did nothing at all. The whole graph stayed on
   screen underneath the one-table drawing: the neighbourhood is laid out from its own origin
   and the viewport is then fitted to it, so a reader who clicked a table got two pictures over
   each other at two scales, with the selected table apparently in a place of its own. */
.graph [hidden] { display: none; }
.viewport .graph { cursor: grab; touch-action: none; }
.viewport .graph.dragging { cursor: grabbing; }
.tools .grow { flex: 1 1 auto; }
.tools button {
  padding: 3px 10px; font: inherit; font-size: 12px; cursor: pointer;
  color: var(--muted); background: var(--bg);
  border: 1px solid var(--line); border-radius: 6px;
}
.tools button:hover { color: var(--fg); border-color: var(--thumb-hover); }
.graph .edge { fill: none; stroke: var(--faint); stroke-width: 1.3; opacity: .75; }
.graph:not(.plain) .edge:hover { stroke: var(--accent); stroke-width: 2; }
/* The neighbourhood drawing: one table, what points at it, what it points at. */
.graph .glyph { fill: var(--faint); font-size: 11px; }
.graph .node { cursor: pointer; }
/* The button that draws a table. The row draws it too, but a row that is clickable in one
   place and a link in another says neither - so the thing to click is a thing. */
td.pick, th.pick { width: 1px; padding-right: 4px; text-align: center; }
td.pick button {
  display: block; padding: 0; border: 0; background: none; cursor: pointer;
  color: var(--faint); line-height: 0;
}
td.pick button:hover { color: var(--accent); }
tbody tr.picked td.pick button { color: var(--accent); }
tbody tr.picked > td { background: var(--hover); }
tbody tr.picked > td:first-child { background: var(--hover); }
tbody [data-pick] { cursor: pointer; }
.graph .edge.self { stroke-dasharray: 3 3; }
.graph .head { fill: var(--faint); stroke: none; }
.graph .node rect { fill: var(--card); stroke: var(--line); }
.graph .node text { fill: var(--fg); font-size: 12px; }
.graph a:hover .node rect { stroke: var(--accent); fill: var(--hover); }
/* One table's own edges, when a few hundred of them overlap in the middle.
   The whole set is dimmed by one property on one group - which the compositor can do
   without redrawing the curves - and the few that matter are drawn again above it. */
.graph #edges { opacity: 1; }
.graph #edges.quiet .edge { pointer-events: none; }
.graph #all.focused #edges { opacity: .07; }
.graph #lit path { fill: none; stroke: var(--accent); stroke-width: 1.8; pointer-events: none; }
.graph .node.hit rect { stroke: var(--accent); stroke-width: 1.8; }
/* A box that is one step away, and the arrow that says so. */
.graph .node.walk:hover rect { stroke: var(--accent); fill: var(--hover); }
.graph .node .go { fill: var(--faint); font-size: 12px; }
.graph .node.walk:hover .go { fill: var(--accent); }
.graph .node.near rect { stroke: var(--accent); }

.foot {
  flex: 0 0 auto; color: var(--faint); font-size: 12px;
  padding: 0 20px 10px; text-align: right;
}
@media (max-width: 900px) {
  html, body { height: auto; }
  body { display: block; overflow: auto; }
  .page { display: block; }
  aside { width: auto; margin-bottom: 20px; }
  main.fill { display: block; }
  main.fill .scroll { max-height: 70vh; }
  .graphrow { display: block; height: auto; }
  .graphrow .viewport { height: 58vh; }
  .graphrow > .picker .scroll { max-height: 40vh; margin-bottom: 18px; }
  .entities { columns: 1; }
}
</style>
<link rel="icon" type="image/png" href="data:image/png;base64,">
<script>
/* The stored theme, before the first paint. Applied after it is a flash of the other one. */
(function () {
  try {
    var chosen = localStorage.getItem("tabbit-theme");
    if (chosen === "light" || chosen === "dark")
      document.documentElement.setAttribute("data-theme", chosen);
  } catch (unavailable) { /* private mode, a file url with storage off - the theme follows the system */ }
})();
</script>
</head>
<body>
<svg width="0" height="0" aria-hidden="true" style="position: absolute">
<symbol id="i-overview" viewBox="0 0 16 16"><path d="M3 13.2V8.4M8 13.2V2.8M13 13.2V6.2"/></symbol>
<symbol id="i-table" viewBox="0 0 16 16"><rect x="2.2" y="3.2" width="11.6" height="9.6" rx="1.4"/><path d="M2.2 6.4h11.6M6.4 6.4v6.4"/></symbol>
<symbol id="i-column" viewBox="0 0 16 16"><rect x="2.2" y="3.2" width="11.6" height="9.6" rx="1.4"/><rect x="6.3" y="3.2" width="3.4" height="9.6" fill="currentColor" stroke="none" opacity=".28"/></symbol>
<symbol id="i-enum" viewBox="0 0 16 16"><path d="M6.2 2.8h-1A1.5 1.5 0 0 0 3.7 4.3v2.2A1.5 1.5 0 0 1 2.2 8a1.5 1.5 0 0 1 1.5 1.5v2.2a1.5 1.5 0 0 0 1.5 1.5h1M9.8 2.8h1a1.5 1.5 0 0 1 1.5 1.5v2.2A1.5 1.5 0 0 0 13.8 8a1.5 1.5 0 0 0-1.5 1.5v2.2a1.5 1.5 0 0 1-1.5 1.5h-1"/></symbol>
<symbol id="i-const" viewBox="0 0 16 16"><circle cx="8" cy="8" r="5.6"/><path d="M5.6 6.7h4.8M5.6 9.3h4.8"/></symbol>
{{~## A block with two shapes branching out of it: one declaration, several variants. ##~}}
<symbol id="i-struct" viewBox="0 0 16 16"><rect x="1.6" y="6.2" width="4.4" height="3.6" rx="1"/><rect x="10" y="2.6" width="4.4" height="3.6" rx="1"/><rect x="10" y="9.8" width="4.4" height="3.6" rx="1"/><path d="M6 8h2.1V4.4H10M8.1 8v3.6H10"/></symbol>
<symbol id="i-workbook" viewBox="0 0 16 16"><path d="M3.2 3.9A1.7 1.7 0 0 1 4.9 2.2h7.4a.8.8 0 0 1 .8.8v10a.8.8 0 0 1-.8.8H4.9a1.7 1.7 0 0 1-1.7-1.7z"/><path d="M6.3 2.2v11.6"/></symbol>
<symbol id="i-sheet" viewBox="0 0 16 16"><path d="M4.3 2.4h4.6l3.3 3.3v7.1a.8.8 0 0 1-.8.8H4.3a.8.8 0 0 1-.8-.8V3.2a.8.8 0 0 1 .8-.8z"/><path d="M8.7 2.4v3.4h3.5"/></symbol>
<symbol id="i-key" viewBox="0 0 16 16"><circle cx="5.4" cy="5.4" r="2.7"/><path d="M7.3 7.3l5.9 5.9M11.1 11.2l1.3 1.3M9.2 9.3l1.3 1.3"/></symbol>
<symbol id="i-graph" viewBox="0 0 16 16"><circle cx="3.6" cy="8" r="1.9"/><circle cx="12.4" cy="4.4" r="1.9"/><circle cx="12.4" cy="11.6" r="1.9"/><path d="M5.3 7.2l5.4-2.1M5.3 8.8l5.4 2.1"/></symbol>
<symbol id="i-sun" viewBox="0 0 16 16"><circle cx="8" cy="8" r="3.1"/><path d="M8 1.4v1.5M8 13.1v1.5M1.4 8h1.5M13.1 8h1.5M3.3 3.3l1.1 1.1M11.6 11.6l1.1 1.1M12.7 3.3l-1.1 1.1M4.4 11.6l-1.1 1.1"/></symbol>
<symbol id="i-moon" viewBox="0 0 16 16"><path d="M13.2 9.6A5.6 5.6 0 0 1 6.4 2.8a5.6 5.6 0 1 0 6.8 6.8z"/></symbol>
<symbol id="i-auto" viewBox="0 0 16 16"><circle cx="8" cy="8" r="5.6"/><path d="M8 2.4a5.6 5.6 0 0 1 0 11.2z" fill="currentColor" stroke="none"/></symbol>
</svg>
<header class="bar">
<span class="brand"><img class="mark" src="data:image/png;base64," alt="" width="18" height="18">Tabbit</span>
<nav>
<a href="{{ root }}index.html"{{ if kind == 'index' }} class="on"{{ end }}><svg class="i"><use href="#i-overview"></use></svg>개요</a>
<a href="{{ root }}tables.html"{{ if kind == 'tables' }} class="on"{{ end }}><svg class="i"><use href="#i-table"></use></svg>테이블</a>
<a href="{{ root }}fields.html"{{ if kind == 'fields' }} class="on"{{ end }}><svg class="i"><use href="#i-column"></use></svg>컬럼</a>
<a href="{{ root }}references.html"{{ if kind == 'references' }} class="on"{{ end }}><svg class="i"><use href="#i-graph"></use></svg>참조</a>
<a href="{{ root }}enums.html"{{ if kind == 'enums' }} class="on"{{ end }}><svg class="i"><use href="#i-enum"></use></svg>enum</a>
<a href="{{ root }}structs.html"{{ if kind == 'structs' }} class="on"{{ end }}><svg class="i"><use href="#i-struct"></use></svg>구조체</a>
<a href="{{ root }}constantsets.html"{{ if kind == 'constantsets' }} class="on"{{ end }}><svg class="i"><use href="#i-const"></use></svg>상수 세트</a>
</nav>
<button class="theme" type="button" data-theme-cycle title="테마: 시스템 설정을 따릅니다">
<svg class="i"><use href="#i-auto"></use></svg><span data-theme-name>시스템</span>
</button>
</header>
<p class="crumbs">
{{~ for crumb in breadcrumb ~}}
{{~ if crumb.href != '' ~}}
<span><a href="{{ crumb.href }}">{{ crumb.text }}</a></span>
{{~ else ~}}
<span>{{ crumb.text }}</span>
{{~ end ~}}
{{~ end ~}}
</p>
<div class="page">
{{~ if side_items | array.size > 0 ~}}
<aside>
<div class="side-head"><svg class="i"><use href="#{{ side_icon }}"></use></svg>{{ side_title }}</div>
<input type="search" data-filter="side" placeholder="이름 필터">
<ul class="side-list">
{{~ for item in side_items ~}}
<li{{ if item.current }} class="on"{{ end }}><a href="{{ item.href }}"><svg class="i"><use href="#{{ side_icon }}"></use></svg>{{ item.name }}</a></li>
{{~ end ~}}
</ul>
</aside>
{{~ end ~}}
<main{{ if main_fills }} class="fill"{{ end }}>
<h1>{{ title }}</h1>
