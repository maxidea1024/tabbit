{{~## The accessor, holding no table's own code. ##~}}
{{ include 'python-file-head.sbn' ~}}
class {{ accessor_name }}:
    """Every table, loaded together so cross-table references can be resolved."""

    __slots__ = ({{ accessor.slot_names }})

    #: The key the table files were sealed with, or None when they were not sealed.
    #:
    #: On the class rather than an argument to every read, because it is one decision the
    #: consuming project makes once, at start-up, before the first table is read - set it
    #: with `{{ accessor_name }}.encryption_key = key`. A key threaded through every read signature would
    #: be the same value written out at every call site, and every call site is somewhere it
    #: could be wrong.
    #:
    #: Thirty-two bytes, the key the converter was given. None - the default - is a project
    #: that does not encrypt, and it costs that project nothing: the load path opens the
    #: envelope either way, and a file that is not encrypted comes back from that unchanged.
    #: A project that does encrypt and leaves this None gets the reader's own message saying
    #: the file is encrypted and no key was given, rather than a failure somewhere inside the
    #: format.
    #:
    #: Where the key comes from is the one thing about this layer worth being careful with.
    #: It is a secret only until it reaches a repository, a build log or an issue, and it
    #: cannot be taken back afterwards - so it is read at start-up from wherever this project
    #: keeps secrets, not written into a source file. What the layer is for, and therefore
    #: what is and is not worth defending, is spec/tcb-v104-composed-encodings.md section 4.
    encryption_key = None

    #: The key the table files were signed with, or None when they were not signed.
    #:
    #: A different key from `encryption_key` and independent of it: a file can be signed
    #: without being encrypted, and encrypted without being signed.
    #:
    #: What it buys is the thing encryption does not. The cipher is a keystream XOR, so a bit
    #: flipped in the file is a bit flipped in the value it decrypts to - no key needed - and
    #: every structural check the format makes still passes, because a four-byte float
    #: accepts any four bytes. With this set, a file altered after export stops loading.
    #:
    #: Setting it makes the reader stricter in a second way: a file that carries no MAC is
    #: refused, because otherwise the check could be removed by zeroing sixteen bytes. So the
    #: order to turn this on in is data first, key second. spec/tcb-mac-and-signature.md.
    mac_key = None

    #: Whether to check the MAC at all. True by default.
    #:
    #: For tools that read exported files without the key, and for measuring what the check
    #: costs at load. It is not a security boundary - anyone who can flip a flag in a shipped
    #: build can read `mac_key` out of the same build.
    verify_mac = True

    def __init__(self):
{{~ if accessor.tables | array.size == 0 ~}}
        pass
{{~ end ~}}
{{~ for slot in accessor.tables ~}}
        self.{{ slot.name }} = {{ slot.table_name }}()
{{~ end ~}}

    def read_all(self, base_path, file_extension="{{ accessor.file_extension }}"):
        """Reads every table from base_path, then links the references between them.

        file_extension defaults to what the recipe told the exporter to write. Pass a
        different one when the data files were renamed after export.

        Safe to call on a loaded accessor. Every file is read into a table of its own and
        the references are linked among those, so a failure part way through leaves every
        table holding the load it already had, and no row points at a row from it.
        """
{{~ if accessor.tables | array.size == 0 ~}}
        return
{{~ end ~}}
{{~ for slot in accessor.tables ~}}
        loaded_{{ slot.name }} = {{ slot.table_name }}()
        loaded_{{ slot.name }}.read(os.path.join(base_path, "{{ slot.data_file_name }}" + file_extension))
{{~ end ~}}
{{~ if accessor.tables | array.size > 0 }}
        self._solve_cross_references({{ for slot in accessor.tables }}{{ if !for.first }}, {{ end }}loaded_{{ slot.name }}{{ end }})

{{~ for slot in accessor.tables ~}}
        self.{{ slot.name }} = loaded_{{ slot.name }}
{{~ end ~}}
{{~ end ~}}

    def _solve_cross_references(self{{ for slot in accessor.tables }}, {{ slot.name }}{{ end }}):
        """Turns the stored indices into usable values, once every table is in memory.

        The tables arrive as arguments rather than off self, which is how this resolves the
        load being read rather than the one already published.
        """
{{~ if accessor.cross_references | array.size == 0 ~}}
        # No table references another.
        return
{{~ else ~}}
{{~ for reference in accessor.cross_references ~}}
        for record in {{ reference.table }}.records:
{{~ for field in reference.fields ~}}
{{~ if field.is_array ~}}
            for position, index in enumerate(record.{{ field.name }}_index):
                target = {{ field.ref_table }}.{{ field.ref_lookup }}(index)
                if target is not None:
                    record.{{ field.name }}[position] = {{ field.value }}
{{~ else ~}}
            target = {{ field.ref_table }}.{{ field.ref_lookup }}(record.{{ field.name }}_index)
            if target is not None:
                record.{{ field.name }} = {{ field.value }}
{{~ end ~}}
{{~ end ~}}
{{~## A reference that is a member of a record resolves inside the element, so the list is
   walked and each element's own key is looked up. Which list that is - the group's or the
   member's - the view decided, and a record of one has neither.
   spec/references-in-records.md. ##~}}
{{~ for member in reference.record_fields ~}}
{{~ if member.range != '' ~}}
            for i in {{ member.range }}:
                target = {{ member.ref_table }}.{{ member.ref_lookup }}({{ member.key }})
                if target is not None:
                    {{ member.access }} = target
{{~ else ~}}
            target = {{ member.ref_table }}.{{ member.ref_lookup }}({{ member.key }})
            if target is not None:
                {{ member.access }} = target
{{~ end ~}}
{{~ end ~}}
{{~## A column reaching several tables is looked up in each of them in the order they were
   named, stopping at the first that has the key. The tables take separate id bands - an id in
   two of them is refused at conversion - so the order only decides which lookup runs.

   Guarded on the key being set, which the single-target linking above does not do. It has to
   be: the discriminator is a value a consumer reads, so a language that resolved a zero where
   another did not would answer a different table for the same row.
   spec/multi-target-accessors.md. ##~}}
{{~ for ref in reference.multi_fields ~}}
            if record.{{ ref.key_member }} {{ ref.key_is_set }}:
{{~ for target in ref.targets ~}}
                if record.{{ ref.target_member }} == {{ ref.target_type_name }}.{{ ref.none_label }}:
                    target = {{ target.table }}.{{ target.lookup }}(record.{{ ref.key_member }})
                    if target is not None:
                        record.{{ ref.slot_member }} = target
                        record.{{ ref.target_member }} = {{ ref.target_type_name }}.{{ target.label }}
{{~ end ~}}
{{~ end ~}}
{{~ end ~}}
{{~ end ~}}
