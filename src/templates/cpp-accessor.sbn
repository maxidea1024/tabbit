{{~## The accessor, holding no table's own code. ##~}}
{{ include 'cpp-file-head.sbn' ~}}
/// Every table, loaded together so cross-table references can be resolved.
class {{ accessor_name }} {
 public:
{{~ for slot in accessor.tables ~}}
  const {{ slot.table_name }}& {{ slot.name }}() const { return {{ slot.name }}_; }
{{~ end ~}}

  /// Reads every table from `base_path`, then links the references between them.
  ///
  /// Safe to call on a loaded accessor. Every file is read into a table of its own and the
  /// references are linked among those, so a read that throws part way through leaves every
  /// table holding the load it already had, and no row points at a row from it.
  void read_all(const std::string& base_path, const std::string& file_extension = "{{ accessor.file_extension }}") {
{{~ if accessor.tables | array.size == 0 ~}}
    (void)base_path;
    (void)file_extension;
{{~ else ~}}
{{~ for slot in accessor.tables ~}}
    {{ slot.table_name }} loaded_{{ slot.name }};
    loaded_{{ slot.name }}.read(base_path + "/{{ slot.data_file_name }}" + file_extension);
{{~ end ~}}

    solve_cross_references({{ for slot in accessor.tables }}{{ if !for.first }}, {{ end }}loaded_{{ slot.name }}{{ end }});

{{~ for slot in accessor.tables ~}}
    {{ slot.name }}_ = std::move(loaded_{{ slot.name }});
{{~ end ~}}
{{~ end ~}}
  }

 private:
  /// The tables arrive as arguments, which is how this links the load being read rather
  /// than the one already published.
  ///
  /// Every table is passed whether or not it takes part in a reference, so the call site
  /// is the same shape for every model. `[[maybe_unused]]` is what says so to the
  /// compiler: the gate builds with `-Wextra -Werror`, and a model where nothing
  /// references anything - which is most of them - otherwise fails to compile on the
  /// unused parameters.
  void solve_cross_references({{ for slot in accessor.tables }}{{ if !for.first }}, {{ end }}[[maybe_unused]] {{ slot.table_name }}& loaded_{{ slot.name }}{{ end }}) {
{{~ if accessor.cross_references | array.size == 0 ~}}
    // No table references another.
{{~ else ~}}
{{~ for reference in accessor.cross_references ~}}
    for (auto& record : loaded_{{ reference.table }}.records_) {
{{~ for field in reference.fields ~}}
{{~ if field.is_array ~}}
      record.{{ field.name }}.resize(record.{{ field.name }}_index.size(), {{ field.ref_default }});
      for (std::size_t i = 0; i < record.{{ field.name }}_index.size(); ++i) {
        const auto* target = loaded_{{ field.ref_table }}.{{ field.ref_lookup }}(record.{{ field.name }}_index[i]);
        if (target != nullptr) record.{{ field.name }}[i] = {{ field.value }};
      }
{{~ else ~}}
      {
        const auto* target = loaded_{{ field.ref_table }}.{{ field.ref_lookup }}(record.{{ field.name }}_index);
        if (target != nullptr) record.{{ field.name }} = {{ field.value }};
      }
{{~ end ~}}
{{~ end ~}}
{{~## A reference that is a member of a record resolves inside the element, so the vector is
   walked and each element's own key is looked up. Which vector that is - the group's or the
   member's - the view decided, and a record of one has neither.
   spec/references-in-records.md. ##~}}
{{~ for member in reference.record_fields ~}}
{{~ if member.count != '' ~}}
      for (std::size_t i = 0; i < {{ member.count }}; ++i) {
        const auto* target = loaded_{{ member.ref_table }}.{{ member.ref_lookup }}({{ member.key }});
        if (target != nullptr) {{ member.access }} = target;
      }
{{~ else ~}}
      {
        const auto* target = loaded_{{ member.ref_table }}.{{ member.ref_lookup }}({{ member.key }});
        if (target != nullptr) {{ member.access }} = target;
      }
{{~ end ~}}
{{~ end ~}}
{{~## A column reaching several tables is looked up in each of them in the order they were
   named, stopping at the first that has the key. The tables take separate id bands - an id in
   two of them is refused at conversion - so the order only decides which lookup runs.
   spec/multi-target-accessors.md. ##~}}
{{~ for ref in reference.multi_fields ~}}
      if (record.{{ ref.key_member }} {{ ref.key_is_set }}) {
{{~ for target in ref.targets ~}}
        if (record.{{ ref.target_member }} == {{ ref.target_type_name }}::{{ ref.none_label }}) {
          const auto* found = loaded_{{ target.table }}.{{ target.lookup }}(record.{{ ref.key_member }});
          if (found != nullptr) {
            record.{{ ref.slot_member }} = found;
            record.{{ ref.target_member }} = {{ ref.target_type_name }}::{{ target.label }};
          }
        }
{{~ end ~}}
      }
{{~ end ~}}
    }
{{~ end ~}}
{{~ end ~}}
  }

{{~ for slot in accessor.tables ~}}
  {{ slot.table_name }} {{ slot.name }}_;
{{~ end ~}}
};
{{ include 'cpp-file-foot.sbn' ~}}
