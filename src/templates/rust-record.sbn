{{~##
   One declared record type, and the levels inside it that are its own.

   **A struct is an entity beside a table and an enum, so it gets a module like one.** The
   declaration says "this is one type", and the generated code says the same thing only if
   there is one type - and the modules are re-exported side by side, so a type declared per
   table would be the same path exported twice.
   spec/types/declared-struct-identity.md.
##~}}
{{ include 'rust-file-head.sbn' ~}}
{{~ for rt in record.types }}
{{~ if rt.is_outermost ~}}
{{~ if record.comment | array.size > 0 ~}}
{{~ for line in record.comment ~}}
/// {{ line }}
{{~ end ~}}
{{~ else ~}}
/// One value of the declaration that names it.
{{~ end ~}}
{{~ else ~}}
/// A record inside [`{{ record.name }}`].
{{~ end ~}}
#[derive(Clone, Debug, Default)]
pub struct {{ rt.type_name }} {
{{~ for member in rt.members ~}}
{{~ for line in member.comment ~}}
    /// {{ line }}
{{~ end ~}}
    pub {{ member.declaration }}
{{~ end ~}}
{{~ for line in rt.lookups ~}}
    {{ line }}
{{~ end ~}}
}
{{~ end ~}}
