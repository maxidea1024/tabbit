{{~##
   The reference graph, in the form its size allows.

   A model whose graph fits is drawn whole: layers left to right, a table one layer right
   of everything that points at it, curves with arrowheads. It can be panned and zoomed,
   and clicking a table narrows the picture to that table alone.

   A model with a few hundred tables is not drawn whole, and the reason is what it looks
   like: 323 tables fitted to a window is a grey smear with two-pixel labels. It reads as
   a picture and answers nothing. That page offers the two things that do read at any size
   - how many tables sit in each layer, which is the shape of the thing, and one table's
   own references, which is the question a reader arrives with.

   Both forms are plain SVG the page owns: nothing is fetched, and the layout is the same
   every run - which a force-directed one would not be.
##~}}
{{~ include 'html-head.sbn' ~}}
{{~ if degrees | array.size == 0 ~}}
<p class="lead">참조가 하나도 없습니다.</p>
<p class="none">다른 테이블을 가리키는 테이블이 없습니다.</p>
{{~ else ~}}
{{~ if detailed ~}}
<p class="lead">그래프의 테이블 {{ nodes | array.size }}개 · 참조 {{ edge_count }}개. 끌어서 이동하고, 휠로 확대하고, 테이블을 누르면 그 테이블의 참조만 봅니다.</p>
{{~ else ~}}
<p class="lead">그래프의 테이블 {{ degrees | array.size }}개 · 참조 {{ edge_count }}개. 이 규모에서는 한 장에 다 그리면 읽히지 않으므로, 층의 크기와 한 테이블의 참조로 보여줍니다.</p>

<h2><svg class="i"><use href="#i-graph"></use></svg>한 테이블의 참조</h2>
{{~ end ~}}
<div class="tools">
{{~ if detailed ~}}
<button type="button" data-graph="back" hidden>&#x2190; 전체 그래프</button>
<span class="hint" data-graph="where">전체 그래프</span>
{{~ else ~}}
<span class="hint" data-graph="where">테이블을 고르세요</span>
{{~ end ~}}
<span class="grow"></span>
<button type="button" data-graph="out" title="축소">&#x2212;</button>
<button type="button" data-graph="in" title="확대">+</button>
<button type="button" data-graph="fit" title="창에 맞춤">맞춤</button>
<a class="hint" data-graph="open" href="{{ degrees[0].href }}" hidden>테이블 열기</a>
</div>
<div class="viewport">
<svg class="graph" id="graph" width="100%" height="100%">
<defs>
<marker id="arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
<path d="M0,1 L9,5 L0,9 z" class="head"></path>
</marker>
</defs>
<g id="viewport">
{{~ if detailed ~}}
<g id="all" data-width="{{ width }}" data-height="{{ height }}">
<g id="edges">
{{~ for edge in edges ~}}
<path class="edge{{ if edge.is_self }} self{{ end }}" d="{{ edge.path }}" data-from="{{ edge.from }}" data-to="{{ edge.to }}" marker-end="url(#arrow)"><title>{{ edge.title }}</title></path>
{{~ end ~}}
</g>
<g id="lit"></g>
{{~ for node in nodes ~}}
<g class="node" data-node="{{ node.name }}" data-href="{{ node.href }}">
<rect x="{{ node.x }}" y="{{ node.y }}" width="{{ node.width }}" height="{{ node.height }}" rx="6"></rect>
<text x="{{ node.x + 10 }}" y="{{ node.y + 20 }}">{{ node.name }}</text>
<title>{{ node.title }}</title>
</g>
{{~ end ~}}
</g>
{{~ end ~}}
<g id="focus"></g>
</g>
</svg>
</div>

{{~## The shapes the script clones for a neighbourhood, so the drawing is built from markup
     this template owns rather than from element names spelled out in a script. ##~}}
<svg id="proto" width="0" height="0" aria-hidden="true">
<g data-proto="node" class="node"><rect rx="6"></rect><text></text></g>
<path data-proto="edge" class="edge" marker-end="url(#arrow)"></path>
<text data-proto="label" class="glyph"></text>
</svg>

<h2><svg class="i"><use href="#i-table"></use></svg>연결 정도<span class="count">{{ degrees | array.size }}</span></h2>
<div data-table>
<div class="tools">
<input type="search" data-filter="rows" placeholder="테이블 필터">
<span class="hint" data-shown>{{ degrees | array.size }}행 중 {{ degrees | array.size }}행</span>
<span class="hint">연결이 많은 순서입니다. 행을 누르면 그 테이블의 참조를 그립니다.</span>
</div>
<div class="scroll">
<table data-sortable>
<thead>
<tr class="names">
<th><svg class="i"><use href="#i-table"></use></svg>테이블</th><th>가리키는 수</th><th>가리켜지는 수</th>
</tr>
</thead>
<tbody>
{{~ for row in degrees ~}}
<tr data-pick="{{ row.name }}"><td><a href="{{ row.href }}">{{ row.name }}</a></td><td class="num">{{ row.out }}</td><td class="num">{{ row.in }}</td></tr>
{{~ end ~}}
</tbody>
</table>
</div>
</div>
<div id="adjacency" hidden>{{ adjacency }}</div>
{{~ if !detailed ~}}
<h2>층의 크기</h2>
<p class="hint">아무것도 가리키지 않는 테이블이 0층이고, 자기를 가리키는 것들보다 한 층 뒤에 놓입니다.</p>
<div class="dist">
{{~ for item in layers ~}}
<span class="k">{{ item.name }}</span><span class="track"><div style="width: {{ item.percent }}%"></div></span><span class="v">{{ item.count }}</span>
{{~ end ~}}
</div>
{{~ end ~}}
{{~ end ~}}
{{~ if unconnected | array.size > 0 ~}}
<h2><svg class="i"><use href="#i-table"></use></svg>그래프에 없는 테이블<span class="count">{{ unconnected | array.size }}</span></h2>
<p class="hint">다른 테이블을 가리키지도, 가리켜지지도 않습니다.</p>
<ul class="entities">
{{~ for item in unconnected ~}}
<li><svg class="i"><use href="#i-table"></use></svg><a href="{{ item.href }}">{{ item.name }}</a> <span class="n-of">{{ item.detail }}</span></li>
{{~ end ~}}
</ul>
{{~ end ~}}
{{ include 'html-foot.sbn' }}
