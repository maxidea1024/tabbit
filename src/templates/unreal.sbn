{{~##
   An Unreal module: one header of USTRUCTs and UENUMs, and a static accessor class.

   Two things Unreal Header Tool insists on and a template can get wrong silently:

     the .generated.h include must be last, after every other include, or UHT emits a
     diagnostic that names the wrong line;

     a BlueprintType enum's underlying type must be uint8, which is why the generator
     refuses a sheet whose enum values fall outside 0 to 255 rather than emitting a
     header that fails deep inside UHT.

   There is no conversion namespace here any more. The reader fills engine types
   directly, so there is nothing left to convert between.

   Anything needing the model arrives already rendered from UnrealView.
##~}}
// ------------------------------------------------------------------------------
// Generated by Tabbit. DO NOT EDIT.
//
// Changes to this file may cause incorrect behavior and will be lost if the code is
// regenerated.
// ------------------------------------------------------------------------------

#pragma once

#include "CoreMinimal.h"
#include "UObject/ObjectMacros.h"
#include "Kismet/BlueprintFunctionLibrary.h"

#include "TabbitTcbReader.h"

// Must be the last include. UHT requires it, and moving it produces an error that
// names some other line entirely.
#include "{{ accessor_name }}.generated.h"
{{~ for enumm in enums }}

// Generated from {{ enumm.location }}
{{~ for line in enumm.comment ~}}
/** {{ line }} */
{{~ end ~}}
{{~ if enumm.blueprint_visible ~}}
UENUM(BlueprintType)
{{~ else ~}}
// Not BlueprintType: {{ enumm.not_visible_because }} Still a UENUM, so it is reflected and
// serialises; it is only Blueprint that cannot see it, and neither can the fields using it.
UENUM()
{{~ end ~}}
enum class {{ enumm.name }} : {{ enumm.underlying_type }}
{
{{~ for label in enumm.labels ~}}
{{~ for line in label.comment ~}}
    /** {{ line }} */
{{~ end ~}}
    {{ label.name }} = {{ label.value }} UMETA(DisplayName = "{{ label.display_name }}"),
{{~ end ~}}
};
{{~ end ~}}
{{~## **The constant sets.** Not reflected: a constant is a value the generated code hands
   over, not a row a designer edits in the editor, and a UCLASS of getters would be a second
   surface for every set. So a plain struct of `static inline const` members, which is the
   shape the C++ target writes. spec/layout/primary-layout.md section 8.5. ##~}}
{{~ for set in constant_sets }}

/* Generated from {{ set.location }} */
{{~ for line in set.comment ~}}
/** {{ line }} */
{{~ end ~}}
struct {{ set.name }}
{
{{~ for constant in set.constants ~}}
{{~ for line in constant.comment ~}}
    /** {{ line }} */
{{~ end ~}}
    static inline const {{ constant.type }} {{ constant.name }} = {{ constant.value }};
{{~ end ~}}
};
{{~ end ~}}
{{~## **The declared abstract types: a UENUM saying which variant, and one USTRUCT per variant.**
   A USTRUCT cannot take part in inheritance polymorphism the engine's reflection can see, so
   this target falls on the same side C does - the discriminator is read and then the variant it
   named is asked for. Each variant carries the base fields in its own struct, since there is
   nothing to inherit from. spec/types/polymorphism.md section 7. ##~}}
{{~ for st in structs }}

/** Which shape a {{ st.name }} value took. */
UENUM(BlueprintType)
enum class {{ st.name }}Kind : uint8
{
{{~## **A zero entry, which the header tool requires of every UENUM** - a default-constructed
   value has to name something. No variant is ever numbered 0: `@N` starts at 1 and an
   unnumbered set counts from 1, so this can never collide with a real one.
   spec/types/polymorphism.md sections 5.1.1 and 7. ##~}}
    /** No variant. A default-constructed value, which no row ever carries. */
    None = 0 UMETA(DisplayName = "None"),
{{~ for variant in st.variants ~}}
    /** The file carries {{ variant.discriminator }} for this one. */
    {{ variant.kind_name }} = {{ variant.discriminator }} UMETA(DisplayName = "{{ variant.kind_name }}"),
{{~ end ~}}
};
{{~ for variant in st.variants }}

/**
 * One shape of {{ st.name }}.
 *
 * The file carries {{ variant.discriminator }} for it. That number rather than the name is what
 * lets this variant be renamed without a deployed reader reading a different one.
 */
USTRUCT(BlueprintType)
struct {{ variant.type_name }}
{
    GENERATED_BODY()

{{~ for member in st.base_members ~}}
{{~ for line in member.comment ~}}
    /** {{ line }} */
{{~ end ~}}
    UPROPERTY(EditAnywhere, BlueprintReadOnly, Category = "{{ st.name }}")
{{~ if member.row_name != '' ~}}
{{~## A reference member is two of these: the key the cell held under its own name, and the row
   it resolved to under the derived one. spec/references/reference-surface-naming.md 4 and 5. ##~}}
    {{ member.key_type_name }} {{ member.name }} = {};
    {{ member.type_name }} {{ member.row_name }} = nullptr;
{{~ else ~}}
    {{ member.type_name }} {{ member.name }} = {};
{{~ end ~}}

{{~ end ~}}
{{~ for member in variant.members ~}}
{{~ for line in member.comment ~}}
    /** {{ line }} */
{{~ end ~}}
    UPROPERTY(EditAnywhere, BlueprintReadOnly, Category = "{{ st.name }}")
{{~ if member.row_name != '' ~}}
{{~## A reference member is two of these: the key the cell held under its own name, and the row
   it resolved to under the derived one. spec/references/reference-surface-naming.md 4 and 5. ##~}}
    {{ member.key_type_name }} {{ member.name }} = {};
    {{ member.type_name }} {{ member.row_name }} = nullptr;
{{~ else ~}}
    {{ member.type_name }} {{ member.name }} = {};
{{~ end ~}}

{{~ end ~}}
};
{{~ end ~}}
{{~ end ~}}
{{~ for table in tables }}

// Generated from {{ table.location }}
{{~## The element type of each record group, ahead of the row that holds one. A USTRUCT so
   that a TArray of it is a property UHT accepts - which is what lets the row's member keep
   its UPROPERTY. See spec/types/nested-fields.md. ##~}}
{{~ for field in table.fields ~}}
{{~## An array of arrays declares no element USTRUCT: its outer level has no name, so there
   is nothing for one to be. spec/types/nested-multi-level.md. ##~}}
{{~ if field.is_record && !field.members_are_anonymous ~}}
{{~## One USTRUCT per level, innermost first - which UHT requires rather than prefers: a struct
   member needs its complete type and the header is read in order. A struct member of a USTRUCT
   type is a property UHT accepts, so depth costs no reflection here - the opposite of what an
   array of arrays cost. The view flattened the nesting so this loop does not have to know how
   deep it went. spec/types/nested-multi-level.md. ##~}}
{{~ for rt in field.record_types ~}}
{{~ if rt.is_outermost ~}}
/** One element of {{ rt.owner }}. */
{{~ else ~}}
/** A record inside {{ rt.owner }}. */
{{~ end ~}}
USTRUCT(BlueprintType)
struct {{ api_macro }} {{ rt.type_name }}
{
    GENERATED_BODY()

{{~ for member in rt.members ~}}
{{~ for line in member.comment ~}}
    /** {{ line }} */
{{~ end ~}}
{{~ if member.blueprint_visible ~}}
    UPROPERTY(EditAnywhere, BlueprintReadOnly, Category = "{{ table.raw_name }}")
{{~ else ~}}
    // No UPROPERTY: {{ member.not_visible_because }}
{{~ end ~}}
    {{ member.declaration }}

{{~ end ~}}
{{~## The second layer of a container's surface. The arrays above are the file's order; these
   are the lookup, and neither of the engine's containers keeps one. No UPROPERTY: the header
   tool has no property type for a map keyed by anything a sheet may key by, and what a
   Blueprint reads is the array. spec/types/set-and-map.md section 7. ##~}}
{{~ for line in rt.lookups ~}}
    {{ line }}
{{~ end ~}}
{{~ if rt.lookups | array.size > 0 }}
{{~ end ~}}};

{{~ end ~}}
{{~ end ~}}
{{~ end ~}}
{{~ for line in table.comment ~}}
/** {{ line }} */
{{~ end ~}}
USTRUCT(BlueprintType)
struct {{ api_macro }} {{ table.record_name }}
{
    GENERATED_BODY()

{{~ for field in table.fields ~}}
{{~ for line in field.comment ~}}
    /** {{ line }} */
{{~ end ~}}
{{~ if field.blueprint_visible ~}}
    UPROPERTY(EditAnywhere, BlueprintReadOnly, Category = "{{ table.raw_name }}")
{{~ else ~}}
    // No UPROPERTY: {{ field.not_visible_because }}
{{~ end ~}}
    {{ field.declaration }}

{{~ if field.is_nullable ~}}
{{~## The value member keeps its type and holds the type's empty value when the row had none;
   this says which it was. Not TOptional - UHT has no such property type before 5.4, and the
   engine's own answer is the bOverride_X pair in FPostProcessSettings. ##~}}
    /** Whether this row has a value for {{ field.name }}. */
    UPROPERTY(EditAnywhere, BlueprintReadOnly, Category = "{{ table.raw_name }}")
    bool {{ field.presence_member }} = false;
{{~ end ~}}
{{~ if field.has_optional_elements ~}}
    /** Which of {{ field.name }}'s elements have a value. Empty where the file did not carry
     * the column, and then every index is out of range anyway.
     * spec/types/nullable-array-elements.md. */
    TArray<bool> {{ field.element_presence_member }};

{{~ end ~}}
{{~ end ~}}};
{{~ end ~}}
{{~ for table in tables }}

/** Every row of {{ table.raw_name }}. */
class {{ api_macro }} {{ table.table_name }}
{
public:
    const TArray<{{ table.record_name }}>& Records() const { return RecordsStorage; }
{{~ for index in table.indexes }}
    /**
     * The row with this {{ index.field_name }}, or nullptr when the table has none.
     *
     * The lookup to reach for when a missing row is an ordinary answer - an optional
     * reference, a key that came from user input.
     */
    const {{ table.record_name }}* FindBy{{ index.suffix }}({{ index.params }}) const;

    /** Whether the table holds a row with this {{ index.field_name }}. */
    bool Contains{{ index.suffix }}({{ index.params }}) const;
{{~ if index.is_composite }}
{{~## A key of several columns is held as the text they make. Each part carries its own
   length, so no two combinations can make the same text - joined by a separator alone,
   ("a b", "c") and ("a", "b c") would be one key and one of the two rows would be lost.
   spec/layout/primary-layout.md section 3.5. ##~}}
    /** Joins the columns of the {{ index.field_name }} key into the text the map is keyed by. */
    static FString KeyOf{{ index.suffix }}({{ index.params }});
{{~ end ~}}
{{~ end }}
{{~ for field in table.fields ~}}
{{~ if field.variants.size > 0 }}
{{~## **The discriminator and one accessor per variant** - the shape section 7 named for the
   languages with nothing to narrow to. The row still carries the flat entry, so the read path
   and the wire are untouched; each ask fills a caller-owned struct and answers whether the row
   was that variant. spec/types/polymorphism.md section 7.2. ##~}}
{{~ if field.variants_are_array ~}}
{{~## **The array shape.** Each element carries its own discriminator - section 5.3 - so the
   element number is what these take beside the row, and `Num` is how many there are. ##~}}
    /** How many {{ field.abstract_type_name }}s a row has. */
    static int32 {{ field.pascal_name }}Num(const {{ table.record_name }}& Row)
    {
        return Row.{{ field.name }}.Num();
    }

    /** Which shape one element's {{ field.abstract_type_name }} took. */
    static {{ field.kind_enum_name }} {{ field.pascal_name }}Kind(
        const {{ table.record_name }}& Row, int32 At)
    {
        return static_cast<{{ field.kind_enum_name }}>(Row.{{ field.name }}[At].Type);
    }
{{~ else ~}}
    /** Which shape a row's {{ field.abstract_type_name }} took. */
    static {{ field.kind_enum_name }} {{ field.pascal_name }}Kind(const {{ table.record_name }}& Row)
    {
        return static_cast<{{ field.kind_enum_name }}>(Row.{{ field.name }}.Type);
    }
{{~ end ~}}
{{~ for variant in field.variants }}

{{~ if field.variants_are_array ~}}
    /** Fills Out when that element is a {{ variant.type_name }}, and answers whether it was. */
    static bool {{ field.pascal_name }}As{{ variant.suffix }}(
        const {{ table.record_name }}& Row, int32 At, {{ variant.type_name }}& Out)
    {
        const {{ field.record_type_name }}& {{ field.entry_access }} = Row.{{ field.name }}[At];
{{~ else ~}}
    /** Fills Out when the row is a {{ variant.type_name }}, and answers whether it was. */
    static bool {{ field.pascal_name }}As{{ variant.suffix }}(
        const {{ table.record_name }}& Row, {{ variant.type_name }}& Out)
    {
        const {{ field.record_type_name }}& {{ field.entry_access }} = Row.{{ field.name }};
{{~ end ~}}

        if ({{ field.entry_access }}.Type != {{ variant.discriminator }})
        {
            return false;
        }

{{~ for member in field.base_members ~}}
{{~ if member.row_name != '' ~}}
{{~## A reference member is two of these: the key the cell held under its own name, and the row
   it resolved to under the derived one. spec/references/reference-surface-naming.md 4 and 5. ##~}}
        Out.{{ member.name }} = {{ field.entry_access }}.{{ member.name }};
        Out.{{ member.row_name }} = {{ field.entry_access }}.{{ member.row_name }};
{{~ else ~}}
        Out.{{ member.name }} = {{ field.entry_access }}.{{ member.name }};
{{~ end ~}}
{{~ end ~}}
{{~ for member in variant.members ~}}
{{~ if member.row_name != '' ~}}
{{~## A reference member is two of these: the key the cell held under its own name, and the row
   it resolved to under the derived one. spec/references/reference-surface-naming.md 4 and 5. ##~}}
        Out.{{ member.name }} = {{ field.entry_access }}.{{ member.name }};
        Out.{{ member.row_name }} = {{ field.entry_access }}.{{ member.row_name }};
{{~ else ~}}
        Out.{{ member.name }} = {{ field.entry_access }}.{{ member.name }};
{{~ end ~}}
{{~ end ~}}
        return true;
    }
{{~ end ~}}
{{~ end ~}}
{{~ end ~}}
    /** Loads the table from a .tcb file written by Tabbit. */
    bool Read(const FString& Filename);

private:
    TArray<{{ table.record_name }}> RecordsStorage;
{{~ for index in table.indexes ~}}
    TMap<{{ index.key_type }}, int32> {{ index.map_name }};
{{~ end ~}}
};
{{~ end }}

/**
 * Every table, loaded together.
 *
 * A static class rather than a UObject: the data outlives any world, is read once at
 * startup and never mutated, and nothing here needs reflection or garbage collection.
 */
class {{ api_macro }} {{ accessor_name }}
{
public:
{{~ for slot in accessor.tables ~}}
    static const {{ slot.table_name }}& {{ slot.name }}() { return {{ slot.name }}Storage; }
{{~ end ~}}

    /**
     * Reads every table from BasePath. Returns false if any of them could not be read.
     *
     * FileExtension defaults to what the recipe told the exporter to write. Pass a different
     * one when the data files were renamed on the way into the package - which they often are,
     * since some platforms only cook what carries an extension they recognise.
     */
    static bool ReadAll(const FString& BasePath,
                        const FString& FileExtension = TEXT("{{ accessor.file_extension }}"));

    /**
     * The key the table files were sealed with, or empty when they were not sealed.
     *
     * Beside ReadAll because it is the same kind of thing: one decision the project makes
     * once, at start-up, before the first table is read. A key threaded through every Read
     * signature would be the same value written out at every call site, and every call site
     * is somewhere it could be wrong.
     *
     * Thirty-two bytes, the key the converter was given. Empty - the default - is a project
     * that does not encrypt, and it costs that project nothing: the load path opens the
     * envelope either way, and a file that is not encrypted comes back from that unchanged.
     * A project that does encrypt and leaves this empty gets the reader's own message saying
     * the file is encrypted and no key was given, rather than a failure somewhere inside the
     * format.
     *
     * Where the key comes from is the one thing about this layer worth being careful with.
     * It is a secret only until it reaches a repository, a build log or an issue, and it
     * cannot be taken back afterwards - so it is read at start-up from wherever this project
     * keeps secrets, not written into a source file or a .ini the packaging step will cook.
     * What the layer is for, and therefore what is and is not worth defending, is
     * spec/wire/tcb-v104-composed-encodings.md section 4.
     */
    static TArray<uint8> EncryptionKey;

    /**
     * The key the table files were signed with, or empty when they were not signed.
     *
     * A different key from EncryptionKey and independent of it: a file can be signed without
     * being encrypted, and encrypted without being signed.
     *
     * What it buys is the thing encryption does not. The cipher is a keystream XOR, so a bit
     * flipped in the file is a bit flipped in the value it decrypts to - no key needed - and
     * every structural check the format makes still passes, because a four-byte float
     * accepts any four bytes. With this set, a file altered after export stops loading.
     *
     * Setting it makes the reader stricter in a second way: a file that carries no MAC is
     * refused, because otherwise the check could be removed by zeroing sixteen bytes. So the
     * order to turn this on in is data first, key second. spec/wire/tcb-mac-and-signature.md.
     */
    static TArray<uint8> MacKey;

    /**
     * Whether to check the MAC at all. True by default.
     *
     * For tools that read exported files without the key, and for measuring what the check
     * costs at load. It is not a security boundary - anyone who can flip a flag in a shipped
     * build can read MacKey out of the same build.
     */
    static bool bVerifyMac;

private:
{{~ for slot in accessor.tables ~}}
    static {{ slot.table_name }} {{ slot.name }}Storage;
{{~ end ~}}
};

/**
 * The same data, reachable from Blueprint.
 *
 * Every row above is a USTRUCT marked BlueprintType with BlueprintReadOnly properties,
 * which says the rows are meant to be used from Blueprint - and until this existed there
 * was no way to get one. A graph could declare a variable of a row type and had nothing to
 * obtain a value from, because the accessor is a plain C++ class and a static method on one
 * is not something Blueprint can call.
 *
 * A function library rather than making the accessor a UObject. The storage stays where it
 * is: this owns nothing, adds no garbage collection, and does not need a world. It is a
 * few UFUNCTIONs over the C++ that was already there.
 */
UCLASS()
class {{ api_macro }} {{ accessor.library_name }} : public UBlueprintFunctionLibrary
{
    GENERATED_BODY()

public:
{{~ for slot in accessor.tables }}
    /**
     * The {{ slot.raw_name }} row with the given {{ slot.primary_field_name }}.
     *
     * bFound rather than a pointer, because Blueprint has no null struct - a graph that
     * ignored a failure would otherwise carry a default row it could not tell apart from
     * a real one.
     */
    UFUNCTION(BlueprintPure, Category = "Tabbit|{{ slot.raw_name }}",
              meta = (DisplayName = "Get {{ slot.raw_name }} Row"))
    static {{ slot.record_name }} Get{{ slot.name }}Row({{ slot.primary_params }}, bool& bFound);

    /** How many {{ slot.raw_name }} rows were loaded. */
    UFUNCTION(BlueprintPure, Category = "Tabbit|{{ slot.raw_name }}",
              meta = (DisplayName = "Get {{ slot.raw_name }} Row Count"))
    static int32 Get{{ slot.name }}RowCount();

    /**
     * The {{ slot.raw_name }} row at a position, for walking the table in order.
     *
     * A position and a count rather than the whole array. Blueprint takes a return value
     * by value, so handing back a TArray would copy every row of the table on every call -
     * and a reference return is not something Unreal Header Tool accepts. With these two a
     * graph can loop over the table and copy one row per turn.
     */
    UFUNCTION(BlueprintPure, Category = "Tabbit|{{ slot.raw_name }}",
              meta = (DisplayName = "Get {{ slot.raw_name }} Row At"))
    static {{ slot.record_name }} Get{{ slot.name }}RowAt(int32 Position, bool& bFound);
{{~ end }}
    /**
     * Reads every table from BasePath, as {{ accessor_name }}::ReadAll does.
     *
     * BlueprintCallable rather than BlueprintPure: it does something.
     */
    UFUNCTION(BlueprintCallable, Category = "Tabbit",
              meta = (DisplayName = "Load All Tabbit Tables"))
    static bool ReadAll(const FString& BasePath,
                        const FString& FileExtension = TEXT("{{ accessor.file_extension }}"));
};
{{~ if accessor.tables | array.size == 0 }}
{{~ end ~}}
