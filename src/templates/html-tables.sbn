{{~##
   Every table the model declares, as a list.

   This used to be every table's data on one page, which is what made it 37 MB for a
   workbook whose largest table has 100,000 rows. What a reader wants from a page called
   `tables.html` is the list - which tables there are, how big each is, which sheet it
   came from - and the data is one click away, per table.

   Sortable, because "which table is largest" and "which sheet holds most of them" are
   questions the same list answers once the column headings work.
##~}}
{{~ include 'html-head.sbn' ~}}
<p class="lead">테이블 {{ rows | array.size }}개 · 행 {{ record_total }}개 · 컬럼 {{ column_total }}개</p>
<div data-table>
<div class="tools">
<input type="search" data-filter="rows" placeholder="테이블 필터">
<span class="hint" data-shown>{{ rows | array.size }}행 중 {{ rows | array.size }}행</span>
<span class="hint">제목을 누르면 정렬됩니다.</span>
</div>
{{~ if rows | array.size == 0 ~}}
<p class="none">선언된 것이 없습니다.</p>
{{~ else ~}}
<div class="scroll">
<table data-sortable>
<thead>
<tr class="names">
<th class="sorted"><svg class="i"><use href="#i-table"></use></svg>테이블</th><th>행</th><th>컬럼</th><th>시트</th>{{ if has_comments }}<th>설명</th>{{ end }}
</tr>
</thead>
<tbody>
{{~ for row in rows ~}}
<tr><td><a href="{{ row.href }}">{{ row.name }}</a></td><td class="num">{{ row.record_count }}</td><td class="num">{{ row.column_count }}</td><td>{{ row.sheet }}</td>{{ if has_comments }}<td>{{ row.comment }}</td>{{ end }}</tr>
{{~ end ~}}
</tbody>
</table>
</div>
{{~ end ~}}
</div>
{{ include 'html-foot.sbn' }}
