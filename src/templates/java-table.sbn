{{~## One table's table type. ##~}}
{{ include 'java-file-head.sbn' ~}}
/** Every row of {{ table.raw_name }}. */
public final class {{ table.table_name }} implements Iterable<{{ table.record_name }}> {
    private List<{{ table.record_name }}> records = new ArrayList<>();
{{~ for index in table.indexes ~}}
    private Map<{{ index.key_type }}, {{ table.record_name }}> {{ index.map_name }} = new HashMap<>();
{{~ end ~}}

    /**
     * Every row, in the order the sheet declared them.
     *
     * The list a read published, not one a read fills. A refresh replaces the reference
     * rather than the contents, so whoever holds this holds one whole load.
     */
    public List<{{ table.record_name }}> records() {
        return records;
    }

    /** How many rows the table holds. */
    public int size() {
        return records.size();
    }

    /**
     * The rows, in the order the file wrote them.
     *
     * The list reference is read once, here. A refresh replaces the reference rather than
     * its contents, so a loop already running keeps the rows it started with.
     */
    @Override
    public Iterator<{{ table.record_name }}> iterator() {
        return records.iterator();
    }
{{~ for index in table.indexes }}
{{~## A key of several columns is held as the text they make. Each part carries its own
   length, so no two combinations can make the same text - joined by a separator alone,
   ("a b", "c") and ("a", "b c") would be one key and one of the two rows would be lost.
   spec/layout/primary-layout.md section 3.5. ##~}}
{{~ if index.is_composite ~}}
    /** Joins the columns of the {{ index.field_name }} key into the text the map is keyed by. */
    private static String keyOf{{ index.suffix }}({{ index.params }}) {
        String[] parts = {
{{~ for c in index.components ~}}
{{~ if c.kind == "string" ~}}
            {{ c.param }},
{{~ else if c.kind == "enum" ~}}
            Long.toString({{ c.param }}.value()),
{{~ else ~}}
            Long.toString({{ c.param }}),
{{~ end ~}}
{{~ end ~}}
        };

        StringBuilder text = new StringBuilder();

        for (String part : parts) {
            text.append(part.length()).append(':').append(part);
        }

        return text.toString();
    }

{{~ end ~}}
    /**
     * The row with this {{ index.field_name }}, or null when the table has none.
     *
     * The lookup to reach for when a missing row is an ordinary answer - an optional
     * reference, a key that came from user input.
     */
    public {{ table.record_name }} findBy{{ index.suffix }}({{ index.params }}) {
        return {{ index.map_name }}.get({{ index.argument }});
    }

    /**
     * The row with this {{ index.field_name }}, or a thrown exception naming what was missing.
     *
     * For a key that has to be there - one from another table, or a constant. The name says
     * it throws, because a caller reading getBy{{ index.suffix }}(key).name() at a glance
     * cannot otherwise tell whether the next line is a null check or a catch.
     */
    public {{ table.record_name }} getBy{{ index.suffix }}OrThrow({{ index.params }}) {
        {{ table.record_name }} record = {{ index.map_name }}.get({{ index.argument }});

        if (record == null) {
{{~ if index.is_composite ~}}
            throw new TcbReader.RecordNotFoundException(
                "there is no record in table `{{ table.raw_name }}` that corresponds to field "
                + String.format("`{{ index.field_name }}` value {{ index.value_format }}", {{ index.value_args }}));
{{~ else ~}}
            throw new TcbReader.RecordNotFoundException(
                "there is no record in table `{{ table.raw_name }}` that corresponds to field "
                + "`{{ index.field_name }}` value " + key);
{{~ end ~}}
        }

        return record;
    }

    /** Whether the table holds a row with this {{ index.field_name }}. */
    public boolean contains{{ index.suffix }}({{ index.params }}) {
        return {{ index.map_name }}.containsKey({{ index.argument }});
    }
{{~ if index.is_primary && !index.is_composite }}

    /**
     * Each row with the {{ index.field_name }} it is keyed by -
     * `for (var entry : table.entries())`.
     *
     * What this saves a caller is not the key value - the row carries it - but having to
     * know which column the key is: {{ index.field_name }} here, something else in the next
     * table.
     *
     * The rows come in the order the file wrote them rather than the order the map holds
     * them, which makes this and iterating the table agree. Only the primary key has this:
     * a table keyed by several columns together has no single key value to pair a row with.
     */
    public Iterable<Map.Entry<{{ index.key_type }}, {{ table.record_name }}>> entries() {
        final List<{{ table.record_name }}> rows = records;

        return () -> new Iterator<Map.Entry<{{ index.key_type }}, {{ table.record_name }}>>() {
            private final Iterator<{{ table.record_name }}> source = rows.iterator();

            @Override
            public boolean hasNext() {
                return source.hasNext();
            }

            @Override
            public Map.Entry<{{ index.key_type }}, {{ table.record_name }}> next() {
                final {{ table.record_name }} row = source.next();

                return new AbstractMap.SimpleImmutableEntry<>(row.{{ index.member }}, row);
            }
        };
    }
{{~ end ~}}
{{~ end ~}}

    /** Loads the table from a .tcb file written by Tabbit. */
    /**
     * Column by column, matched by tag rather than position: a column this build does not
     * know is skipped by its block length, and one whose type changed incompatibly fails
     * naming the field.
     */
    public void read(Path filename) {
        // Opened unconditionally, and with whatever {{ accessor_name }}.encryptionKey and
        // {{ accessor_name }}.macKey hold - which is null unless the project set them. A
        // file that is neither encrypted nor signed comes back from this untouched, so the
        // load path is the same either way and there is no condition here that could be the
        // wrong way round. spec/wire/tcb-mac-and-signature.md.
        TcbReader reader = new TcbReader(TcbReader.open(
            TcbReader.readAllBytes(filename), {{ accessor_name }}.encryptionKey,
            {{ accessor_name }}.macKey, {{ accessor_name }}.verifyMac));
        TcbReader.Header header = TcbReader.readTableHeader(reader);
        int count = header.rowCount;
{{~ if table.needs_cursor ~}}
        TcbReader.ColumnCursor cursor;
{{~ end ~}}
{{~ if table.needs_presence ~}}
{{~## Declared once for the whole switch, like the cursor: a `case` is not its own scope in
      Java, so a declaration inside two of them collides. ##~}}
        byte[] presence;
{{~ end ~}}
{{~ if table.needs_element_presence ~}}
        byte[] elementPresence;
        int elementAt;
{{~ end ~}}

        // Read into storage of its own and published at the end: reading a table that is already loaded is a refresh, and one that turns out to be unreadable has to leave the rows already there alone.
        List<{{ table.record_name }}> loaded = new ArrayList<>(count);
{{~ for index in table.indexes ~}}
        Map<{{ index.key_type }}, {{ table.record_name }}> loadedBy{{ index.suffix }} = new HashMap<>(count * 2);
{{~ end ~}}

        for (int i = 0; i < count; i++) {
            loaded.add(new {{ table.record_name }}());
        }

        for (TcbReader.Column column : header.columns) {
            int blockEnd = reader.position() + column.byteLength;

            switch (column.tag) {
{{~ for column_view in table.columns ~}}
                case {{ column_view.wire_tag }}: {
                    {{ column_view.column_check }}
{{~ if column_view.is_nullable ~}}
                    // The bitmap is at the front of the block, so it is read before the
                    // values. The values are written for every row either way, which is what
                    // lets the read shapes below stay as they are.
                    presence = TcbReader.readPresence(reader, column, count);
{{~ end ~}}
{{~ if column_view.has_optional_elements ~}}
                    // Behind the row bitmap and in front of the values, walked with a counter
                    // that steps once per element of every row.
                    // spec/types/nullable-array-elements.md.
                    elementPresence = TcbReader.readElementPresence(reader, column);
                    elementAt = 0;
{{~ end ~}}
{{~## Opened here, ahead of every read shape, because an array's elements read through it
      as well: its block states an encoding for them and one for the row lengths, and the
      cursor is what decodes both. After the presence bitmap, which sits in front of the
      block the cursor is about to start reading. ##~}}
{{~ if column_view.cursor_open != '' ~}}
                    {{ column_view.cursor_open }}
{{~ end ~}}
{{~ if column_view.run_call != '' ~}}
{{~## A run of equal values costs one call and then plain assignments, rather than one
      call per row that each re-dispatch on the encoding. An encoding with no run to
      give answers 1, so this loop is correct over all of them. ##~}}
                    for (int i = 0; i < count; ) {
                        int n = cursor.{{ column_view.run_call }}(count - i);
                        for (; n > 0; n--, i++) {
                            {{ column_view.run_spend }}
                        }
                    }
{{~ else ~}}
                    for ({{ table.record_name }} record : loaded) {
{{~ if column_view.kind == 'var_array' ~}}
                        int elementCount;
                        {{ column_view.length_read }}
                        record.{{ column_view.name }} = new {{ column_view.element_type }}[elementCount];
{{~ if column_view.has_optional_elements ~}}
                        record.{{ column_view.element_presence_member }} = new boolean[elementCount];
{{~ end ~}}
                        for (int j = 0; j < elementCount; j++) {
                            record.{{ column_view.name }}[j] = {{ column_view.read_element }};
{{~ if column_view.has_optional_elements ~}}
                            record.{{ column_view.element_presence_member }}[j] =
                                TcbReader.isPresent(elementPresence, elementAt++);
{{~ end ~}}
                        }
{{~ else if column_view.kind == 'var_array_ref' ~}}
{{~## A trimmed array of references. Same length as the values - this row's - for the keys
   beside them, which is what `serial_ref` does from the column count.
   spec/types/variable-length-record-arrays.md. ##~}}
                        int elementCount;
                        {{ column_view.length_read }}
{{~ if column_view.row_name != '' ~}}
                        record.{{ column_view.row_name }} = new {{ column_view.element_type }}[elementCount];
                        record.{{ column_view.name }} = new {{ column_view.ref_key_type }}[elementCount];
{{~ else ~}}
{{~## A dotted reference: the column's name stays on the value it hands back, and the key
   keeps the name it had. spec/references/reference-surface-naming.md section 9. ##~}}
                        record.{{ column_view.name }} = new {{ column_view.element_type }}[elementCount];
                        record.{{ column_view.name }}Index = new {{ column_view.ref_key_type }}[elementCount];
{{~ end ~}}
{{~ if column_view.has_optional_elements ~}}
                        record.{{ column_view.element_presence_member }} = new boolean[elementCount];
{{~ end ~}}
                        for (int j = 0; j < elementCount; j++) {
                            record.{{ column_view.name }}{{ if column_view.row_name == '' }}Index{{ end }}[j] = {{ column_view.read_element }};
{{~ if column_view.has_optional_elements ~}}
                            record.{{ column_view.element_presence_member }}[j] =
                                TcbReader.isPresent(elementPresence, elementAt++);
{{~ end ~}}
                        }
{{~ else if column_view.kind == 'record_var' ~}}
                        int elementCount;
                        {{ column_view.length_read }}
{{~ if column_view.is_first_member ~}}
                        // The first member allocates; the rest check. Allocating again would
                        // discard what the members before it wrote, and taking the shorter of
                        // two counts would shift every value after it.
                        record.{{ column_view.name }} = new {{ column_view.record_type_name }}[elementCount];

                        for (int j = 0; j < elementCount; j++) {
                            record.{{ column_view.name }}[j] = new {{ column_view.record_type_name }}();
                            record.{{ column_view.name }}[j]{{ column_view.member_access }}{{ column_view.member_ref_suffix }} = {{ column_view.read_element }};
                        }
{{~ else ~}}
                        if (record.{{ column_view.name }}.length != elementCount) {
                            throw new TcbReader.TcbException(
                                "{{ table.raw_name }}.{{ column_view.name }}: the file gives one member of "
                                + "this record a different element count than another");
                        }

                        for (int j = 0; j < elementCount; j++) {
                            record.{{ column_view.name }}[j]{{ column_view.member_access }}{{ column_view.member_ref_suffix }} = {{ column_view.read_element }};
                        }
{{~ end ~}}
{{~ else if column_view.kind == 'array_of_arrays_member' ~}}
{{~## One inner array. Which outer element it is, is which column this is - so that index is
   fixed and the loop runs the inner length. spec/types/nested-multi-level.md. ##~}}
                        int elementCount;
                        {{ column_view.length_read }}
                        record.{{ column_view.name }}[{{ column_view.member_at }}] = new {{ column_view.element_type }}[elementCount];
                        for (int j = 0; j < elementCount; j++) {
                            record.{{ column_view.name }}[{{ column_view.member_at }}][j] = {{ column_view.read_element }};
                        }
{{~ else if column_view.kind == 'record_member_var' ~}}
{{~## The member is the array: the index goes after its name rather than before. Same
   columns and same loop as the case below - see spec/types/nested-multi-level.md. ##~}}
                        int elementCount;
                        {{ column_view.length_read }}
{{~ if column_view.row_member_access != '' ~}}
{{~## A reference member holds one key per element as well as one row, and the read writes
   into the key - so both are made. The member's own name is the key's.
   spec/references/reference-surface-naming.md section 4. ##~}}
                        record.{{ column_view.name }}{{ column_view.row_member_access }} = new {{ column_view.element_type }}[elementCount];
                        record.{{ column_view.name }}{{ column_view.member_access }} = new {{ column_view.ref_key_type }}[elementCount];
{{~ else ~}}
                        record.{{ column_view.name }}{{ column_view.member_access }} = new {{ column_view.element_type }}[elementCount];
{{~ end ~}}
                        for (int j = 0; j < elementCount; j++) {
                            record.{{ column_view.name }}{{ column_view.member_access }}{{ column_view.member_ref_suffix }}[j] = {{ column_view.read_element }};
                        }
{{~ else if column_view.kind == 'scalar_ref' ~}}
                        record.{{ column_view.name }}{{ if column_view.row_name == '' }}Index{{ end }} = {{ column_view.read_element }};
{{~ else ~}}
                        record.{{ column_view.name }}{{ column_view.member_access }}{{ column_view.member_ref_suffix }} = {{ column_view.read_scalar }};
{{~ end ~}}
                    }
{{~ end ~}}
{{~ if column_view.is_nullable }}
                    // A pass of its own rather than a line inside each read shape, so the row
                    // index is worked out once. The block carries a value for every row, so
                    // an absent one has just been given whatever was there; putting the empty
                    // value back is what makes this path agree with the JSON one.
                    for (int i = 0; i < count; i++) {
                        {{ table.record_name }} record = loaded.get(i);
                        record.{{ column_view.presence_member }} = TcbReader.isPresent(presence, i);

                        if (!record.{{ column_view.presence_member }}) {
                            record.{{ column_view.name }} = {{ column_view.empty_value }};
                        }
                    }
{{~ end ~}}
                    break;
                }
{{~ end ~}}
                default:
                    // A column added after this code was generated.
                    reader.skip(column.byteLength);
                    break;
            }

            TcbReader.checkBlockEnd(reader, column, blockEnd);
        }

{{~ if table.container_fill | array.size > 0 ~}}
{{~## The lookups a `set` and a `map` publish beside their arrays. Here rather than on the
   way through: a map needs its key column and how long it is, and the columns arrive one at
   a time. spec/types/set-and-map.md section 7.3. ##~}}
        for ({{ table.record_name }} record : loaded) {
{{~ for line in table.container_fill ~}}
            {{ line }}
{{~ end ~}}
        }

{{~ end ~}}
        for ({{ table.record_name }} record : loaded) {
{{~ for index in table.indexes ~}}
{{~ if index.is_composite ~}}
            loadedBy{{ index.suffix }}.put(
                keyOf{{ index.suffix }}({{ for c in index.components }}record.{{ c.member }}{{ if !for.last }}, {{ end }}{{ end }}), record);
{{~ else ~}}
            loadedBy{{ index.suffix }}.put(record.{{ index.member }}, record);
{{~ end ~}}
{{~ end ~}}
        }

        // Published, now that every column read.
        records = loaded;
{{~ for index in table.indexes ~}}
        {{ index.map_name }} = loadedBy{{ index.suffix }};
{{~ end ~}}
    }
}
