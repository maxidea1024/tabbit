{
  "name": "clover-server",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "clover 리더보드. 계정 · 랭크 시드 · 제출과 재현 · 순위.",
  "scripts": {
    "check": "tsc --noEmit",
    "dev": "tsx watch src/app.ts",
    "worker": "tsx watch src/worker.ts",
    "start": "tsx src/app.ts",
    "test": "vitest run",
    "seed:fake": "tsx tools/seed-fake.ts",
    "season:new": "tsx tools/new-season.ts",
    "season:check": "tsx tools/new-season.ts --check",
    "bench": "tsx tools/bench.ts"
  },
  "dependencies": {
    "express": "^4.21.2",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.3.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
