# 제공자의 열쇠. `.env` 로 복사해서 채웁니다. **`.env` 는 커밋하지 않습니다.**
#
# 개발에서는 GitHub 하나면 됩니다 — https://github.com/settings/developers 에서
# OAuth App 을 만들고 callback 을 아래로 둡니다.
#
#     http://localhost:8787/auth/github/callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 배포 환경에만 씁니다.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=
