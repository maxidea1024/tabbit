{
  // 포커 로그라이크 한 편의 기획 데이터 전부입니다. 규칙과 수치가 여기 있고, 웹과 유니티는
  // 이것을 읽는 서로 독립된 두 구현입니다.
  //
  //     dotnet run --project src/Tabbit.csproj -- --recipe samples/clover/design-data/recipe.jsonc

  "Sources": {
    "Xlsx": [
      {
        "Path": "samples/clover/design-data/xlsx",

        // 레이아웃은 기본값입니다 — 이 워크북들은 이 도구의 규칙으로 쓰였습니다.

        // 배열 원소의 구분자. `Rank[]` 와 `Suit[]` 가 이것을 씁니다.
        "ArrayDelimiter": ";"
      }
    ]
  },

  // 효과 VM 의 선언입니다. 조건 30종과 연산 23종, 그리고 카드와 런의 enum.
  // **doc/effect-vm.md 가 규격이고 이 파일들이 그 선언입니다.**
  "Schemas": [{ "Path": "samples/clover/design-data/schemas" }],

  // wildling 과 같은 규약입니다 — 필드만 snake 이고 나머지는 pascal 이라, 시트에서 「타입과
  // 이름의 자리」와 「값이 들어가는 자리」가 눈으로 구분됩니다.
  "Naming": {
    "Field": "snake",
    "Entity": "pascal",
    "Label": "pascal",
    "Constant": "pascal",
    "OnViolation": "error"
  },

  // 조커 150종의 그림. **웹과 유니티가 같은 파일을 씁니다** — 그림은 한 벌이고 두 플랫폼이
  // 각자 자기 형식으로 가져갑니다.
  //
  // 그림이 아직 없으므로 `warn` 입니다. P4 에서 그림이 들어오면 `error` 로 바꿉니다 —
  // 그때부터 이 검사가 자리표가 아니라 게임이 띄우는 파일을 봅니다.
  "Assets": {
    "Roots": [
      { "Kind": "joker", "Path": "samples/clover/art/joker", "Pattern": "*.png" }
    ],
    "OnMissing": "warn"
  },

  // 시트의 타입으로 표현되지 않는 규칙. 희귀도 분포와 효과 행의 존재와 `Custom` 목록이
  // 그런 것들입니다 — 전부 기획이 정한 것이고 타입으로는 표현되지 않습니다.
  "Validation": {
    "Path": "samples/clover/design-data/validation"
  },

  "Targets": [
    {
      // 웹의 코어가 읽는 것. 렌더링과 분리되어 있으므로 Node 에서도 그대로 돕니다.
      "Type": "typescript",
      "Path": "samples/clover/web/src/generated",
      "AccessorName": "CloverData"
    },
    {
      // 브라우저가 `fetch` 로 가져갑니다. `lib/ts/tabbit/tcb_reader.ts` 가 `Uint8Array` 위에서
      // 돌므로 그대로 읽힙니다.
      "Type": "binary",
      "Path": "samples/clover/web/public/data",
      "EncodingReport": "samples/clover/design-data/out/encoding-report.txt",
      "SchemaBaseline": "samples/clover/design-data/out/schema-baseline.json"
    },
    {
      "Type": "csharp",
      "Path": "samples/clover/unity/Assets/Clover/Generated",
      "Namespace": "Clover.Data",
      "AccessorName": "CloverData",
      "BinaryTableFileExtension": ".bytes",
      "WriteUpdater": true
    },
    {
      // 유니티가 TextAsset 으로 포함합니다. 위의 `.tcb` 와 **같은 바이트**입니다 —
      // 확장자만 다릅니다.
      "Type": "binary",
      "Path": "samples/clover/unity/Assets/StreamingAssets/tables",
      "FileExtension": ".bytes"
    },
    {
      // 값이 제대로 들어갔는지 눈으로 보는 자리. 게임이 로드하지 않고 사람이 읽습니다.
      "Type": "html",
      "Path": "samples/clover/design-data/out/html"
    }
  ]
}
