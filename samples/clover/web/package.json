{
  "name": "clover",
  "private": true,
  "type": "module",
  "version": "0.3.1",
  "description": "포커 로그라이크 한 편. 규칙은 시트에 있고 여기는 그것을 읽는 한쪽 구현입니다.",
  "scripts": {
    "check": "tsc -b",
    "check:replays": "tsx tools/bake-replays.ts --check",
    "version": "tsx tools/write-version.ts",
    "check:version": "tsx tools/write-version.ts --check",
    "check:leaderboard": "tsx tools/check-leaderboard.ts",
    "check:ranked": "tsx tools/check-ranked.ts",
    "check:relabel": "tsx tools/check-relabel.ts",
    "check:haptics": "tsx tools/check-haptics.ts",
    "check:tray": "tsx tools/check-tray.ts",
    "check:crop": "tsx tools/check-crop.ts",
    "check:outline": "tsx tools/check-outline.ts",
    "check:face-bake": "tsx tools/check-face-bake.ts",
    "check:shop-rise": "tsx tools/check-shop-rise.ts",
    "check:shop-flow": "tsx tools/check-shop-flow.ts",
    "check:euphoria": "tsx tools/check-euphoria.ts",
    "check:insight": "tsx tools/check-insight.ts",
    "check:shell": "tsx tools/check-shell.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "headless": "tsx src/headless.ts",
