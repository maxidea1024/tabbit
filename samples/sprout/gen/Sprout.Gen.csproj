<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Sprout.Gen</RootNamespace>
    <AssemblyName>Sprout.Gen</AssemblyName>
    <!-- NPOI 2.7+ requires the OSMF licence to be accepted explicitly or it warns on every build. -->
    <AcceptNPOIOSMFLicense>true</AcceptNPOIOSMFLicense>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NPOI" Version="2.8.0" />
    <!-- The streaming writer measures column widths, and that path needs Skia present. -->
    <PackageReference Include="SkiaSharp" Version="3.119.2" />
    <!-- Pinned past the advisories NPOI's own dependency still points at. -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.10" />
  </ItemGroup>

</Project>
