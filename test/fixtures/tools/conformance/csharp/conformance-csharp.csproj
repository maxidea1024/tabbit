<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Builds the harness against a scenario's generated C#. Nothing is referenced beyond
    the generated files themselves, which is the point: the output is self-contained.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>conformance-csharp</AssemblyName>
    <RootNamespace>Tabbit.Conformance.Harness</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(GeneratedDir)\**\*.cs" />
  </ItemGroup>

</Project>
