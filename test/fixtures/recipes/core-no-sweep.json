{
  // The same TypeScript output as `core`, with sweeping turned off.
  //
  // Written into the same directory on purpose: the test converts with `core` first and then
  // with this, so what is being measured is whether the second run leaves a stale generated
  // file where the first one's sweep would have taken it.
  //
  // TypeScript only. Sweeping is one mechanism shared by every target, so checking the option
  // on one of them is checking the option; converting eleven more languages to do it again
  // would add a minute to the suite and no coverage.

  "Sources": {
    "Xlsx": [
      {
        "Path": "test/fixtures/xlsx/core"
      }
    ]
  },

  "Targets": [
    {
      "Type": "typescript",
      "Path": "test/fixtures/output/core/typescript",
      "Sweep": false
    }
  ]
}
