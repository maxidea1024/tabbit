{
  // Keys made of several columns, and the multi-argument lookups they generate.
  //
  // The wire does not move: a key's columns are ordinary columns and the file carries them
  // as it always did. What moves is the surface every generated reader offers -
  // `FindByStageAndSlot(stage, slot)` beside the one-argument lookups - and each language
  // answers that its own way, which is why this is every language rather than two.
  //
  // The three tables ask three things: an int-and-enum pair, two strings holding
  // `("a b", "c")` beside `("a", "b c")` so the key's encoding is pinned rather than
  // assumed, and a key of three columns. `Route` also carries a single-column secondary key,
  // so one table generates both shapes at once.

  "Sources": {
    "Xlsx": [
      {
        "Path": "test/fixtures/xlsx/composite-key"
      }
    ],
    "GoogleSheets": []
  },
  "Targets": [
    {
      // Where a row's anchor comes from. A page keyed by several columns held the same `id`
      // several times over until this tree existed to record it.
      "Type": "html",
      "Path": "test/fixtures/output/composite-key/html"
    },
    {
      "Type": "binary",
      "Path": "test/fixtures/output/composite-key/binary",
      "FileExtension": ".tcb"
    },
