{
  // Regression recipe for narrowing a run from the command line.
  //
  // Same fixture as core.json, and deliberately the opposite of core-server.json:
  // no entry declares a TargetSide, so every one defaults to "cs". Nothing in this
  // file asks for a single side, which leaves `--target-side` as the only thing that
  // can narrow the run - that is what the test checks.
  //
  // Its own output tree so a narrowed run cannot overwrite what the golden
  // comparison for `core` expects to find.
  //
  // The named JSON export, because the assertions read table and field names from
  // it. That target-side narrowing reaches every other target is already covered by
  // the recipe-declared cases.
  //
  // And the summary, because what the run was narrowed to is recorded there and the
  // narrowing this file exists for is the command line's. Reading that off `core`
  // meant converting `core` with an option, which cleared and rewrote the tree a
  // dozen other classes read.

  "Sources": {
    "Xlsx": [
      {
        "Path": "test/fixtures/xlsx/core"
      }
    ],
    "GoogleSheets": []
  },

  "Targets": [
    {
      "Type": "json",
      "Path": "test/fixtures/output/core-cli-side/json-named",
      "UseCompactRowFormat": false,
      "Indented": true
    },

    // Describes the whole model rather than producing anything a build consumes, so
    // it is the one target that reads the unnarrowed model.
    {
      "Type": "summary",
      "Path": "test/fixtures/output/core-cli-side/summary",
      "TargetSide": "cs"
    }
  ]
}
