{
  // An array of references written as one cell: `foreign Target[]` and the dotted form
  // `foreign Target.Note[]` beside it, with rows of three, one and no elements.
  //
  // Every path is relative to the repository root, which is where the test harness invokes
  // Tabbit from. Output lands in test/fixtures/output/array-foreign (transient, gitignored)
  // and is compared against test/fixtures/golden/array-foreign.
  //
  // Both JSON row formats are exported because they take different code paths in
  // JsonExporter, so both need covering. The named form is the one generated readers
  // consume.
  "Sources": {
    "Xlsx": [
      {
        "Path": "test/fixtures/xlsx/array-foreign"
      }
    ],
    "GoogleSheets": []
  },

  "Targets": [
    {
      "Type": "binary",
      "Path": "test/fixtures/output/array-foreign/binary",
      "FileExtension": ".tcb"
    },
    {
      "Type": "json",
      "Path": "test/fixtures/output/array-foreign/json-compact",
      "UseCompactRowFormat": true,
      "Indented": true
    },
    {
      "Type": "json",
      "Path": "test/fixtures/output/array-foreign/json-named",
      "UseCompactRowFormat": false,
      "Indented": true
    },
    {
      "Type": "csharp",
      "Path": "test/fixtures/output/array-foreign/csharp",
      "Namespace": "Tabbit.Fixtures.X",
      "AccessorName": "XAccessor"
    },
    {
      "Type": "typescript",
      "Path": "test/fixtures/output/array-foreign/typescript"
    },
    {
      "Type": "html",
      "Path": "test/fixtures/output/array-foreign/html"
    }
  ]
}
