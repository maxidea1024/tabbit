      {
        "Path": "test/fixtures/output/csharp-assembly/binary"
      }
    ]
  },

  "CodeGenerations": {
    "CSharp": [
      {
        "Path": "test/fixtures/output/csharp-assembly/cs",
        "Namespace": "Tabbit.Fixtures.Assembly",
        "AccessorName": "CoreAccessor",
        "Output": "assembly"
      }
    ]
  }
