{
  // One record written into a single cell - notation (다) of the design's section 7.1.
  //
  // Paired with `packed-expanded`, which writes the same record as its own columns. The two
  // must produce the same file: what `sep` changes is how a sheet is written, and a record
  // has always been one column per member on the wire.

  "Schemas": [
    { "Path": "test/fixtures/schemas/packed" }
  ],

  "Sources": {
    "Xlsx": [
      { "Path": "test/fixtures/xlsx/packed" }
    ],
    "GoogleSheets": []
  },

  // **The naming check is this scenario's second gate, and it is here for one reason.** The
  // members of a `sep` struct are declared in `payout.tbs` as camelCase, and the expansion
  // used to Pascal-case the name it recorded - so `itemId` arrived as `ItemId` and a project
  // asking for a convention reported a spelling nobody wrote. The declaration's own spelling
  // is what a rule has to judge, and `camel` here is what says so: bring the casing back and
  // this scenario stops converting. The same struct written out as member columns
  // (`packed-expanded`) has always carried the sheet's own text.
  "Naming": {
    "Field": "camel",
    "Entity": "pascal",
    "OnViolation": "error"
  },

  "Targets": [
    {
      // A group declared in a schema file rather than in the sheet, documented.
      "Type": "html",
      "Path": "test/fixtures/output/packed/html"
    },
    {
      "Type": "binary",
      "Path": "test/fixtures/output/packed/binary",
      "FileExtension": ".tcb"
    },
    {
      "Type": "json",
      "Path": "test/fixtures/output/packed/json-named",
      "UseCompactRowFormat": false,
      "Indented": true
    },
    {
      "Type": "csharp",
      "Path": "test/fixtures/output/packed/csharp",
      "Namespace": "Tabbit.Fixtures.Packed",
      "AccessorName": "PackedAccessor"
    }
  ]
}
