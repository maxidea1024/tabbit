{
  // A column whose value is a row of one of several tables, written `Weapon|Armour`.
  //
  // The model has carried this shape for a while - the targets are resolved, the key type is
  // checked to be the same across them, and an id in two of them is refused - but no
  // generator ever looked, because `IsRef` means "resolves to exactly one record" and is
  // false here. This tree is what the generators now emit for it: the key, one property per
  // target, and the discriminator saying which target the row is in.
  //
  // Both file formats, because neither may move: the column already travels as the target's
  // key, so a diff in the binary or the JSON here would be a defect rather than a feature.
  //
  // spec/multi-target-accessors.md.

  "Sources": {
    "Xlsx": [
      {
        "Path": "test/fixtures/xlsx/multi-target"
      }
    ],
    "GoogleSheets": []
  },

  "Targets": [
    {
      "Type": "binary",
      "Path": "test/fixtures/output/multi-target/binary",
      "FileExtension": ".tcb"
    },
    {
      "Type": "json",
      "Path": "test/fixtures/output/multi-target/json-named",
      "UseCompactRowFormat": false,
      "Indented": true
    },
    {
      "Type": "csharp",
      "Path": "test/fixtures/output/multi-target/csharp",
      "Namespace": "Tabbit.Fixtures.MultiTarget",
      "AccessorName": "MultiTargetAccessor"
    }
  ]
}
