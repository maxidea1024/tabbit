{
  // The `containers` workbook handed to a target that has no container type yet.
  //
  // **The C# gate for containers** - spec/types/set-and-map.md section 9, stage 2.
  //
  // It began as the boundary of stage 1: the model and the file carried a `set` and a `map`
  // and no language had the container, so this recipe failed by name. C# has them now, and
  // the recipe is what says so - the generated code compiles and reads the binary back into
  // both layers of the surface. `containers-unsupported` holds the boundary as it moves on.

  "Schemas": [
    { "Path": "test/fixtures/schemas/containers" }
  ],

  "Sources": {
    "Xlsx": [
      { "Path": "test/fixtures/xlsx/containers" }
    ],
    "GoogleSheets": []
  },

  "Targets": [
    // The file the generated reader reads, and the JSON its values are checked against.
    // Both here rather than borrowed from `containers`, so the round trip is one run's
    // output read by one run's code.
    {
      "Type": "binary",
      "Path": "test/fixtures/output/containers-target/binary",
      "FileExtension": ".tcb"
    },
    {
      "Type": "json",
      "Path": "test/fixtures/output/containers-target/json-named",
      "UseCompactRowFormat": false,
      "Indented": true
    },
    {
      "Type": "csharp",
      "Path": "test/fixtures/output/containers-target/csharp",
      "Namespace": "Tabbit.Fixtures.Containers",
      "AccessorName": "ContainersAccessor"
    },
    {
      "Type": "typescript",
      "Path": "test/fixtures/output/containers-target/typescript"
    },
    {
      "Type": "go",
      "Path": "test/fixtures/output/containers-target/go",
      "PackageName": "containers",
      "ModulePath": "containers"
    },
    {
      "Type": "java",
      "Path": "test/fixtures/output/containers-target/java",
      "PackageName": "containers",
      "AccessorName": "ContainersData",
      "BinaryTableFileExtension": ".tcb"
    },
    {
      "Type": "kotlin",
      "Path": "test/fixtures/output/containers-target/kotlin",
      "PackageName": "containers",
      "AccessorName": "ContainersData",
      "BinaryTableFileExtension": ".tcb"
    },
    {
      "Type": "dart",
      "Path": "test/fixtures/output/containers-target/dart"
    },
    {
      "Type": "swift",
      "Path": "test/fixtures/output/containers-target/swift",
      "ModuleName": "Containers"
    },
    {
      "Type": "rust",
      "Path": "test/fixtures/output/containers-target/rust",
      "CrateName": "containers",
      "BinaryTableFileExtension": ".tcb"
    },
    {
      "Type": "python",
      "Path": "test/fixtures/output/containers-target/python"
    },
    {
      "Type": "ruby",
      "Path": "test/fixtures/output/containers-target/ruby"
    },
    {
      "Type": "php",
      "Path": "test/fixtures/output/containers-target/php"
    },
    {
      "Type": "cpp",
      "Path": "test/fixtures/output/containers-target/cpp",
      "Namespace": "containers"
    },
    {
      "Type": "c",
      "Path": "test/fixtures/output/containers-target/c",
      "AccessorName": "ContainersData",
      "BinaryTableFileExtension": ".tcb"
    },
    {
      "Type": "lua",
      "Path": "test/fixtures/output/containers-target/lua"
    },
    {
      "Type": "unreal",
