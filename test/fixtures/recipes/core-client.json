{
  // Regression recipe for `core.xlsx` built for the client side only.
  //
  // Same fixture as core.json; every output entry declares TargetSide "c",
  // so entities and fields marked for the other side must be absent.
  //
  // Every path is relative to the repository root, which is where the test
  // harness invokes Tabbit from. Output lands in test/fixtures/output/core
  // (transient, gitignored) and is compared against test/fixtures/golden/core.
  //
  // Both JSON row formats are exported because they take different code paths in
  // JsonExporter, so both need covering. The named form is the one generated readers
  // consume - it is what the conformance corpus compares against and what the
  // TypeScript round trip reads.

  "Sources": {
    "Xlsx": [
      {
        "Path": "test/fixtures/xlsx/core",

        // Text1/Text2 fold into one array here, which is what this fixture
        // covers. Off unless asked for, because a number in a name does not say
        // whether it means an array.
        "FoldSerialFields": true
      }
    ],
    "GoogleSheets": []
  },

  "Targets": [
    {
      "Type": "binary",
      "Path": "test/fixtures/output/core-client/binary",
      "FileExtension": ".tcb",
      "TargetSide": "c"
    },
    {
      "Type": "json",
      "Path": "test/fixtures/output/core-client/json-compact",
      "UseCompactRowFormat": true,
      "Indented": true,
      "TargetSide": "c"
    },
    {
      "Type": "json",
      "Path": "test/fixtures/output/core-client/json-named",
      "UseCompactRowFormat": false,
      "Indented": true,
      "TargetSide": "c"
    },
    {
      "Type": "csharp",
      "Path": "test/fixtures/output/core-client/csharp",
      "Namespace": "Tabbit.Fixtures.Core.Client",
      "AccessorName": "CoreClientAccessor",
      "TargetSide": "c"
    },
    {
      "Type": "typescript",
      "Path": "test/fixtures/output/core-client/typescript",
      "TargetSide": "c"
    },
    {
      "Type": "html",
      "Path": "test/fixtures/output/core-client/html",
      "TargetSide": "c"
    },

    // Declared for the client, like every other entry here - but a summary describes
    // what the sheets declared, not the cut this entry is built for. The golden tree
    // therefore lists the server-only tables that the binary and code outputs beside
    // it correctly leave out. That is the point: a history taken from a client build
    // must not read as the server's tables having been deleted.
    {
      "Type": "summary",
      "Path": "test/fixtures/output/core-client/summary",
      "TargetSide": "c"
    }
  ]
}
