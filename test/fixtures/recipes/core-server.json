{
  // Regression recipe for `core.xlsx` built for the server side only.
  //
  // Same fixture as core.json; every output entry declares TargetSide "s",
  // so entities and fields marked for the other side must be absent.
  //
  // Every path is relative to the repository root, which is where the test
  // harness invokes Tabbit from. Output lands in test/fixtures/output/core
  // (transient, gitignored) and is compared against test/fixtures/golden/core.
  //
  // Both JSON row formats are exported because they take different code paths in
  // JsonExporter, so both need covering. The named form is the one generated readers
  // consume - it is what the conformance corpus compares against and what the
  // TypeScript round trip reads.

  "Sources": {
    "Xlsx": [
      {
        "Path": "test/fixtures/xlsx/core"
      }
    ],
    "GoogleSheets": []
  },

  "Targets": [
    {
      "Type": "binary",
      "Path": "test/fixtures/output/core-server/binary",
      "FileExtension": ".tcb",
      "TargetSide": "s"
    },
    {
      "Type": "json",
      "Path": "test/fixtures/output/core-server/json-compact",
      "UseCompactRowFormat": true,
      "Indented": true,
      "TargetSide": "s"
    },
    {
      "Type": "json",
      "Path": "test/fixtures/output/core-server/json-named",
      "UseCompactRowFormat": false,
      "Indented": true,
      "TargetSide": "s"
    },
    {
      "Type": "csharp",
      "Path": "test/fixtures/output/core-server/csharp",
      "Namespace": "Tabbit.Fixtures.Core.Server",
      "AccessorName": "CoreServerAccessor",
      "TargetSide": "s"
    },
    {
      "Type": "typescript",
      "Path": "test/fixtures/output/core-server/typescript",
      "TargetSide": "s"
    },
    {
      "Type": "html",
      "Path": "test/fixtures/output/core-server/html",
      "TargetSide": "s"
    },

    // As in core-client, and for the same reason: narrowed output, unnarrowed
    // description.
    {
      "Type": "summary",
      "Path": "test/fixtures/output/core-server/summary",
      "TargetSide": "s"
    }
  ]
}
