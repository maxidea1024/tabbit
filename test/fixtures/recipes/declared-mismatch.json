      "Path": "test/fixtures/output/declared-mismatch/binary",
      "FileExtension": ".tcb"
    },
    {
      "Type": "json",
      "Path": "test/fixtures/output/declared-mismatch/json-named",
      "UseCompactRowFormat": false,
      "Indented": true
    },
    {
