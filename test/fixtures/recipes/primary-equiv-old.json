{
  // The same tables as `primary-equiv`, written in the notation the primary layout replaces:
  // `~~table:Name~~` markers and five header rows in a fixed order.
  //
  // This is the control side of the equivalence gate. It names no layout, so it reads under the
  // default - which is what makes it the right control: it is the notation every other fixture
  // in this repository is written in.

  "Sources": {
    "Xlsx": [
      {
        "Path": "test/fixtures/xlsx/primary-equiv-old"
      }
    ]
  },

  "Targets": [
    {
      "Type": "binary",
      "Path": "test/fixtures/output/primary-equiv-old/binary",
      "FileExtension": ".tcb"
    },
    {
      "Type": "json",
      "Path": "test/fixtures/output/primary-equiv-old/json-named",
      "UseCompactRowFormat": false,
      "Indented": true
    }
  ]
}
