{
  // Regression recipe for the `core.xlsx` fixture.
  //
  // Every path is relative to the repository root, which is where the test
  // harness invokes Tabbit from. Output lands in test/fixtures/output/foreign-field
  // (transient, gitignored) and is compared against test/fixtures/golden/core.
  //
  // Both JSON row formats are exported because they take different code paths in
  // JsonExporter, so both need covering. The named form is the one generated readers
  // consume - it is what the conformance corpus compares against and what the
  // TypeScript round trip reads.

  "Sources": {
    "Xlsx": [
      {
        "Path": "test/fixtures/xlsx/foreign-field"
      }
    ],
    "GoogleSheets": []
  },

  "Targets": [
    {
      "Type": "binary",
      "Path": "test/fixtures/output/foreign-field/binary",
      "FileExtension": ".tcb"
    },
    {
      "Type": "json",
      "Path": "test/fixtures/output/foreign-field/json-compact",
      "UseCompactRowFormat": true,
      "Indented": true
    },
    {
      "Type": "json",
      "Path": "test/fixtures/output/foreign-field/json-named",
      "UseCompactRowFormat": false,
      "Indented": true
    },
    {
      "Type": "csharp",
      "Path": "test/fixtures/output/foreign-field/csharp",
      "Namespace": "Tabbit.Fixtures.X",
      "AccessorName": "XAccessor"
    },
    {
      "Type": "typescript",
      "Path": "test/fixtures/output/foreign-field/typescript"
    },
    {
      "Type": "html",
      "Path": "test/fixtures/output/foreign-field/html"
    }
  ]
}
