{
  // A `Targets` entry naming a target that does not exist.
  //
  // Has to be reported rather than skipped: a recipe asking for `pyton` output and
  // getting none, silently, is a build that ships without the file it was supposed
  // to produce.

  "Sources": {
    "Xlsx": [
      {
        "Path": "test/fixtures/xlsx/core",

        // Text1/Text2 fold into one array here, which is what this fixture
        // covers. Off unless asked for, because a number in a name does not say
        // whether it means an array.
        "FoldSerialFields": true
      }
    ]
  },

  "Targets": [
    {
      "Type": "pyton",
      "Path": "test/fixtures/output/targets-unknown-type/py"
    }
  ]
}
