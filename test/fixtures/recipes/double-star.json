{
  // Regression recipe for the `core.xlsx` fixture.
  //
  // Every path is relative to the repository root, which is where the test
  // harness invokes Tabbit from. Output lands in test/fixtures/output/double-star
  // (transient, gitignored) and is compared against test/fixtures/golden/core.
  //
  // Both JSON row formats are exported because they take different code paths in
  // JsonExporter, so both need covering. The named form is the one generated readers
  // consume - it is what the conformance corpus compares against and what the
  // TypeScript round trip reads.

  "Sources": {
    "Xlsx": [
      {
        "Path": "test/fixtures/xlsx/double-star"
      }
    ],
    "GoogleSheets": []
  },

  "Targets": [
    {
      "Type": "binary",
      "Path": "test/fixtures/output/double-star/binary",
      "FileExtension": ".tcb"
    },
    {
      "Type": "json",
      "Path": "test/fixtures/output/double-star/json-compact",
      "UseCompactRowFormat": true,
      "Indented": true
    },
    {
      "Type": "json",
      "Path": "test/fixtures/output/double-star/json-named",
      "UseCompactRowFormat": false,
      "Indented": true
    },
    {
      "Type": "cpp",
      "Path": "test/fixtures/output/double-star/cpp",
      "Namespace": "tabbit_fixtures::core",
      "AccessorName": "XAccessor",
      "BinaryTableFileExtension": ".tcb"
    },
    {
      "Type": "csharp",
      "Path": "test/fixtures/output/double-star/csharp",
      "Namespace": "Tabbit.Fixtures.X",
      "AccessorName": "XAccessor"
    },
    {
      "Type": "typescript",
      "Path": "test/fixtures/output/double-star/typescript"
    },
    {
      "Type": "html",
      "Path": "test/fixtures/output/double-star/html"
    }
  ]
}
