{
  // The trailing `?` converted end to end.
  //
  // The fixture pairs every type that can say it has no value with the same type left
  // required, so the goldens hold both answers side by side: a row writes `-` in one column
  // and the same cell would be refused in the one next to it.
  //
  // What the goldens watch is that absence reaches the consumer. The file carries a presence
  // bit per row and the generated pages carry a `Has{field}` accessor, so a row saying it has
  // none is not the same as a row saying zero - spec/optional-fields.md. How a cell says it
  // is spec/blank-and-null-cells.md, and `blank-and-null` is the fixture for that.

  "Sources": {
    "Xlsx": [
      {
        "Path": "test/fixtures/xlsx/optional"
      }
    ],
    "GoogleSheets": []
  },

  "Targets": [
    {
      "Type": "binary",
      "Path": "test/fixtures/output/optional/binary",
      "FileExtension": ".tcb"
    },
    {
      "Type": "json",
      "Path": "test/fixtures/output/optional/json-named",
      "UseCompactRowFormat": false,
      "Indented": true
    },
    {
      "Type": "csharp",
      "Path": "test/fixtures/output/optional/csharp",
      "Namespace": "Tabbit.Fixtures.Optional",
      "AccessorName": "OptionalAccessor"
    },
    {
      "Type": "cpp",
      "Path": "test/fixtures/output/optional/cpp",
      "AccessorName": "OptionalAccessor"
    },
    {
      "Type": "typescript",
      "Path": "test/fixtures/output/optional/typescript"
    },

    // The Unreal target is reached through `Targets` - it has no recipe section of its own.
    // Here so UHT sees the generated USTRUCTs: what a golden tree cannot answer is whether
    // the header tool accepts them, and that is the whole question for a record group.
    {
      // Go has no recipe section either - the targets added since the `Targets` list
      // exists are reached only through it.
      "Type": "go",
      "Path": "test/fixtures/output/optional/go",
      "PackageName": "optional",
      "ModulePath": "optional"
    },
    {
      "Type": "ruby",
      "Path": "test/fixtures/output/optional/ruby",
      "ModuleName": "Optional"
    },
    {
      "Type": "php",
      "Path": "test/fixtures/output/optional/php",
      "Namespace": "Tabbit\\Fixtures\\Optional",
      "AccessorName": "OptionalAccessor"
    },
    {
      "Type": "dart",
      "Path": "test/fixtures/output/optional/dart"
    },
    {
      "Type": "python",
      "Path": "test/fixtures/output/optional/python",
      "PackageName": "optional_data"
    },
    {
      "Type": "kotlin",
      "Path": "test/fixtures/output/optional/kotlin",
      "PackageName": "tabbit.fixtures.optional",
      "AccessorName": "OptionalAccessor"
    },
    {
      "Type": "swift",
      "Path": "test/fixtures/output/optional/swift",
      "AccessorName": "OptionalAccessor"
    },
    {
      "Type": "lua",
      "Path": "test/fixtures/output/optional/lua"
    },
    {
      "Type": "java",
      "Path": "test/fixtures/output/optional/java",
      "PackageName": "tabbit.fixtures.optional",
      "AccessorName": "OptionalAccessor"
    },
    {
      "Type": "rust",
      "Path": "test/fixtures/output/optional/rust",
      "CrateName": "optional"
    },
    {
      // C has no recipe section either - both it and unreal are reached by type.
      "Type": "c",
      "Path": "test/fixtures/output/optional/c",
      "AccessorName": "Optional"
    },
    {
      "Type": "unreal",
      "Path": "test/fixtures/output/optional/unreal/Source",
      "ModuleName": "Optional",
      "AccessorName": "FOptional",
      "BinaryTableFileExtension": ".tcb"
    }
  ]
}
