{
  // The `containers` workbook handed to a language that has no container type yet.
  //
  // **The boundary of the rollout, kept honest as it moves.** Every language opts in one at
  // a time - spec/types/set-and-map.md section 9 - and one that has not says so by name
  // rather than writing a list and a pair of lists a consumer would never learn were meant
  // to be a set and a map.
  //
  // Point it at whichever language is still waiting. When the last one lands, this recipe
  // has nothing left to be about and goes with it.

  "Schemas": [
    { "Path": "test/fixtures/schemas/containers" }
  ],

  "Sources": {
    "Xlsx": [
      { "Path": "test/fixtures/xlsx/containers" }
    ],
    "GoogleSheets": []
  },

  "Targets": [
    {
      "Type": "go",
      "Path": "test/fixtures/output/containers-unsupported/go",
      "PackageName": "containers",
      "ModulePath": "containers"
    }
  ]
}
