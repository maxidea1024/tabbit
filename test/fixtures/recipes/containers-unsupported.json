  // left to be about and goes with it.

  "Schemas": [
    { "Path": "test/fixtures/schemas/containers" }
  ],

  "Sources": {
    "Xlsx": [
      { "Path": "test/fixtures/xlsx/containers" }
    ],
    "GoogleSheets": []
  },

  "Targets": [
    {
      "Type": "text",
      "Path": "test/fixtures/output/containers-unsupported/text",
      "Format": "{index}"
    }
  ]
}
