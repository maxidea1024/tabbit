{
  // A member that is itself a record - `Star1.Position.X` beside `Star1.Id`. The shape
  // measured in real workbooks, and the one the depth generalization is for: the wire holds
  // it as the same fixed-array columns a record one level deep produces.
  // spec/nested-multi-level.md.

  "Sources": {
    "Xlsx": [
      {
        "Path": "test/fixtures/xlsx/nested-deep"
      }
    ],
    "GoogleSheets": []
  },

  // C# only, for now. Each code target refuses a record inside a record until it learns the
  // shape - `SupportsDeepNestedFields` - so the others are added here as they land. Binary
  // beside it because the read-back is the check that matters: the declaration and the file
  // have to agree about which column holds `Position.X`.
  "CodeGenerations": {
    "CSharp": [
      {
        "Path": "test/fixtures/output/nested-deep/csharp",
        "Namespace": "Tabbit.Fixtures.NestedDeep",
        "AccessorName": "NestedDeepAccessor"
      }
    ],

    // TypeScript reads both formats, so it is the one language that can be asked whether the
    // two assemble the same thing at this depth.
    "Typescript": [
      {
        "Path": "test/fixtures/output/nested-deep/typescript"
      }
    ],
    "Cpp": [
      {
        "Path": "test/fixtures/output/nested-deep/cpp",
        "AccessorName": "NestedDeepAccessor"
      }
    ]
  },

  // Languages reached only through `Targets` - they have no recipe section of their own. Added
  // here as each learns the shape.
  "Targets": [
    {
      "Type": "go",
      "Path": "test/fixtures/output/nested-deep/go",
      "PackageName": "nesteddeep",
      "ModulePath": "nesteddeep"
    },
    {
      "Type": "rust",
      "Path": "test/fixtures/output/nested-deep/rust",
      "CrateName": "nesteddeep"
    },
    {
      "Type": "c",
      "Path": "test/fixtures/output/nested-deep/c",
      "AccessorName": "NestedDeep"
    },
    {
      "Type": "dart",
      "Path": "test/fixtures/output/nested-deep/dart"
    },
    {
      "Type": "kotlin",
      "Path": "test/fixtures/output/nested-deep/kotlin",
      "PackageName": "tabbit.fixtures.nesteddeep",
      "AccessorName": "NestedDeepAccessor"
    },
    {
      "Type": "java",
      "Path": "test/fixtures/output/nested-deep/java",
      "PackageName": "tabbit.fixtures.nesteddeep",
      "AccessorName": "NestedDeepAccessor"
    },
    {
      "Type": "python",
      "Path": "test/fixtures/output/nested-deep/python",
      "PackageName": "nested_deep_data"
    },
    {
      "Type": "ruby",
      "Path": "test/fixtures/output/nested-deep/ruby",
      "ModuleName": "NestedDeep"
    },
    {
      "Type": "php",
      "Path": "test/fixtures/output/nested-deep/php",
      "Namespace": "Tabbit\\Fixtures\\NestedDeep",
      "AccessorName": "NestedDeepAccessor"
    },

    // Unreal, so UHT sees the nested USTRUCTs. What a golden tree cannot answer is whether the
    // header tool accepts them - and unlike an array of arrays, this shape keeps its
    // UPROPERTY, which is a claim only UHT can settle.
    {
      "Type": "unreal",
      "Path": "test/fixtures/output/nested-deep/unreal/Source",
      "ModuleName": "NestedDeep",
      "AccessorName": "FNestedDeep",
      "BinaryTableFileExtension": ".tcb"
    }
  ],

  "Exports": {
    "Binary": [
      {
        "Path": "test/fixtures/output/nested-deep/binary",
        "FileExtension": ".tcb"
      }
    ],
    "Json": [
      {
        "Path": "test/fixtures/output/nested-deep/json-named",
        "UseCompactRowFormat": false,
        "Indented": true
      },

      // The compact row too, because it takes a different path: it is positional over the
      // wire columns, and a leaf is a wire column. Reading it as one entry per *member* would
      // take the first leaf's run and call it the whole record.
      {
        "Path": "test/fixtures/output/nested-deep/json-compact",
        "UseCompactRowFormat": true,
        "Indented": true
      }
    ]
  }
}
