{
  // One workbook, every code generator, output committed next to this file.
  //
  // This is a reading aid, not a gate - which is what the directory is named for. The
  // regression suite already compiles all of this; what it cannot do is let somebody see,
  // side by side and in a diff, what the generators actually emit. That turns out
  // to matter: the Unreal target shipped for a while with the plain C++ reader inside it,
  // and nothing in the suite could tell, because every gate it had was still green. It was
  // reading side-by-side/cpp/A.h next to side-by-side/unreal that made it obvious.
  //
  // The reserved-words fixture on purpose. Its columns are named `class`, `delete`,
  // `operator`, `namespace`, `constructor`, `function` and `int`, so the output also
  // shows how each language gets out of the way of its own keywords - Kotlin's
  // backticks, Go's exported-name rewrite, Dart's renaming of a field that would shadow
  // a built-in type.
  //
  // Regenerate after changing a generator, a template or a reader, and review the diff:
  //
  //     dotnet run --project src/Tabbit.csproj -- --recipe side-by-side/side-by-side.json --silent
  //
  // Paths are relative to the repository root, which is where the CLI has to be run from.

  "Sources": {
    "Xlsx": [
      {
        "Path": "test/fixtures/xlsx/reserved-words"
      }
    ]
  },

  // The validation pipeline over the same workbook, because a rule file is another view of
  // these tables and this directory is where the views are read next to each other. It is
  // also the only view written by hand: the ones below are emitted, and this one is what
  // somebody types to read what they emit.
  //
  // Committed are the rules themselves. The run also writes the accessor into `.generated/` and
  // the project an editor reads it through, and both are gitignored - so nothing machine-specific
  // lands here.
  "Validation": {
    "Path": "side-by-side/validation",

    // A key the core knows nothing about, read by `pre/Inputs.cs` and given meaning there.
    "Options": { "Locale": "KR" }
  },

  // No binary export here. It is the runtime format and it is covered by the golden
  // tree; what it is not is reviewable - a .tcb in a diff says nothing to anybody.
  "Targets": [
    { "Type": "json", "Path": "side-by-side/json", "UseCompactRowFormat": false, "Indented": true },
    {
      "Type": "cpp",
      "Path": "side-by-side/cpp",
      "Namespace": "x",
      "AccessorName": "A",
      "BinaryTableFileExtension": ".tcb",
      "WriteUpdater": true
    },
    { "Type": "csharp", "Path": "side-by-side/csharp", "Namespace": "X", "AccessorName": "A", "WriteUpdater": true },
    { "Type": "typescript", "Path": "side-by-side/ts", "WriteUpdater": true },
    { "Type": "html", "Path": "side-by-side/html" },
    { "Type": "go", "Path": "side-by-side/go", "PackageName": "x", "ModulePath": "x", "WriteUpdater": true },
    { "Type": "rust", "Path": "side-by-side/rust", "CrateName": "x", "WriteUpdater": true },
    { "Type": "python", "Path": "side-by-side/python", "PackageName": "x", "WriteUpdater": true },
    { "Type": "java", "Path": "side-by-side/java", "PackageName": "x", "AccessorName": "A", "WriteUpdater": true },
    { "Type": "kotlin", "Path": "side-by-side/kotlin", "PackageName": "x", "AccessorName": "A", "WriteUpdater": true },
    { "Type": "swift", "Path": "side-by-side/swift", "AccessorName": "A", "WriteUpdater": true, "WriteManifest": true, "ModuleName": "X" },
    { "Type": "lua", "Path": "side-by-side/lua", "WriteUpdater": true },
    { "Type": "ruby", "Path": "side-by-side/ruby", "ModuleName": "X", "AccessorName": "a", "WriteUpdater": true },
    { "Type": "dart", "Path": "side-by-side/dart", "AccessorName": "a", "WriteUpdater": true },
    { "Type": "unreal", "Path": "side-by-side/unreal", "ModuleName": "X", "AccessorName": "A", "WriteUpdater": true },
    { "Type": "c", "Path": "side-by-side/c", "AccessorName": "A", "WriteUpdater": true },
    { "Type": "php", "Path": "side-by-side/php", "Namespace": "X", "AccessorName": "A", "WriteUpdater": true },

    // The document every other view renders from, in the same diff as the views.
    // `Author: none` because this file is committed: a name and an e-mail address
    // are personal data, and nothing here needs them.
    { "Type": "summary", "Path": "side-by-side/summary", "Author": "none" }
  ]
}
