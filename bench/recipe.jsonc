{
  // Data for the format benchmark in bench/: the `sprout` corpus at its full size, exported
  // three ways from one conversion so the files can only differ by format, never by content.
  //
  // The workbooks this reads are not committed - they are 109,218 rows, and the generator
  // makes them from the same grids the committed ones come from:
  //
  //     dotnet run --project samples/sprout/gen -- --scale live --out samples/sprout/xlsx-live
  //     dotnet run --project src/Tabbit.csproj -- --recipe bench/recipe.jsonc
  //
  // No sheet list. `samples/sprout/recipe.jsonc` names its sheets so that one disappearing is
  // an error; here every sheet in the folder is data, because the generator wrote it.

  "Sources": {
    "Xlsx": [
      {
        "Path": "samples/sprout/xlsx-live",
        "Layout": "sheet-per-table",

        // `EquipOptionTable` opens with four rows carrying one index, planted there because a
        // corpus of this age has one. Same setting as the sample's own recipe.
        "OnDuplicateIndex": "keep-first"
      }
    ]
  },

  // Neither JSON export is indented: shipping JSON is minified, and indentation would charge
  // JSON for whitespace it does not have to carry.
  "Targets": [
    {
      "Type": "binary",
      "Path": "bench/data/binary",

      // Which encoding each column ended up in, and what every candidate measured. The
      // per-column table in doc/benchmark.md is read out of this.
      "EncodingReport": "bench/data/encoding-report.txt"
    },
    { "Type": "json", "Path": "bench/data/json", "UseCompactRowFormat": false, "Indented": false },
    { "Type": "json", "Path": "bench/data/json-compact", "UseCompactRowFormat": true, "Indented": false }
  ]
}
